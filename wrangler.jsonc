{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "developer-sumup-com",
  "compatibility_date": "2025-08-15",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/contact",
      "/subscribe"
    ],
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "developer.sumup.com",
      "custom_domain": true
    }
  ]
}
