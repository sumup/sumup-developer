{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "developer-sumup-com",
  "compatibility_date": "2025-08-15",
  "main": "./dist/_worker.js/index.js",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/contact",
      "/subscribe"
    ],
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "developer.sumup.com/*",
      "zone_name": "sumup.com"
    }
  ]
}