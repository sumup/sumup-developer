---
// import { ViewTransitions } from 'astro:transitions';
import "@sumup-oss/design-tokens/fonts.css";
import "@sumup-oss/design-tokens/dynamic.css";
import "@sumup-oss/circuit-ui/styles.css";

export interface Props {
  title: string;
  current?: string;
  footer?: boolean;
}

const { title = "SumUp Documentation", footer = true, current } = Astro.props;
---

<body id="root">
  <slot name="api-nav" />
  <div id="main-content" class="content">
    <slot />
  </div>
</body>

<script>
  import { initAnalytics } from "@lib/analytics";
  import { computed } from "nanostores";
  import { $merchant } from "src/store/merchant";
  import { $user } from "src/store/user";

  computed(
    [$merchant, $user],
    (
      { data: merchant, loading: merchantLoading },
      { data: user, loading: userLoading },
    ) => {
      if (merchantLoading || !merchant || userLoading || !user) return;
      initAnalytics({
        userId: user.id,
        merchantCode: merchant.merchantCode,
        merchantCategoryCode: merchant.merchantCategoryCode,
        merchantCountryCode: merchant.country,
      });
    },
  );
</script>

<style lang="scss" is:global>
  html {
    scroll-behavior: smooth;
    height: 100%;
  }

  body {
    display: flex;
    flex-direction: column;
    height: 100%;
    letter-spacing: var(--cui-letter-spacing);
  }

  .content {
    position: relative;
    overflow-y: auto;
    overflow-x: clip;
    height: 100%;
  }

  html {
    scroll-behavior: smooth;
    line-height: 1.5;
    width: 100%;
    margin: 0;
  }

  /*** Global styles ***/
  body {
    p {
      font-size: var(--cui-body-m-font-size);
      line-height: var(--cui-body-m-line-height);
    }

    p.small {
      font-size: var(--cui-body-s-font-size);
      line-height: var(--cui-body-s-line-height);
    }

    h1.title {
      font-size: var(--cui-display-l-font-size);
      line-height: var(--cui-display-l-line-height);
    }

    h1 {
      font-size: var(--cui-display-m-font-size);
      line-height: var(--cui-display-m-line-height);
    }

    h2 {
      font-size: var(--cui-headline-l-font-size);
      line-height: var(--cui-headline-l-line-height);
    }

    h3 {
      font-size: var(--cui-headline-m-font-size);
      line-height: var(--cui-headline-m-line-height);
    }

    h4 {
      font-size: var(--cui-headline-s-font-size);
      line-height: var(--cui-headline-s-line-height);
    }

    h1,
    h2,
    h3,
    h4,
    h5 {
      font-weight: var(--cui-font-weight-bold);
      color: var(--cui-fg-normal);
    }

    hr {
      display: block;
      width: 100%;
      margin-top: var(--cui-spacings-mega);
      margin-bottom: var(--cui-spacings-mega);
      border: 0;
      border-top-width: 0px;
      border-top-style: none;
      border-top-color: currentcolor;
      border-top: 1px solid var(--cui-border-divider);
    }

    img {
      max-width: 100%;
    }

    a {
      color: var(--cui-fg-accent);
    }

    article {
      h1,
      h2,
      h3,
      h4,
      h5,
      ul,
      ol {
        margin-bottom: var(--cui-spacings-giga);
      }

      h2 {
        margin: var(--cui-spacings-giga) 0;
      }

      h3 {
        margin: var(--cui-spacings-mega) 0;
      }

      p {
        margin-bottom: var(--cui-spacings-mega);
      }

      figure,
      table,
      pre,
      .tabs {
        margin: var(--cui-spacings-giga) 0;
      }

      ul,
      ol {
        padding-left: var(--cui-spacings-kilo);
        font-size: var(--cui-body-m-font-size);
        line-height: var(--cui-body-m-line-height);

        li {
          margin-bottom: var(--cui-spacings-byte);
          margin-left: var(--cui-spacings-kilo);
        }
      }

      table {
        border: var(--cui-border-width-kilo) solid var(--cui-border-divider);
        border-radius: var(--cui-border-radius-bit);
        height: unset;
        overflow-x: auto;

        thead {
          font-size: var(--cui-body-s-font-size);
          font-weight: var(--cui-font-weight-bold);
          line-height: var(--cui-body-s-line-height);
          color: var(--cui-fg-subtle);
          white-space: nowrap;
          th {
            padding: var(--cui-spacings-byte) var(--cui-spacings-giga);
          }

          tr {
            background-color: var(--cui-bg-normal);
            border-bottom: var(--cui-border-width-kilo) solid
              var(--cui-border-divider);
          }
        }

        tr {
          vertical-align: middle;
        }

        td {
          padding: var(--cui-spacings-giga);
          overflow-wrap: break-word;
          vertical-align: middle;
          background-color: var(--cui-bg-normal);
          border-bottom: var(--cui-border-width-kilo) solid
            var(--cui-border-divider);
        }
      }
    }
  }

  .content {
    scroll-behavior: smooth;
  }
</style>
