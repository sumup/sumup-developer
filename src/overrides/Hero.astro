---
import { Display, Body } from "@sumup-oss/circuit-ui";

const {
  data: { title },
} = Astro.locals.starlightRoute.entry;
---

<div class="hero">
  <Display
    as="h1"
    size="m"
    weight="black"
    id={"_top"}
    className="title"
    data-page-title
  >
    {title}
  </Display>
  <Body
    size="l"
    style={{ marginTop: "var(--cui-spacings-kilo)" }}
    color="subtle"
    className="subtitle"
  >
    Docs, guides, and resources to help you accept payments with SumUp.
  </Body>
</div>

<style>
  .hero {
    margin: var(--cui-spacings-giga) var(--cui-spacings-zetta);
    text-align: center;
  }

  @media screen and (max-width: 980px) {
    .title {
      font-size: var(--cui-headline-l-font-size);
      line-height: var(--cui-headline-l-line-height);
    }
    .subtitle {
      font-size: var(--cui-body-m-font-size);
      line-height: var(--cui-body-m-line-height);
    }
  }
</style>
