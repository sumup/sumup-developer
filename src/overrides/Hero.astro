---
import { Display, Body } from "@sumup-oss/circuit-ui";

const {
  data: { title },
} = Astro.locals.starlightRoute.entry;
---

<div class="hero">
  <Display
    as="h1"
    size="m"
    weight="bold"
    id={"_top"}
    className="title"
    data-page-title
  >
    {title}
  </Display>
  <Body
    size="l"
    style={{ marginTop: "var(--cui-spacings-kilo)" }}
    color="subtle"
  >
    Docs, guides, and resources to help you accept payments with SumUp.
  </Body>
</div>

<style>
  .hero {
    margin: var(--cui-spacings-giga) var(--cui-spacings-zetta);
    text-align: center;
  }

  @media screen and (max-width: 600px) {
    .title {
      font-size: var(--cui-display-s-font-size);
      line-height: var(--cui-display-s-line-height);
    }
  }
</style>
