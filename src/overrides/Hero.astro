---
import { Display } from "@sumup-oss/circuit-ui";

const {
  data: { title },
} = Astro.locals.starlightRoute.entry;
---

<div class="hero">
  <Display as="h1" size="s" weight="semibold" id={"_top"} data-page-title>
    {title}
  </Display>
</div>

<style>
  .hero {
    margin-top: 2rem;
  }
</style>
