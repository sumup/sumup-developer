---
import { Display } from "@sumup-oss/circuit-ui";

const {
  data: { title },
} = Astro.locals.starlightRoute.entry;
---

<div class="hero">
  <Display
    as="h1"
    size="m"
    weight="bold"
    id={"_top"}
    className="title"
    data-page-title
  >
    {title}
  </Display>
</div>

<style>
  .hero {
    margin-top: 2rem;
  }

  @media screen and (max-width: 600px) {
    .title {
      font-size: var(--cui-display-s-font-size);
      line-height: var(--cui-display-s-line-height);
    }
  }
</style>
