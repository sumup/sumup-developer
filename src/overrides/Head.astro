---
import Default from "@astrojs/starlight/components/Head.astro";
import "@sumup-oss/design-tokens/fonts.css";
import "@sumup-oss/design-tokens/dynamic.css";

const { entry } = Astro.locals.starlightRoute;
Astro.locals.starlightRoute.entry.data.head.push({
  tag: "meta",
  attrs: {
    property: "og:image",
    content: `${Astro.site}open-graph/${entry.id}.png`,
  },
  content: "", // just to satisfy the linter
});
---

{/* This code is intentionally inlined to avoid FOUC. */}
{/* It is wrapped in an IIFE to avoid polluting the global scope. */}
<script is:inline>
  (function () {
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        const element = mutation.target;
        element.dataset.colorScheme = element.dataset.theme;
      });
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  })();
</script>

<Default {...Astro.props} />
