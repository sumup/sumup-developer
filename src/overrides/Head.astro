---
import Default from "@astrojs/starlight/components/Head.astro";
import "@sumup-oss/design-tokens/fonts.css";
import "@sumup-oss/design-tokens/dynamic.css";

const { entry, head, lastUpdated } = Astro.locals.starlightRoute;
const frontmatter = entry.data;
const frontmatterRecord = frontmatter as Record<string, unknown>;

const asString = (value: unknown): string | undefined =>
  typeof value === "string" ? value : undefined;

const routeTitle =
  asString(frontmatterRecord.metaTitle) ||
  asString(frontmatterRecord.title) ||
  "SumUp Developer";
const title = routeTitle.includes("SumUp")
  ? routeTitle
  : `${routeTitle} | SumUp Developer`;
const description = asString(frontmatterRecord.description);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteName = "SumUp Developer";
// stripe leading/trailing slash(es), convert `/` to `index`
const normalizedOgPath =
  Astro.url.pathname === "/"
    ? "index"
    : Astro.url.pathname.replace(/^\/+|\/+$/g, "");
const ogImageUrl = new URL(
  `/og/${normalizedOgPath}.png`,
  Astro.site,
).toString();
const markdownAlternateUrl = new URL(
  `${Astro.url.pathname.replace(/\/?$/, "/")}index.md`,
  Astro.site,
).toString();
const shouldNoIndex = Boolean(
  frontmatterRecord.noindex || frontmatterRecord.draft,
);

function upsertMetaByName(name: string, content: string) {
  const existing = head.find(
    ({ tag, attrs }) => tag === "meta" && attrs?.name === name,
  );
  if (existing?.attrs) {
    existing.attrs.content = content;
    return;
  }
  head.push({
    tag: "meta",
    attrs: { name, content },
  });
}

function upsertMetaByProperty(property: string, content: string) {
  const existing = head.find(
    ({ tag, attrs }) => tag === "meta" && attrs?.property === property,
  );
  if (existing?.attrs) {
    existing.attrs.content = content;
    return;
  }
  head.push({
    tag: "meta",
    attrs: { property, content },
  });
}

function upsertCanonicalLink(href: string) {
  const existing = head.find(
    ({ tag, attrs }) => tag === "link" && attrs?.rel === "canonical",
  );
  if (existing?.attrs) {
    existing.attrs.href = href;
    return;
  }
  head.push({
    tag: "link",
    attrs: { rel: "canonical", href },
  });
}

function ensureMarkdownAlternateLink(href: string) {
  const existing = head.find(
    ({ tag, attrs }) =>
      tag === "link" &&
      attrs?.rel === "alternate" &&
      attrs?.type === "text/markdown",
  );
  if (existing?.attrs) {
    existing.attrs.href = href;
    return;
  }
  head.push({
    tag: "link",
    attrs: { rel: "alternate", type: "text/markdown", href },
  });
}

const existingTitle = head.find(({ tag }) => tag === "title");
if (existingTitle) {
  existingTitle.content = title;
} else {
  head.push({ tag: "title", content: title });
}

upsertMetaByProperty("og:title", title);
upsertMetaByProperty("og:url", canonicalUrl);
upsertMetaByProperty("og:type", entry.id === "" ? "website" : "article");
upsertMetaByProperty("og:site_name", siteName);
upsertMetaByProperty("og:locale", "en_GB");
upsertMetaByProperty("og:image", ogImageUrl);
upsertMetaByProperty("og:image:secure_url", ogImageUrl);
upsertMetaByProperty("og:image:width", "1200");
upsertMetaByProperty("og:image:height", "600");
upsertMetaByName("twitter:title", title);
upsertMetaByName("twitter:card", "summary_large_image");
upsertMetaByName("twitter:image", ogImageUrl);
upsertMetaByName("twitter:site", "@SumUp");

if (description) {
  upsertMetaByName("description", description);
  upsertMetaByProperty("og:description", description);
  upsertMetaByName("twitter:description", description);
}

if (lastUpdated) {
  upsertMetaByProperty("article:modified_time", lastUpdated.toISOString());
}

upsertMetaByName(
  "robots",
  shouldNoIndex
    ? "noindex"
    : "index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1",
);

upsertCanonicalLink(canonicalUrl);
ensureMarkdownAlternateLink(markdownAlternateUrl);
---

{/* This code is intentionally inlined to avoid FOUC. */}
{/* It is wrapped in an IIFE to avoid polluting the global scope. */}
<script is:inline>
  (function () {
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        const element = mutation.target;
        element.dataset.colorScheme = element.dataset.theme;
      });
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  })();
</script>

<Default {...Astro.props} />
