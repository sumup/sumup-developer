---
// Custom SiteTitle overrides logo as a svg to remove flickering on load compared to img with src.
import { SumUpLogomark } from "@sumup-oss/icons";
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <SumUpLogomark />
  <span translate="no">
    {siteTitle}
  </span>
</a>

<style>
  :root,
  :root[data-theme="light"] {
    --sl-color-bg-nav: var(--cui-bg-normal);
    --sl-nav-height: 3.5rem;
  }

  :global(site-search button) {
    height: 2rem !important;
  }

  .site-title {
    display: flex;
    align-items: center;
    text-decoration: none;
    white-space: nowrap;
    color: var(--cui-fg-normal);
    gap: var(--cui-spacings-byte);
    font-size: var(--cui-body-s-font-size);
    line-height: var(--cui-body-s-line-height);
    font-weight: var(--cui-font-weight-semibold);
  }
</style>
