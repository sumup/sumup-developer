---
// Overloaded version of Starlight's SocialIcons that adds
// additional navigation items to the top navigation bar
// such that we can structure the portal around main sections.
const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<div class="nav">
  <a
    href="/"
    class:list={[!isActive("/api") && !isActive("/changelog") && "active"]}
  >
    Docs
  </a>
  <a href="/api/" class:list={[isActive("/api") && "active"]}>API</a>
  <a href="/changelog/" class:list={[isActive("/changelog") && "active"]}>
    Changelog
  </a>
</div>

<style>
  :root {
    .social-icons {
      --sl-icon-color: var(--sl-color-text);
    }
  }

  .nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    font-size: var(--cui-body-s-font-size);
    line-height: var(--cui-body-s-line-height);
    font-weight: var(--cui-font-weight-semibold);
  }

  a {
    padding: var(--cui-spacings-bit) var(--cui-spacings-byte);
    color: var(--cui-fg-normal);
    text-decoration: none;
    transition: color 120ms ease-in-out;
  }

  a:hover {
    color: var(--cui-fg-normal);
    text-decoration: underline;
  }

  a.active {
  color: var(--cui-fg-accent); /* or any highlight color you prefer */
  text-decoration: underline;
  font-weight: var(--cui-font-weight-bold);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('.nav-link');

    navLinks.forEach(link => {
      // Normalize paths by ensuring trailing slash for comparison
      const linkPath = link.getAttribute('href');
      if (linkPath === '/') {
        // Highlight Docs when on root path '/'
        if (currentPath === '/' || currentPath === '') {
          link.classList.add('active');
        }
      } else {
        // Highlight API when path starts with '/api/'
        if (currentPath.startsWith(linkPath)) {
          link.classList.add('active');
        }
      }
    });
  });
</script>
