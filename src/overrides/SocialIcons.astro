---
import { ArrowSlanted } from "@sumup-oss/icons";

// Overloaded version of Starlight's SocialIcons that adds
// additional navigation items to the top navigation bar
// such that we can structure the portal around main sections.
const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<div class="nav">
  <a
    href="/"
    class:list={[
      "link",
      !isActive("/api") && !isActive("/changelog") && "active",
    ]}
  >
    Docs
  </a>
  <a href="/api/" class:list={["link", isActive("/api") && "active"]}>API</a>
  <a
    href="/changelog/"
    class:list={["link", isActive("/changelog") && "active"]}
  >
    Changelog
  </a>
  <a
    href="https://me.sumup.com/settings/developer?signup_intent=developer"
    target="__blank"
    class="link"
  >
    Settings <ArrowSlanted width="14" height="14" />
  </a>
</div>

<style>
  :root {
    .social-icons {
      --sl-icon-color: var(--sl-color-text);
    }
  }

  .nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    font-size: var(--cui-body-s-font-size);
    line-height: var(--cui-body-s-line-height);
    font-weight: var(--cui-font-weight-semibold);
  }

  .link {
    padding: var(--cui-spacings-bit) var(--cui-spacings-byte);
    color: var(--cui-fg-normal);
    text-decoration: none;
    transition: color 120ms ease-in-out;
    display: inline-flex;
    align-items: center;
    gap: var(--cui-spacings-bit);
  }

  .link:hover {
    color: var(--cui-fg-normal);
    text-decoration: underline;
  }

  .link.active {
    color: var(--cui-fg-accent);
    text-decoration: underline;
    font-weight: var(--cui-font-weight-bold);
  }
</style>
