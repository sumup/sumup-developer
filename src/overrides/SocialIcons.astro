---
// Overloaded version of Starlight's SocialIcons that adds
// additional navigation items to the top navigation bar
// such that we can structure the portal around main sections.
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import type { Props as DefaultProps } from "@astrojs/starlight/props";

export type Props = DefaultProps & {
  // Hides social links (such as GitHub icon).
  hideSocial?: boolean;
};

const { hideSocial } = Astro.props;
---

<div class="nav">
  <a href="/online-payments/">Online Payments</a>
  <a href="/terminal-payments/">Terminal Payments</a>
  <a href="/api/">API</a>
  <a href="/help/">Support</a>
</div>
{
  !hideSocial && (
    <Default {...Astro.props}>
      <slot />
    </Default>
  )
}

<style>
  :root {
    .social-icons {
      --sl-icon-color: var(--sl-color-text);
    }
  }

  .nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    font-size: var(--cui-body-s-font-size);
    line-height: var(--cui-body-s-line-height);
    font-weight: var(--cui-font-weight-semibold);
  }

  a {
    padding: var(--cui-spacings-bit) var(--cui-spacings-byte);
    color: var(--cui-fg-normal);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
