---
// A custom item for the mobile navigation that renders
// the main navigation items that are otherwise in the
// top navigation.
// Default Startlight setup doesn't have this because it
// doesn't assume that the top navigation will be heavily
// relied on.
import SocialIcons from "./SocialIcons.astro";
import type { Props } from "@astrojs/starlight/props";
---

<div class="mobile-preferences sl-flex">
  <SocialIcons {...Astro.props} />
</div>

<style>
  .mobile-preferences {
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 1rem;
    padding: 0.5rem 0;
  }

  .mobile-preferences :global(.nav) {
    flex-wrap: wrap;
  }

  @media screen and (max-width: 799px) {
    :global(.nav) {
      width: 100%;
      border-bottom: var(--cui-border-width-kilo) solid var(--cui-border-subtle);
      padding-bottom: var(--cui-spacings-byte);
      margin-bottom: var(--cui-spacings-byte);
    }
  }
</style>
