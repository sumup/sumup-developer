---
import MobileMenuToggle from "./MobileMenuToggle.astro";
import { Help, Info } from "@sumup-oss/icons";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
  <header class="header"><slot name="header" /></header>
  {
    hasSidebar && (
      <nav
        class="sidebar print:hidden"
        aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
      >
        <MobileMenuToggle />
        <div class="sidebar-pane">
          <div class="sidebar-content sl-flex" id="starlight__sidebar">
            <slot name="sidebar" />
          </div>
          <div class="sidebar-footer">
            <a href="/help">
              <Help /> Help
            </a>
            <a href="https://status.sumup.com/">
              <Info /> Status
            </a>
          </div>
        </div>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>
</div>

<style>
  .page {
    flex-direction: column;
    min-height: 100vh;
  }

  .header {
    z-index: var(--sl-z-index-navbar);
    position: fixed;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    height: var(--sl-nav-height);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    padding-inline-end: var(--sl-nav-pad-x);
    background-color: var(--sl-color-bg-nav);
  }

  :global([data-has-sidebar]) .header {
    padding-inline-end: calc(
      var(--cui-spacings-byte) + var(--sl-nav-pad-x) +
        var(--sl-menu-button-size)
    );
  }

  .sidebar-pane {
    opacity: 0;
    position: fixed;
    z-index: var(--sl-z-index-menu);
    margin-bottom: 100vh;
    inset-block: var(--sl-nav-height) 0;
    inset-inline-start: 0;
    width: 100%;
    background-color: var(--sl-color-black);
    display: flex;
    flex-direction: column;
    transition:
      opacity 0.3s ease-in-out,
      margin-bottom 0.3s ease-in-out;
  }

  :global([aria-expanded="true"]) ~ .sidebar-pane {
    opacity: 1;
    margin-bottom: 0;
  }

  @media (min-width: 50rem) {
    :global([data-has-sidebar]) .header {
      padding-inline-end: var(--sl-nav-pad-x);
    }
    .sidebar-pane {
      margin-bottom: 0;
      opacity: 1;
      width: var(--sl-sidebar-width);
      background-color: var(--sl-color-bg-sidebar);
      border-inline-end: 1px solid var(--sl-color-hairline-shade);
    }
  }

  .sidebar-content {
    height: 100%;
    min-height: max-content;
    padding: 1rem var(--sl-sidebar-pad-x);
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
  }

  .sidebar-footer {
    border-top: 1px solid var(--sl-color-hairline-shade);
    padding: 0.8rem var(--sl-sidebar-pad-x);
    display: flex;
    flex-direction: column;
    gap: var(--cui-spacings-bit);
  }

  @media screen and (max-width: 799px) {
    .sidebar-footer {
      display: none;
    }
  }

  .sidebar-footer a {
    font-size: var(--cui-body-s-font-size);
    line-height: var(--cui-body-s-line-height);
    display: block;
    text-decoration: none;
    border-radius: var(--cui-border-radius-bit);
    color: var(--cui-fg-normal);
    padding: var(--cui-spacings-bit) var(--cui-spacings-byte);
    transition: color 120ms ease-in-out;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--cui-spacings-byte);
  }

  .sidebar-footer a > :global(svg) {
    width: 18px;
    height: 18px;
  }

  .sidebar-footer a:hover {
    color: var(--cui-fg-normal-hovered);
    background-color: var(--cui-bg-normal-hovered);
  }

  .sidebar-footer a:focus {
    color: var(--cui-fg-normal-pressed);
    background-color: var(--cui-bg-normal-pressed);
  }

  @media (min-width: 50rem) {
    .sidebar-content::after {
      content: "";
      padding-bottom: 1px;
    }
  }

  .main-frame {
    padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    padding-inline-start: var(--sl-content-inline-start);
  }

  /* Table of contents design touch-ups */
  :global(#starlight__on-this-page) {
    display: none;
  }

  :global(starlight-toc > nav > ul) {
    margin-left: var(--cui-spacings-kilo);
    border-left: var(--cui-border-width-mega) solid var(--cui-border-subtle);
  }

  :global(starlight-toc a[aria-current="true"]) {
    font-weight: var(--cui-font-weight-bold);
  }

  /* Remove hairline borders */
  :global(.right-sidebar) {
    border: none !important;
  }

  :global(.content-panel) {
    border: none !important;
  }
</style>
