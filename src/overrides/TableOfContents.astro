---
import TableOfContentsList from "@astrojs/starlight/components/TableOfContents.astro";
import CopyPageButton from "@components/CopyPageButton.astro";

const { toc } = Astro.locals.starlightRoute;
---

{toc && <TableOfContentsList />}
<div class="page-options">
  <CopyPageButton />
</div>

<style>
  .page-options {
    margin-top: var(--cui-spacings-giga);
    margin-left: var(--cui-spacings-byte);
  }
</style>
