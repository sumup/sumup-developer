---
import { Display, Body } from "@sumup-oss/circuit-ui";

const {
  data: { title, description },
} = Astro.locals.starlightRoute.entry;
---

<div class="page-title">
  <Display
    as="h1"
    size="s"
    weight="semibold"
    id={"_top"}
    className="title"
    data-page-title
  >
    {title}
  </Display>
  {
    description && (
      <Body
        size="l"
        style={{ marginTop: "var(--cui-spacings-mega)" }}
        color="subtle"
        className="subtitle"
      >
        {description}
      </Body>
    )
  }
</div>

<style>
  .page-title {
    text-align: center;
    padding: var(--cui-spacings-tera) 0 var(--cui-spacings-byte);
  }

  @media screen and (max-width: 980px) {
    .title {
      font-size: var(--cui-headline-l-font-size);
      line-height: var(--cui-headline-l-line-height);
    }
  }

  @media screen and (max-width: 520px) {
    .subtitle {
      font-size: var(--cui-body-m-font-size);
      line-height: var(--cui-body-m-line-height);
    }
  }
</style>
