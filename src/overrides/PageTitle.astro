---
import { Headline, Body } from "@sumup-oss/circuit-ui";

const {
  data: { title, description },
} = Astro.locals.starlightRoute.entry;
---

<div class="page-title">
  <Headline as="h1" size="l" id={"_top"} className="title" data-page-title>
    {title}
  </Headline>
  {
    description && (
      <Body
        style={{ marginTop: "var(--cui-spacings-mega)" }}
        color="subtle"
        className="subtitle"
      >
        {description}
      </Body>
    )
  }
</div>

<style>
  .page-title {
    padding: var(--cui-spacings-mega) 0 var(--cui-spacings-byte);
  }
</style>
