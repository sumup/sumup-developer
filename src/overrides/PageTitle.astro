---
import { Display } from "@sumup-oss/circuit-ui";

const {
  data: { title },
} = Astro.locals.starlightRoute.entry;
---

<Display
  as="h1"
  size="s"
  weight="bold"
  id={"_top"}
  className="title"
  data-page-title
>
  {title}
</Display>

<style>
  @media screen and (max-width: 600px) {
    .title {
      font-size: var(--cui-headline-l-font-size);
      line-height: var(--cui-headline-l-line-height);
    }
  }
</style>
