---
import type { Props } from "@astrojs/starlight/props";
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { Breadcrumbs } from "astro-breadcrumbs";
import "astro-breadcrumbs/breadcrumbs.css";
import { getEntry } from "astro:content";

type Breadcrumb = {
  text: string;
  href: string;
};

const getBreadcrumbs = async (pathname: string): Promise<Breadcrumb[]> => {
  const paths = pathname.split("/").filter(Boolean);
  let path = "";

  const crumbs = await Promise.all(
    paths.map(async (segment) => {
      const id = `${path ? `${path}/` : path}${segment}`;
      path = id;
      const page = await getEntry("docs", id);
      return page
        ? {
            text: page.data?.title,
            href: `/${id}/`,
          }
        : undefined;
    }),
  );

  if (!crumbs.every(Boolean)) {
    return [];
  }

  return [{ text: "Home", href: "/" }, ...(crumbs as Breadcrumb[])];
};

const crumbs = await getBreadcrumbs(Astro.url.pathname);
---

{
  crumbs?.length > 1 && (
    <Breadcrumbs crumbs={crumbs}>
      <div slot="separator">/</div>
    </Breadcrumbs>
  )
}
<Default {...Astro.props} />

<style>
  :global(.c-breadcrumbs) {
    color: var(--cui-fg-subtle);
    font-size: 0.9rem;
  }

  :global(.c-breadcrumbs__link) {
    font-size: 0.9rem;
    color: var(--cui-fg-subtle);
    text-decoration: none;
  }

  :global(.c-breadcrumbs__link:hover) {
    text-decoration: underline;
  }
</style>
