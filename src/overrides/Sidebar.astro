---
// Customized sidebar.
// - Adds custom navigation for mobile menu.
// - Renders default 'Overview' items for sub-collections.
import type { Props } from "@astrojs/starlight/props";
import { getSidebar, lookupProductTitle, type Group } from "@lib/sidebar";
import SidebarSublist from "./SidebarSublist.astro";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import MobileMenuFooter from "./MobileMenuFooter.astro";
import MobileMenuHeader from "./MobileMenuHeader.astro";

const { id } = Astro.props;
const currentSection = id?.split("/")[0];

const sidebar =
  currentSection !== "api"
    ? (await getSidebar(Astro)).entries
    : (Astro.props.sidebar[0] as Group).entries;

const title =
  currentSection !== "api"
    ? await lookupProductTitle(currentSection)
    : "API Reference";
---

<div class="md:sl-hidden">
  <MobileMenuHeader {...Astro.props} hideSocial />
</div>

<SidebarPersister
  {...Astro.props}
  sidebar={sidebar as Props["sidebar"]}
  transition:name="sidebar"
>
  <SidebarSublist
    sublist={sidebar as Props["sidebar"]}
    expanded={currentSection !== "api"}
    title={title}
  />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter {...Astro.props} />
</div>

<style>
  :root,
  :root[data-theme="light"] {
    --sl-color-bg-sidebar: var(--cui-bg-subtle);
    --sl-sidebar-width: 17rem;
  }

  :global(sl-sidebar-state-persist) {
    display: block;
  }

  :global(.sidebar-content) {
    gap: 0;
  }
</style>
