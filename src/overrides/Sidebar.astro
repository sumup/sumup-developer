---
// Customized sidebar.
// - Adds custom navigation for mobile menu.
// - Renders default 'Overview' items for sub-collections.
import type { StarlightRouteData } from "@astrojs/starlight/route-data";
import SidebarSublist from "./SidebarSublist.astro";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import MobileMenuFooter from "./MobileMenuFooter.astro";
import MobileMenuHeader from "./MobileMenuHeader.astro";

const { id } = Astro.locals.starlightRoute;
const currentSection = id?.split("/")[0];

const { sidebar } = Astro.locals.starlightRoute;
---

<div class="md:sl-hidden">
  <MobileMenuHeader {...Astro.props} hideSocial />
</div>

<SidebarPersister>
  <SidebarSublist
    sublist={sidebar as StarlightRouteData["sidebar"]}
    expanded={currentSection !== "api"}
  />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter {...Astro.props} />
</div>

<style>
  :root,
  :root[data-theme="light"] {
    --sl-color-bg-sidebar: var(--cui-bg-normal);
    --sl-sidebar-width: 17rem;
  }

  :global(sl-sidebar-state-persist) {
    display: block;
  }

  :global(.sidebar-content) {
    gap: 0;
  }
</style>
