---
import { Hamburger } from "@sumup-oss/circuit-ui";
---

<starlight-menu-button class="print:hidden md:sl-hidden menu-button">
  <Hamburger
    activeLabel="Close"
    inactiveLabel="Open"
    className="menu-button-toggle"
    client:load
  />
</starlight-menu-button>

<script>
  class StarlightMenuButton extends HTMLElement {
    btn = this.querySelector("button")!;

    constructor() {
      super();
      // Toggle `aria-expanded` state when a user clicks the button.
      this.btn.addEventListener("click", () => this.toggleExpanded());

      // Close the menu when a user presses the escape key.
      const parentNav = this.closest("nav");
      if (parentNav) {
        parentNav.addEventListener("keyup", (e) => this.closeOnEscape(e));
      }
    }

    setExpanded(expanded: boolean) {
      this.setAttribute("aria-expanded", String(expanded));

      // Hamburger from circuit-ui uses aria-pressed for state differentiation
      this.setAttribute("aria-pressed", String(expanded));

      document.body.toggleAttribute("data-mobile-menu-expanded", expanded);
      // Trap keyboard focus inside the header and menu when the menu is expanded.
      document
        .querySelectorAll<HTMLElement>(".main-frame, .sl-skip-link")
        .forEach((el) => {
          el.toggleAttribute("inert", expanded);
        });
    }

    toggleExpanded() {
      this.setExpanded(this.getAttribute("aria-expanded") !== "true");
    }

    closeOnEscape(e: KeyboardEvent) {
      if (e.code === "Escape") {
        this.setExpanded(false);
        this.btn.focus();
      }
    }
  }

  customElements.define("starlight-menu-button", StarlightMenuButton);

  // Reset menu state when the viewport toggles between mobile and desktop sizes.
  matchMedia("(min-width: 50em)").addEventListener("change", () => {
    document
      .querySelector<StarlightMenuButton>("starlight-menu-button")
      ?.setExpanded(false);
  });
</script>

<style is:global>
  starlight-menu-button {
    position: fixed;
    top: calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2);
    inset-inline-end: var(--sl-nav-pad-x);
    z-index: var(--sl-z-index-navbar);
    border: 0;
  }

  /* not the nicest thing ever but it makes our Hamburger worker with starlight */
  .menu-button-toggle {
    margin: -2px;
    padding: 6px;
  }

  [data-mobile-menu-expanded] {
    overflow: hidden;
  }

  @media (min-width: 50rem) {
    [data-mobile-menu-expanded] {
      overflow: auto;
    }
  }
</style>
