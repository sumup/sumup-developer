---
// Customized version of the SidebarList, the code is still
// very similar to Startlight's SidebarSublist but we adjust
// the styles and for certain content don't use expandable
// sections.
import { Icon } from "@astrojs/starlight/components";
import type { SidebarEntry, Link, Group } from "../types/sidebar";
import SidebarRestorePoint from "./SidebarRestorePoint.astro";

interface Props {
  sublist: SidebarEntry[];
  expanded?: boolean;
  depth?: number;
}

const applyLabelOverride = (label: string): string => {
  switch (label) {
    case "apm":
      return "Alternative Payment Methods";
    case "llms":
      return "Build with AI";
    case "guides":
      return "Custom Integrations";
    case "sdks":
      return "SDKs";
    case "agent-toolkit":
      return "Agent Toolkit";
    case "api":
      return "API";
    case "authorization":
      return "Authorization";
    case "events":
      return "Events";
    case "checkouts":
      return "Checkout Tools";
    case "webhooks":
      return "Webhooks";
    case "glossary":
      return "Glossary";
    case "plugins":
      return "Plugins";
    default:
      return label;
  }
};

const flattenSidebar = (sidebar: SidebarEntry[]): Link[] => {
  return sidebar.flatMap((entry) =>
    entry.type === "group" ? flattenSidebar(entry.entries) : entry,
  );
};

const { sublist, expanded, depth = 0 } = Astro.props;

const isExpandable = (entry: SidebarEntry): boolean => {
  return (!expanded || depth >= 1) && entry.label !== "SumUp API";
};

const isOpen = (entry: Group): boolean => {
  return (
    flattenSidebar(entry.entries).some((i) => i.isCurrent) || !entry.collapsed
  );
};
---

<ul class:list={["sidebar", depth > 1 && "nested"]}>
  {
    sublist.map((entry) => (
      <li>
        {entry.type === "link" && (
          <a
            href={entry.href}
            aria-current={entry.isCurrent && "page"}
            class:list={[entry.attrs.class]}
            {...entry.attrs}
          >
            <span>{entry.label}</span>
          </a>
        )}
        {entry.type === "group" && isExpandable(entry) && (
          <details open={isOpen(entry)}>
            <SidebarRestorePoint />
            <summary class:list={["entry", depth < 1 && "group-header"]}>
              <div class="group-label">
                <span>{applyLabelOverride(entry.label)}</span>
              </div>
              <Icon name="right-caret" class="caret" size="1.25rem" />
            </summary>
            <Astro.self
              sublist={entry.entries}
              expanded={expanded}
              depth={depth + 1}
            />
          </details>
        )}
        {entry.type === "group" && !isExpandable(entry) && (
          <>
            <span class:list={["entry", "group-header"]}>
              <span>{entry.label}</span>
            </span>
            <Astro.self
              sublist={entry.entries}
              expanded={expanded}
              depth={depth + 1}
            />
          </>
        )}
      </li>
    ))
  }
</ul>

<style>
  .sidebar {
    font-size: var(--cui-body-s-font-size);
    line-height: var(--cui-body-s-line-height);
  }

  .entry {
    margin: var(--cui-spacings-bit) 0;
    display: flex;
    align-items: center;
    padding: 0.2em var(--sl-sidebar-item-padding-inline);
    gap: var(--cui-spacings-byte);
  }

  .group-header {
    font-weight: var(--cui-font-weight-bold);
    color: var(--cui-fg-normal);
  }

  .group-header :global(svg) {
    height: 18px;
    width: 18px;
  }

  .title {
    margin-top: 0;
  }

  ul {
    --sl-sidebar-item-padding-inline: 0.5rem;
    list-style: none;
    padding: 0;
  }

  ul.nested {
    padding-left: var(--cui-spacings-kilo);
  }

  li {
    overflow-wrap: anywhere;
    margin-bottom: var(--cui-spacings-bit);
  }

  ul:not(.nested) > li:last-of-type {
    margin-bottom: var(--cui-spacings-mega);
  }

  summary {
    cursor: pointer;
    user-select: none;
  }

  summary::marker,
  summary::-webkit-details-marker {
    display: none;
  }

  .caret {
    transition: transform 0.2s ease-in-out;
    flex-shrink: 0;
  }
  :global([dir="rtl"]) .caret {
    transform: rotateZ(180deg);
  }
  [open] > summary .caret {
    transform: rotateZ(90deg);
  }

  a {
    display: block;
    text-decoration: none;
    border-radius: var(--cui-border-radius-bit);
    color: var(--cui-fg-subtle);
    padding: var(--cui-spacings-bit) var(--cui-spacings-byte);
    transition: color 120ms ease-in-out;
  }

  a:hover {
    color: var(--cui-fg-normal-hovered);
    background-color: var(--cui-bg-normal-hovered);
  }

  a:focus {
    color: var(--cui-fg-normal-pressed);
    background-color: var(--cui-bg-normal-pressed);
  }

  [aria-current="page"],
  [aria-current="page"]:hover,
  [aria-current="page"]:focus {
    color: var(--cui-fg-on-strong);
    background-color: var(--cui-bg-strong);
  }

  a > *:not(:last-child),
  .group-label > *:not(:last-child) {
    margin-inline-end: 0.25em;
  }
</style>
