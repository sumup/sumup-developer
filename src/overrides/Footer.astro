---
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import Default from "@astrojs/starlight/components/Footer.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import type { Props } from "@astrojs/starlight/props";
import Feedback from "@components/Feedback.astro";
import { Anchor } from "@sumup-oss/circuit-ui";
import { Help, History, Webspace } from "@sumup-oss/icons";

const isHomepage = Astro.props.slug === "";
---

{
  isHomepage ? (
    <div class="container">
      <div class="columns">
        <div class="column">
          <h4>Links</h4>
          <a href="/terminal-payments/introduction/overview">
            Card Reader Payments
          </a>
          <a href="/online-payments/introduction/get-started">
            Online Payments
          </a>
          <a href="/api">API Reference</a>
          <a href="/help">Help</a>
        </div>
        <div class="column">
          <h4>More</h4>
          <a href="https://sumup.com/">SumUp Homepage</a>
          <a href="https://www.sumup.com/sumup-handbook">Handbook</a>
          <a href="https://www.sumup.com/affiliate-program">Affiliates</a>
          <a href="https://www.sumup.com/business-guide">Business Guide</a>
          <a href="https://www.sumup.com/press">Press</a>
          <a href="https://sumup.com/careers">Careers</a>
          <a href="https://help.sumup.com/">Help Center</a>
        </div>
      </div>
      <div class="meta">
        <div>Copyright © {new Date().getFullYear()} SumUp</div>
        <a href="https://sumup.com/legal/">Legal Notice</a>
        <a href="https://sumup.com/privacy/">Privacy Policy</a>
        <a href="https://sumup.com/terms/">Terms & Conditions</a>
        <a href="https://sumup.com/cookies/">Cookie Policy</a>
      </div>
    </div>
  ) : (
    <>
      <Feedback />
      <footer>
        <div class="meta">
          <EditLink {...Astro.props} />
          <LastUpdated {...Astro.props} />
        </div>
        <div class="footer-links">
          <div>
            <>
              <Webspace />
              <span>
                Go to{" "}
                <Anchor href="https://me.sumup.com">SumUp Dashboard</Anchor>.
              </span>
            </>
          </div>
          <div>
            <Help />{" "}
            <span>
              Need help? <Anchor href="/help">Contact Support</Anchor>.
            </span>
          </div>
          <div>
            <>
              <History />
              <span>
                Check out our <Anchor href="/changelog">Changelog</Anchor>.
              </span>
            </>
          </div>
        </div>
      </footer>
    </>
  )
}

<style lang="scss">
  footer {
    padding: var(--cui-spacings-tera) var(--cui-spacings-mega);
    border-top: var(--cui-border-width-kilo) solid var(--cui-border-normal);
  }

  footer {
    font-size: 0.9rem;
  }

  .meta {
    display: flex;
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    font-size: 0.9rem;
    color: var(--cui-fg-subtle);
  }

  .meta > :global(p:only-child) {
    margin-inline-start: auto;
  }

  .container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--cui-spacings-giga);
    max-width: 960px;
    margin: 0 auto;
  }

  @media (min-width: 480px) {
    .container {
      flex-direction: row;
    }
  }

  .footer-links {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .footer-links > div {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.4rem;
  }
  .footer-links :global(svg) {
    width: 20px;
    height: 20px;
  }
  .footer-links :global(a) {
    font-size: 0.9rem;
  }
</style>
