---
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import Feedback from "@components/Feedback.astro";
import { Help, History, Webspace, Sparkles } from "@sumup-oss/icons";
---

{!Astro.locals.starlightRoute.custom && <Feedback />}
<footer>
  <div class="meta">
    <EditLink {...Astro.props} />
    <LastUpdated {...Astro.props} />
  </div>
  <div class="footer-links">
    <div>
      <Webspace />
      <span>
        Go to <a href="https://me.sumup.com?signup_intent=developer">SumUp Dashboard</a>.
      </span>
    </div>
    <div>
      <Help />
      <span>
        Need help? <a href="/help">Contact Support</a>.
      </span>
    </div>
    <div>
      <History />
      <span>
        Check out our <a href="/changelog">Changelog</a>.
      </span>
    </div>
    <div>
      <Sparkles />
      <span>
        LLM? <a href="/llms.txt">Checkout llms.txt</a>.
      </span>
    </div>
  </div>
</footer>

<style lang="scss">
  footer {
    margin-top: var(--cui-spacings-exa);
    padding-top: var(--cui-spacings-tera);
    border-top: var(--cui-border-width-kilo) solid var(--cui-border-normal);
  }

  footer {
    font-size: 0.9rem;
  }

  .meta {
    display: flex;
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    font-size: 0.9rem;
    color: var(--cui-fg-subtle);
  }

  .meta > :global(p:only-child) {
    margin-inline-start: auto;
  }

  footer a {
    color: var(--cui-fg-subtle);
    text-decoration: none;

    &:hover,
    &:focus {
      color: var(--cui-fg-subtle-hovered);
      text-decoration: underline;
    }
    &:active {
      color: var(--cui-fg-subtle-pressed);
    }
  }

  .footer-links {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-links > div {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.4rem;
  }

  .footer-links :global(svg) {
    width: 20px;
    height: 20px;
  }

  .footer-links :global(a) {
    font-size: 0.9rem;
  }
</style>
