---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";
import { Anchor, Body, Headline } from "@sumup-oss/circuit-ui";
import { Illustration } from "@sumup-oss/illustrations";

const props = {
  frontmatter: {
    title: "Page not found",
    tableOfContents: false,
    template: "splash",
  },
  custom: true,
} as StarlightPageProps;
---

<StarlightPage {...props}>
  <div class="wrap">
    <div class="img">
      <Illustration name="problems" />
    </div>
    <Headline as="h1">Page not found</Headline>
    <Body className="subtitle">
      Sorry, but the page you were looking for couldn't be found.
    </Body>
    <Body>
      If you can't find what you're looking for, try our
      <Anchor href="/">home page</Anchor>.
    </Body>
  </div>
</StarlightPage>

<style lang="scss">
  .wrap {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--cui-fg-subtle);
    text-align: center;
  }

  .img {
    display: flex;
    flex-direction: row;
    justify-content: center;
    margin-bottom: var(--cui-spacings-zetta);
  }

  .subtitle {
    margin: var(--cui-spacings-mega) 0;
  }
</style>
