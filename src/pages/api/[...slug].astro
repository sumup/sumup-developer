---
import {
  getApiRoute,
  getApiStaticPaths,
} from "@cloudflare/nimbus-docs/runtime";
import DocsLayout from "../../layouts/DocsLayout.astro";
import ApiDocs from "@components/ApiDocs/ApiDocs.astro";
import LegacyLinks from "@components/ApiDocs/LegacyLinks.astro";
import { apiReference } from "@lib/api/reference";
import { API_HOME_CHUNK_SIZE, apiSidebar } from "@lib/api/presentation";

export const prerender = true;
export const getStaticPaths = getApiStaticPaths("api", {
  homeChunkSize: API_HOME_CHUNK_SIZE,
});

const result = await getApiRoute(Astro, "api", {
  homeChunkSize: API_HOME_CHUNK_SIZE,
});
if (result instanceof Response) return result;
const { page, nav, collection, version, coordinate, home } = result;
const part = home && home.part.number > 1 ? home.part : undefined;
const pathname = new URL(page.href, Astro.url).pathname;
---

<DocsLayout
  title={
    part
      ? `${page.title}: endpoints ${part.start}–${part.end} · API`
      : page.title
  }
  description="SumUp API reference and SDK code samples."
  hideDescription
  markdownUrl={page.markdownHref}
  socialImage={`/og${pathname.replace(/\/$/, "")}.png`}
  noindex={part !== undefined}
  searchable={part === undefined}
  collection={collection}
  apiVersion={version ?? undefined}
  coordinate={coordinate}
  sidebar={[
    {
      type: "link",
      label: "SumUp API",
      href: "/api/",
      order: -1,
      isCurrent: page.kind === "api",
    },
    ...apiSidebar(nav.items),
  ]}
  sidebarSections={false}
  sidebarFilter
  headings={false}
  breadcrumbs={[...page.breadcrumbs, { label: page.title }]}
  prevNext={nav.prevNext ?? {}}
  contentWidth="84rem"
  prose={false}
>
  <ApiDocs page={page} home={home} />
  <LegacyLinks links={apiReference.legacyLinks} />
</DocsLayout>
