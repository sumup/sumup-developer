---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ApiDocs from "@components/ApiDocs/ApiDocs.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";
import { formatSlug } from "@lib/helpers";
import { doc, pathsByTag } from "@lib/openapi";
import type { StarlightUserConfig } from "@astrojs/starlight/types";
import type { I18nBadgeConfig } from "node_modules/@astrojs/starlight/schemas/badge";

// list of resources that are expanded by default
const mainResources = ["Checkouts", "Customers"];

export async function getStaticPaths() {
  return [
    // root
    { params: { path: undefined }, props: {} },
    { params: { path: "authentication" }, props: {} },
    // tags
    ...(doc.tags || []).map((tag) => ({
      params: { path: formatSlug(tag.name) },
    })),
    // operations
    ...Object.entries(pathsByTag).flatMap(([tag, operations]) =>
      operations.map((o) => ({
        params: { path: `${formatSlug(tag)}/${formatSlug(o.slug)}` },
      })),
    ),
  ];
}

const sidebar: StarlightUserConfig["sidebar"] = [
  {
    label: "api",
    items: [
      {
        label: "Overview",
        link: "/api",
        attrs: {
          "data-scroll-to": "introduction",
        },
      },
      {
        label: "Authentication",
        link: "/api/authentication",
        attrs: {
          "data-scroll-to": "authentication",
        },
      },
      ...Object.entries(pathsByTag).map(([tagName, operations]) => {
        const tag = doc.tags.find((t) => formatSlug(t.name) === tagName)!;
        return {
          label: tag.name,
          collapsed: !mainResources.includes(tag.name),
          items: [
            {
              label: "Overview",
              link: `/api/${formatSlug(tag.name)}`,
              attrs: {
                "data-scroll-to": `${formatSlug(tag.name)}`,
              },
            },
            ...operations.map((op) => ({
              label: op.summary!,
              link: `/api/${formatSlug(tag.name)}/${formatSlug(op.slug)}`,
              badge: (op.deprecated
                ? {
                    text: "Deprecated",
                    variant: "caution",
                  }
                : undefined) as I18nBadgeConfig,
              attrs: {
                "data-scroll-to": `${formatSlug(tag.name)}-${op.slug}`,
              },
            })),
          ],
        };
      }),
    ],
  },
];

const props = {
  frontmatter: {
    title: "API Reference",
    description: "SumUp API reference.",
    tableOfContents: false,
  },
  sidebar,
  custom: true,
} as StarlightPageProps;

const { path } = Astro.params;
const [tag, section] = (path || "").split("/");
---

<StarlightPage {...props}>
  <link
    slot="head"
    rel="canonical"
    href={`https://developer.sumup.com/docs/api/${section || tag}`}
  />
  {
    (tag || section) && (
      <link rel="canonical" href="`https://developer.sumup.com/api" />
    )
  }
  <ApiDocs target={path} />
</StarlightPage>

<script>
  // scroll to the current Tag / Operation based on the path
  // In order: '', 'api', tag, section
  const [, , tag, section] = window.location.pathname.split("/");
  if (tag) {
    // scroll to current target
    const scrollTo = section ? `${tag}-${section}` : tag;
    const target = document.getElementById(scrollTo);
    if (target) {
      target.scrollIntoView();
    }
    const opt: HTMLOptionElement | undefined | null = document
      .getElementById("apiSelectNav")
      ?.querySelector(`option[value="${scrollTo}"]`);
    if (opt) {
      opt.selected = true;
    }
  }

  const initClientSideNavigation = () => {
    const links = document.querySelectorAll("[data-scroll-to]");

    const sections = Array.from(links).map((link) => {
      const scrollTo = link.getAttribute("data-scroll-to");
      if (scrollTo) {
        return document.getElementById(scrollTo);
      }
    });

    for (const link of links) {
      link.addEventListener("click", (e) => {
        const scrollTo = link.getAttribute("data-scroll-to");
        if (!scrollTo) return;
        e.preventDefault();
        document
          .querySelector('[aria-current="page"]')
          ?.removeAttribute("aria-current");
        link.setAttribute("aria-current", "page");
        const target = document.getElementById(scrollTo);
        if (target) {
          target.scrollIntoView();
          history.pushState({}, "", link.getAttribute("href"));
          e.preventDefault();
        }
        document.body.toggleAttribute("data-mobile-menu-expanded", false);
        document
          .querySelector("starlight-menu-button")
          ?.setAttribute("aria-expanded", "false");
      });
    }

    const onScroll = () => {
      let closestSection: HTMLElement | null = null;
      let closestDistance = Infinity;

      sections.forEach((section) => {
        if (section) {
          const rect = section.getBoundingClientRect();
          const distanceFromTop = Math.abs(rect.top - 50); // Calculate distance from 50px
          if (distanceFromTop < closestDistance) {
            closestDistance = distanceFromTop;
            closestSection = section;
          }
        }
      });

      if (closestSection) {
        const link = Array.from(links).find(
          (link) => link.getAttribute("data-scroll-to") === closestSection?.id,
        );

        if (link) {
          // Update the aria-current attribute
          document
            .querySelector('[aria-current="page"]')
            ?.removeAttribute("aria-current");
          link.setAttribute("aria-current", "page");

          // Open the parent <details> if necessary
          const details = link.closest("details") as HTMLElement;
          if (details && !details.hasAttribute("open")) {
            details.setAttribute("open", "");
            details.dataset.wasAutoOpened = "true"; // Mark as auto-opened
          }

          // Close other auto-opened details elements
          Array.from(
            document.querySelectorAll(
              "details[data-was-auto-opened]",
            ) as NodeListOf<HTMLElement>,
          )
            .filter((d) => d !== details)
            .forEach((d) => {
              d.removeAttribute("open");
              delete d.dataset.wasAutoOpened;
            });
        }
      }
    };
    document.addEventListener("scroll", onScroll, { passive: true });
  };

  document.addEventListener("astro:page-load", initClientSideNavigation);
  document.addEventListener("DOMContentLoaded", initClientSideNavigation);
</script>

<style is:global>
  /* Wider content */
  .sl-container {
    max-width: 80rem !important;
  }
</style>
