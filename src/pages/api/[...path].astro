---
import ApiDocs from "@components/ApiDocs/ApiDocs.astro";
import type { SidebarItem } from "@cloudflare/nimbus-docs/types";
import { pathsByTag } from "@lib/openapi";
import {
  apiTopLevelPaths,
  getApiTopSection,
  isApiTopLevelPath,
} from "@lib/openapi/routes";
import {
  getTagBySlug,
  getTagEntryBySlug,
  orderedTagEntriesCached,
} from "@lib/openapi/tags";
import DocsLayout from "../../layouts/DocsLayout.astro";

export const prerender = true;

// list of resources that are expanded by default
const mainResources = ["Checkouts", "Readers"];

export async function getStaticPaths() {
  return [
    // top-level pages
    { params: { path: undefined }, props: {} },
    ...apiTopLevelPaths.map((path) => ({ params: { path }, props: {} })),
    // tags
    ...orderedTagEntriesCached.map(([tag]) => ({
      params: { path: tag },
    })),
    // operations
    ...Object.entries(pathsByTag).flatMap(([tag, operations]) =>
      operations.map((operation) => ({
        params: { path: `${tag}/${operation.slug}` },
      })),
    ),
  ];
}

const { path } = Astro.params;
const [segment, section] = (path || "").split("/");
const currentTagEntry = segment ? getTagEntryBySlug(segment) : undefined;
const isApiLandingPage = !segment;
const isTopLevelPage = !segment || isApiTopLevelPath(segment);
const topSection = getApiTopSection(segment);

const currentTag = segment ? getTagBySlug(segment) : undefined;
const currentOperation =
  currentTagEntry && section
    ? currentTagEntry.find((operation) => operation.slug === section)
    : undefined;
const isApiTagLandingPage = Boolean(currentTag) && !section;

const canonicalPath = path ? `/api/${path}` : "/api";
const pageTitle =
  currentOperation?.summary || currentTag?.name || "API Reference";

const sidebar: SidebarItem[] = [
  {
    type: "link",
    label: "SumUp API",
    href: "/api/",
    isCurrent: canonicalPath === "/api",
    order: 0,
  },
  ...apiTopLevelPaths.map((topLevelPath, index) => ({
    type: "link" as const,
    label:
      topLevelPath === "sdks"
        ? "SDKs"
        : `${topLevelPath.charAt(0).toUpperCase()}${topLevelPath.slice(1)}`,
    href: `/api/${topLevelPath}/`,
    isCurrent: segment === topLevelPath,
    attrs: { "data-scroll-to": topLevelPath },
    order: index + 1,
  })),
  ...orderedTagEntriesCached.map(([tagName, operations], tagIndex) => {
    const tag = getTagBySlug(tagName)!;
    return {
      type: "group" as const,
      label: tag.name,
      order: apiTopLevelPaths.length + tagIndex + 1,
      collapsed: !mainResources.includes(tag.name),
      indexHref: `/api/${tagName}/`,
      indexIsCurrent: segment === tagName && !section,
      children: operations.map((operation, operationIndex) => ({
        type: "link" as const,
        label: operation.summary!,
        href: `/api/${tagName}/${operation.slug}/`,
        isCurrent: segment === tagName && section === operation.slug,
        attrs: {
          "data-scroll-to": `${tagName}-${operation.slug}`,
        },
        order: operationIndex,
      })),
    };
  }),
];
---

<DocsLayout
  title={pageTitle}
  description="SumUp API reference and code samples."
  sidebar={sidebar}
  headings={false}
  breadcrumbs={[]}
  prevNext={{}}
  socialImage="/og/index.png"
  wide
  hideTitle={!isApiLandingPage && !isApiTagLandingPage}
  hideDescription={!isApiLandingPage}
  prose={false}
>
  <ApiDocs
    class="api-docs"
    tagSlug={isTopLevelPage ? undefined : segment}
    operationSlug={isTopLevelPage ? undefined : section}
    topSection={topSection}
  />
</DocsLayout>

<style>
  :global(.api-docs) {
    width: 100%;
    max-width: 84rem;
    margin: 0 auto;
  }

  :global(.page-heading) {
    width: 100%;
    max-width: 84rem;
    margin-inline: auto;
  }
</style>

<script>
  import { initApiSidebarNavigation } from "@lib/openapi/sidebar-nav";

  initApiSidebarNavigation();
  document.addEventListener("astro:page-load", initApiSidebarNavigation);
</script>
