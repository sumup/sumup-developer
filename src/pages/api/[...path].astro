---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ApiDocs from "@components/ApiDocs/ApiDocs.astro";
import type { Props, StarlightPageProps } from "@astrojs/starlight/props";
import { formatSlug } from "@lib/helpers";
import { doc, pathsByTag } from "@lib/openapi";
import type { StarlightUserConfig } from "@astrojs/starlight/types";

const mainResources = ["Checkouts", "Customers", "Merchant"];

export async function getStaticPaths() {
  return [
    // root
    { params: { path: undefined }, props: {} },
    // tags
    ...(doc.tags || []).map((tag) => ({
      params: { path: formatSlug(tag.name) },
    })),
    // individual endpoints
    ...Object.entries(pathsByTag).flatMap(([tag, operations]) =>
      operations.map((o) => ({
        params: { path: `${formatSlug(tag)}/${formatSlug(o.slug)}` },
      })),
    ),
  ];
}

const sidebar: StarlightUserConfig["sidebar"] = [
  {
    label: "api",
    items: [
      {
        label: "Overview",
        link: "/api",
      },
      ...Object.entries(pathsByTag).map(([tagName, operations]) => {
        const tag = doc.tags.find((t) => formatSlug(t.name) === tagName)!;
        return {
          label: tag.name,
          collapsed: !mainResources.includes(tag.name),
          items: [
            {
              label: "Overview",
              link: `/api/${formatSlug(tag.name)}`,
              attrs: {
                "data-scroll-to": `${formatSlug(tag.name)}`,
              },
            },
            ...operations.map((op) => ({
              label: op.summary!,
              link: `/api/${formatSlug(tag.name)}/${formatSlug(op.slug)}`,
              badge: op.deprecated
                ? {
                    text: "Deprecated",
                    variant: "caution",
                  }
                : undefined,
              attrs: {
                "data-scroll-to": `${formatSlug(tag.name)}-${op.slug}`,
              },
            })),
          ],
        };
      }),
    ],
  },
];

// TODO: fix the types
Astro.props.sidebar = sidebar as unknown as StarlightPageProps["sidebar"];

const frontmatter = {
  title: "API Reference",
  description: "SumUp API reference.",
  tableOfContents: false,
} as StarlightPageProps["frontmatter"];

const { path } = Astro.params;
const [tag, section] = (path || "").split("/");
---

<StarlightPage frontmatter={frontmatter} {...Astro.props}>
  <link
    slot="head"
    rel="canonical"
    href={`https://developer.sumup.com/docs/api/${section || tag}`}
  />
  {
    (tag || section) && (
      <link rel="canonical" href="`https://developer.sumup.com/api" />
    )
  }
  <ApiDocs target={path} />
</StarlightPage>

<script>
  // scroll to the current Tag / Operation based on the path
  // In order: '', 'api', tag, section
  const [, , tag, section] = window.location.pathname.split("/");
  if (tag || section) {
    // scroll to current target
    const scrollTo = section ? `${tag}-${section}` : tag;
    const target = document.getElementById(scrollTo);
    if (target) {
      target.scrollIntoView();
    }
    const opt: HTMLOptionElement | undefined | null = document
      .getElementById("apiSelectNav")
      ?.querySelector(`option[value="${scrollTo}"]`);
    if (opt) {
      opt.selected = true;
    }
  }
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const links = document.querySelectorAll("[data-scroll-to]");
    const sections = Array.from(links).map((link) => {
      const scrollTo = link.getAttribute("data-scroll-to");
      return document.getElementById(scrollTo);
    });

    for (const link of links) {
      link.addEventListener("click", (e) => {
        const scrollTo = link.getAttribute("data-scroll-to");
        if (!scrollTo) return;
        e.preventDefault();
        document
          .querySelector('[aria-current="page"]')
          ?.removeAttribute("aria-current");
        link.setAttribute("aria-current", "page");
        const target = document.getElementById(scrollTo);
        if (target) {
          target.scrollIntoView();
          history.pushState({}, "", link.getAttribute("href"));
          e.preventDefault();
        }
      });
    }

    const onScroll = () => {
      let closestSection = null;
      let closestDistance = Infinity;

      sections.forEach((section) => {
        if (section) {
          const rect = section.getBoundingClientRect();
          const distanceFromTop = Math.abs(rect.top - 50); // Calculate distance from 50px
          if (distanceFromTop < closestDistance) {
            closestDistance = distanceFromTop;
            closestSection = section;
          }
        }
      });

      if (closestSection) {
        const link = Array.from(links).find(
          (link) => link.getAttribute("data-scroll-to") === closestSection.id,
        );

        if (link) {
          // Update the aria-current attribute
          document
            .querySelector('[aria-current="page"]')
            ?.removeAttribute("aria-current");
          link.setAttribute("aria-current", "page");

          // Open the parent <details> if necessary
          const details = link.closest("details");
          if (details && !details.hasAttribute("open")) {
            details.setAttribute("open", "");
            details.dataset.wasAutoOpened = "true"; // Mark as auto-opened
          }

          // Close other auto-opened details elements
          Array.from(document.querySelectorAll("details[data-was-auto-opened]"))
            .filter((d) => d !== details)
            .forEach((d) => {
              d.removeAttribute("open");
              delete d.dataset.wasAutoOpened;
            });
        }
      }
    };
    document.addEventListener("scroll", onScroll, { passive: true });
  });
</script>

<style is:global>
  /* Use full width */
  .sl-container {
    margin-inline: 0 !important;
    max-width: unset !important;
  }
</style>
