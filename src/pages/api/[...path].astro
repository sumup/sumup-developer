---
export const prerender = false;

import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ApiDocs from "@components/ApiDocs/ApiDocs.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";
import {
  getApiTopSection,
  isApiTopLevelPath,
} from "@lib/openapi/routes";
import {
  getTagBySlug,
  getTagEntryBySlug,
  orderedTagEntriesCached,
} from "@lib/openapi/tags";
import type { StarlightUserConfig } from "@astrojs/starlight/types";

// list of resources that are expanded by default
const mainResources = ["Checkouts", "Readers"];

const sidebar: StarlightUserConfig["sidebar"] = [
  {
    label: "SumUp API",
    items: [
      {
        label: "Overview",
        link: "/api",
      },
      {
        label: "SDKs",
        link: "/api/sdks",
        attrs: {
          "data-scroll-to": "sdks",
        },
      },
      {
        label: "Authentication",
        link: "/api/authentication",
        attrs: {
          "data-scroll-to": "authentication",
        },
      },
      {
        label: "Errors",
        link: "/api/errors",
        attrs: {
          "data-scroll-to": "errors",
        },
      },
      ...orderedTagEntriesCached.map(([tagName, operations]) => {
        const tag = getTagBySlug(tagName)!;
        return {
          label: tag.name,
          collapsed: !mainResources.includes(tag.name),
          items: [
            {
              label: "Overview",
              link: `/api/${tagName}`,
            },
            ...operations.map((op) => ({
              label: op.summary!,
              link: `/api/${tagName}/${op.slug}`,
              attrs: {
                "data-scroll-to": `${tagName}-${op.slug}`,
              },
            })),
          ],
        };
      }),
    ],
  },
];

const { path } = Astro.params;
const [segment, section] = (path || "").split("/");
const currentTagEntry = segment ? getTagEntryBySlug(segment) : undefined;
const isTopLevelPage = !segment || isApiTopLevelPath(segment);
const topSection = getApiTopSection(segment);

const currentTag = segment ? getTagBySlug(segment) : undefined;
const currentOperation =
  currentTagEntry && section
    ? currentTagEntry.find((operation) => operation.slug === section)
    : undefined;

const props = {
  frontmatter: {
    title: currentTag?.name || "API Reference",
    metaTitle: currentOperation?.summary || currentTag?.name || "API Reference",
    description: "SumUp API reference and code samples.",
    tableOfContents: false,
  },
  sidebar,
  custom: true,
} as StarlightPageProps;

const canonicalPath = path ? `/api/${path}` : "/api";
---

<link
  slot="head"
  rel="canonical"
  href={`https://developer.sumup.com${canonicalPath}`}
/>
<StarlightPage {...props}>
  <ApiDocs
    tagSlug={isTopLevelPage ? undefined : segment}
    operationSlug={isTopLevelPage ? undefined : section}
    topSection={topSection}
  />
</StarlightPage>

<script>
  import { initApiSidebarNavigation } from "@lib/openapi/sidebar-nav";

  initApiSidebarNavigation();
  document.addEventListener("astro:page-load", initApiSidebarNavigation);
</script>

<style is:global>
  /* Wider content */
  .sl-container {
    max-width: 80rem !important;
  }
</style>
