---
import { getCollection, render } from "astro:content";
import StandaloneLayout from "../layouts/StandaloneLayout.astro";

const posts = await getCollection("_help");
---

<StandaloneLayout title="FAQ" description="Frequently asked questions" prose>
  <div>
    {
      posts.map(async (post) => {
        const { Content } = await render(post);
        return (
          <details>
            <summary>{post.data.title}</summary>
            <div class="content">
              <Content />
            </div>
          </details>
        );
      })
    }
    <p data-pagefind-ignore>
      Didn't find answer to your question? <a href="/contact">Contact us</a>.
    </p>
  </div>
</StandaloneLayout>

<style lang="scss">
  p {
    margin: var(--cui-spacings-exa) 0 var(--cui-spacings-exa);
    text-align: center;
  }
</style>
