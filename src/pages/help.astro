---
import { getCollection, render } from "astro:content";
import MarkdownContent from "@components/MarkdownContent.astro";
import StandaloneLayout from "../layouts/StandaloneLayout.astro";
import { components } from "../components";

const posts = await getCollection("_help");
---

<StandaloneLayout title="FAQ" description="Frequently asked questions" prose>
  <div>
    {posts.map(async (post) => {
      const { Content } = await render(post);
      return (
        <details>
          <summary>{post.data.title}</summary>
          <div class="content">
            <MarkdownContent>
              <Content components={components} />
            </MarkdownContent>
          </div>
        </details>
      );
    })}
    <p data-pagefind-ignore>
      Didn't find answer to your question?{" "}
      <a href="https://www.sumup.com/contact/">Contact us</a>.
    </p>
  </div>
</StandaloneLayout>

<style>
  p {
    margin: var(--cui-spacings-exa) 0 var(--cui-spacings-exa);
    text-align: center;
  }
</style>
