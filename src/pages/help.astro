---
import type { StarlightPageProps } from "@astrojs/starlight/props";
import MarkdownContent from "@components/MarkdownContent.astro";
import { getCollection, render } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const props = {
  frontmatter: {
    title: "FAQ",
    description: "Frequently asked questions",
    template: "splash",
  },
} as StarlightPageProps;

const posts = await getCollection("help");
---

<StarlightPage {...props}>
  <div>
    {
      posts.map(async (post) => {
        const { Content } = await render(post);
        return (
          <details>
            <summary>{post.data.title}</summary>
            <div class="content">
              <MarkdownContent>
                <Content />
              </MarkdownContent>
            </div>
          </details>
        );
      })
    }
    <p data-pagefind-ignore>
      Didn't find answer to your question? <a href="/contact">Contact us</a>.
    </p>
  </div>
</StarlightPage>

<style lang="scss">
  p {
    margin: var(--cui-spacings-exa) 0 var(--cui-spacings-exa);
    text-align: center;
  }
</style>
