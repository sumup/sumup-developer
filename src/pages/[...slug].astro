---
import {
  getBreadcrumbs,
  getDocsPageProps,
  getDocsStaticPaths,
  getEditUrl,
  getLastUpdated,
  getRouteFlags,
  getSidebar,
  getTOC,
} from "@cloudflare/nimbus-docs";

import { components } from "../components";
import DocsLayout from "../layouts/DocsLayout.astro";
import { addDocsHome } from "../utils/docsSidebar";

export const prerender = true;
export const getStaticPaths = getDocsStaticPaths;

const { entry, Content, headings } = await getDocsPageProps(Astro);
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const { sidebar: sidebarEnabled, tableOfContents: tocEnabled } =
  await getRouteFlags(entry);
const sidebar = sidebarEnabled
  ? await getSidebar(currentPath, {
      collection: entry.collection,
      transform: ({ tree }) => addDocsHome(tree, currentPath),
    })
  : false;
const breadcrumbs = await getBreadcrumbs(currentPath, {
  collection: entry.collection,
});
const editUrl = await getEditUrl(entry);
const lastUpdated = entry.data.lastUpdated ?? (await getLastUpdated(entry));
const tocConfig = entry.data.tableOfContents;
const toc =
  tocEnabled && tocConfig !== false ? getTOC(headings, tocConfig) : false;
const markdownPath = `/${entry.id}/index.md`;
const markdownUrl = Astro.site
  ? new URL(markdownPath, Astro.site).href
  : markdownPath;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={{}}
  head={entry.data.head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={entry.data.socialImage ?? `/og/${entry.id}.png`}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  collection={entry.collection}
  entryId={entry.id}
  links={entry.data.links}
>
  <Content components={components} />
</DocsLayout>
