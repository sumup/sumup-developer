---
export const prerender = true;

import ContactForm from "@components/ContactForm";
import StandaloneLayout from "../layouts/StandaloneLayout.astro";
---

<StandaloneLayout
  title="Contact"
  description="Reach out to SumUp's developer experts"
>
  <div class="contact-form">
    <ContactForm client:load />
  </div>
</StandaloneLayout>

<style>
  .headline {
    text-align: center;
    margin: 0 auto var(--cui-spacings-giga);
  }

  div {
    margin-bottom: var(--cui-spacings-zetta);
  }

  .contact-form :global(form > *) {
    margin-bottom: var(--cui-spacings-giga);
  }
</style>
