---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";
import Brands from "@components/Landing/Brands.astro";
import { Headline, ListItem } from "@sumup-oss/circuit-ui";
import {
  InterestOnBalance,
  NoCosts,
  SecurePayments,
  CardReaderSolo,
  Code,
  BrowserSecure,
  Customize,
  CardIn,
  AlternativePaymentMethod,
  Sparkles,
  File,
  Apps,
  Key,
  Play,
} from "@sumup-oss/icons";

const props = {
  frontmatter: {
    title: "SumUp Developer Portal",
    description:
      "Welcome to SumUp portal for developers. We’ve got everything you need to build your own payment acceptance solutions for your business.",
    tableOfContents: false,
    template: "splash",
    hero: {
      title: "SumUp developer platform",
    },
  },
  hasSidebar: true,
} as StarlightPageProps;
---

<StarlightPage {...props}>
  <main class="not-content">
    <section>
      <section>
        <Headline as="h2" className="header">Card-present Solutions</Headline>
        <div class="button-links">
          <ListItem
            href="/terminal-payments"
            variant="navigation"
            label="Quickstart"
            details="Integrate with SumUp Solo card reader to accept in-person payments."
            leadingComponent={CardReaderSolo}
          />
          <ListItem
            variant="navigation"
            leadingComponent={Code}
            href="/terminal-payments/sdks"
            label="Integrations"
            details="Build integrations for your customers."
          />
          <ListItem
            variant="navigation"
            leadingComponent={BrowserSecure}
            href="/terminal-payments/cloud-api"
            label="Cloud API"
            details="Integrate card payments from any platform using Cloud API."
          />
        </div>
      </section>
      <section>
        <Headline as="h2" className="header">Online Payment Solutions</Headline>
        <div class="button-links">
          <ListItem
            variant="navigation"
            leadingComponent={Play}
            href="/online-payments/"
            label="Quickstart"
            details="Start using Online Payments"
          />
          <ListItem
            variant="navigation"
            leadingComponent={CardIn}
            href="/online-payments/checkouts/card-widget"
            label="Card widget"
            details="Collect payment data online securely with card widget."
          />
          <ListItem
            variant="navigation"
            leadingComponent={AlternativePaymentMethod}
            href="/online-payments/apm"
            label="Alternative payment options"
            details="Allow your customers to pay with Apple or Google pay."
          />
          <ListItem
            variant="navigation"
            leadingComponent={Apps}
            href="/online-payments/sdks"
            label="Integrations"
            details="Build integrations for your customers."
          />
          <ListItem
            variant="navigation"
            leadingComponent={Customize}
            href="/online-payments/guides/"
            label="Customization"
            details="Build a fully customized payment experience"
          />
        </div>
      </section>
      <section>
        <Headline as="h2" className="header">Common Topics</Headline>
        <div class="button-links">
          <ListItem
            variant="navigation"
            href="/tools/authorization/"
            leadingComponent={Key}
            label="Authorization"
            details="Learn how to authorize requests."
          />
          <ListItem
            variant="navigation"
            href="/tools/llms"
            leadingComponent={Sparkles}
            label="Building with AI"
            details="Use LLM assistance when building SumUp integrations."
          />
          <ListItem
            variant="navigation"
            href="/api"
            leadingComponent={File}
            label="API Reference"
            details="Check API documentation."
          />
        </div>
      </section>
    </section>
    <section class="antifraud">
      <div class="content">
        <h2>Our Anti-fraud Protection</h2>
        <div class="callouts">
          <div>
            <SecurePayments aria-hidden="true" className="icon" />
            <p>
              We’re committed to protecting you from fraud, chargebacks and
              headaches
            </p>
          </div>
          <div>
            <InterestOnBalance aria-hidden="true" className="icon" />
            <p>
              We use advanced artificial intelligence to constantly monitor
              transactions for unusual activity
            </p>
          </div>
          <div>
            <NoCosts aria-hidden="true" className="icon" />
            <p>
              All of our anti-fraud protection is included at no additional cost
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="brands">
      <h2>Brands That Build With SumUp</h2>
      <Brands />
    </section>
  </main>
</StarlightPage>

<style>
  :root {
    --sl-content-width: 68rem !important;
  }
</style>

<style lang="scss">
  ul {
    list-style-type: none;
    padding-left: 0;
    margin-top: var(--cui-spacings-mega);

    li {
      margin-bottom: 10px;
    }
  }

  section {
    margin: var(--cui-spacings-exa) 0;

    a {
      color: var(--cui-fg-accent);

      &:hover {
        text-decoration: underline;
      }
    }

    @media screen and (min-width: 941px) {
      &:nth-child(even) {
        .image {
          grid-area: right;
        }

        .text {
          grid-area: left;
        }
      }
    }
  }

  h3 {
    margin-bottom: var(--cui-spacings-giga);
  }

  section :global(h2) {
    margin-bottom: var(--cui-spacings-giga) !important;
  }

  .icon {
    width: 48px;
    height: 48px;
    margin-bottom: var(--cui-spacings-mega);
  }

  .callouts {
    margin: var(--cui-spacings-zetta) 0;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-gap: var(--cui-spacings-giga);

    & > div {
      margin-bottom: var(--cui-spacings-mega);
    }

    @media screen and (max-width: 940px) {
      grid-template-columns: 1fr;
    }
  }

  .antifraud img {
    width: 56px;
    margin-bottom: var(--cui-spacings-kilo);
  }

  .antifraud .callouts {
    text-align: center;
  }

  .links {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-gap: var(--cui-spacings-giga);
    ul {
      li {
        margin-bottom: var(--cui-spacings-bit);
      }
    }
    & > div {
      margin-bottom: var(--cui-spacings-giga);
    }
    @media screen and (max-width: 940px) {
      grid-template-columns: 1fr 1fr;
    }
    @media screen and (max-width: 600px) {
      grid-template-columns: 1fr;
    }
  }

  .brands {
    overflow: hidden;
    padding: var(--cui-spacings-zetta) 0;
  }

  .card-grid {
    display: grid;
    gap: 1rem;

    & > :global(*) {
      margin-top: 0 !important;
    }

    @media (min-width: 50rem) {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .button-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--cui-spacings-kilo);
  }

  @media (max-width: 1279px) {
    .button-links {
      grid-template-columns: 1fr;
    }
  }
</style>
