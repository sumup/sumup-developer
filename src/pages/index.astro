---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";
import Card from "@components/Card.astro";
import Brands from "@components/Landing/Brands.astro";
import TryItOut from "@components/TryItOut.astro";
import { Headline, Body, ButtonGroup } from "@sumup-oss/circuit-ui";
import SwiftCheckout from "../assets/swift-checkout.svg?raw";
import ApiCall from "../assets/api-call.svg?raw";
import {
  InterestOnBalance,
  NoCosts,
  SecurePayments,
  Key,
} from "@sumup-oss/icons";
import CardLink from "@components/CardLink.astro";
import CardStack from "@components/CardStack.astro";

const props = {
  frontmatter: {
    title: "SumUp developer platform",
    description:
      "Welcome to SumUp portal for Developers. We’ve got everything you need to build your own payment acceptance solutions for your business.",
    tableOfContents: false,
    hero: {
      title: "SumUp developer platform",
    },
  },
  custom: true,
} as StarlightPageProps;
---

<StarlightPage {...props}>
  <main>
    <div class="cta">
      <Headline as="h2" size="s"><Key /> Get your API key</Headline>
      <Body>
        Create a merchant account to access API keys and a suite of developer
        tools.
      </Body>
      <ButtonGroup
        align="left"
        actions={{
          primary: {
            children: "Sign Up",
            size: "s",
            href: "https://me.sumup.com/signup?intent=developer",
          },
          secondary: {
            children: "Login",
            size: "s",
            href: "https://me.sumup.com/settings-v2/api-keys",
          },
        }}
      />
    </div>
    <section>
      <div class="card-grid">
        <Card title="Online Payments" icon="online_payments">
          <ul>
            <li>
              <a href="/online-payments">Overview</a>
            </li>
            <li>
              <a href="/online-payments/guides">Guides</a>
            </li>
            <li>
              <a href="/online-payments/plugins">Plugins</a>
            </li>
            <li>
              <a href="/online-payments/tools">Tools</a>
            </li>
          </ul>
        </Card>
        <Card title="Terminal Payments" icon="card_in">
          <ul>
            <li>
              <a href="/terminal-payments">Overview</a>
            </li>
            <li>
              <a href="/online-payments/guides">Guides</a>
            </li>
            <li>
              <a href="/terminal-payments/tools">Tools</a>
            </li>
          </ul>
        </Card>
        <Card title="Tooling" icon="apps">
          <ul>
            <li>
              <a href="/api">API reference</a>
            </li>
            <li>
              <a href="/changelog">Changelog</a>
            </li>
            <li>
              <a href="/online-payments/tools/introduction">Tools</a>
            </li>
          </ul>
        </Card>
      </div>
    </section>
    <section>
      <TryItOut />
    </section>
    <section>
      <Headline as="h2" className="header">Start building</Headline>
      <CardStack>
        <CardLink
          href="/online-payments/tools/swift-checkout/"
          title="Swift checkout"
          description="Collect payment, address, and contact information with the click of a button."
          image={SwiftCheckout}
        />
        <CardLink
          href="/terminal-payments/tools/cloud-api/"
          title="Card reader payments"
          description="Integrate card payments from any platform using Cloud API."
          image={ApiCall}
        />
        <CardLink
          href="/online-payments/tools/card-widget/"
          title="Payment widget"
          description="Securely collect and process customers payment information."
          image={SwiftCheckout}
        />
        <CardLink
          href="/online-payments/plugins"
          title="Plugins"
          description="Use SumUp plugin for Prestashop, Wix, or WooCommerce."
          image={ApiCall}
        />
        <CardLink
          href="/online-payments/plugins"
          title="Mobile app integration"
          description="Accept card reader payments from your own app using SumUp card readers."
          image={SwiftCheckout}
        />
        <CardLink
          href="/online-payments/plugins"
          title="SDKs"
          description="Use your favorite programming language with one of our SDKs."
          image={ApiCall}
        />
      </CardStack>
    </section>
    <section class="antifraud">
      <div class="content">
        <h2>Our anti-fraud protection</h2>
        <div class="callouts">
          <div>
            <SecurePayments aria-hidden="true" className="icon" />
            <p>
              We’re committed to protecting you from fraud, chargebacks and
              headaches
            </p>
          </div>
          <div>
            <InterestOnBalance aria-hidden="true" className="icon" />
            <p>
              We use advanced artificial intelligence to constantly monitor
              transactions for unusual activity
            </p>
          </div>
          <div>
            <NoCosts aria-hidden="true" className="icon" />
            <p>
              All of our anti-fraud protection is included at no additional cost
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="brands">
      <h2>Brands that build with SumUp</h2>
      <Brands />
    </section>
    <section>
      <div class="content links">
        <div>
          <h3>Online Payments guides</h3>
          <ul>
            <li>
              <a href="/online-payments/guides/single-payment">
                Accept a card payment</a
              >
            </li>
            <li>
              <a href="/online-payments/guides/recurring-payments">
                Create a recurring payment</a
              >
            </li>
            <li>
              <a href="/online-payments/guides/refund"> Make a refund</a>
            </li>
          </ul>
        </div>
        <div>
          <h3>SumUp plugins</h3>
          <ul>
            <li>
              <a href="/online-payments/plugins/wix">
                Accept payments with WIX</a
              >
            </li>
            <li>
              <a href="/online-payments/plugins/woocommerce">
                Accept payments with WooCommerce</a
              >
            </li>
            <li>
              <a href="/online-payments/plugins/prestashop">
                Accept payments with PrestaShop</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h3>Card Reader payments tools</h3>
          <ul>
            <li>
              <a href="/terminal-payments/tools/api"> API Payment Switch</a>
            </li>
            <li>
              <a href="/terminal-payments/tools/sdk"> Native SDK</a>
            </li>
          </ul>
        </div>
        <div>
          <h3>Supported industries for Card Reader payments</h3>
          <ul>
            <li>
              <a href="/terminal-payments/industry/bookings"> Bookings</a>
            </li>
            <li>
              <a href="/terminal-payments/industry/enterprise">
                Enterprise Solutions</a
              >
            </li>
            <li>
              <a href="/terminal-payments/industry/hospitality"> Hospitality</a>
            </li>
            <li>
              <a href="/terminal-payments/industry/transport">
                Transport Pickup and Delivery</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h3>Other payment solutions</h3>
          <ul>
            <li>
              <a href="/online-payments/apm"> Alternative Payment Methods</a>
            </li>
            <li>
              <a href="/online-payments/apm/apple-pay">
                Apple Pay Integration Guide</a
              >
            </li>
            <li>
              <a href="/online-payments/apm/google-pay">
                Google Pay Integration Guide</a
              >
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</StarlightPage>

<style lang="scss">
  ul {
    list-style-type: none;
    padding-left: 0;
    margin-top: var(--cui-spacings-mega);

    li {
      margin-bottom: 10px;
    }
  }

  section {
    margin-top: var(--cui-spacings-exa);

    :global(.header) {
      margin-bottom: var(--cui-spacings-giga);
    }

    a {
      color: var(--cui-fg-accent);

      &:hover {
        text-decoration: underline;
      }
    }

    @media screen and (min-width: 941px) {
      &:nth-child(even) {
        .image {
          grid-area: right;
        }

        .text {
          grid-area: left;
        }
      }
    }
  }

  h3 {
    margin-bottom: var(--cui-spacings-giga);
  }

  h2 {
    margin-bottom: var(--cui-spacings-exa);
  }

  .icon {
    width: 48px;
    height: 48px;
    margin-bottom: var(--cui-spacings-mega);
  }

  .callouts {
    margin: var(--cui-spacings-zetta) 0;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-gap: var(--cui-spacings-giga);

    & > div {
      margin-bottom: var(--cui-spacings-mega);
    }

    @media screen and (max-width: 940px) {
      grid-template-columns: 1fr;
    }
  }

  .antifraud {
    text-align: center;

    img {
      width: 56px;
      margin-bottom: var(--cui-spacings-kilo);
    }
  }

  .links {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-gap: var(--cui-spacings-giga);
    ul {
      li {
        margin-bottom: var(--cui-spacings-bit);
      }
    }
    & > div {
      margin-bottom: var(--cui-spacings-giga);
    }
    @media screen and (max-width: 940px) {
      grid-template-columns: 1fr 1fr;
    }
    @media screen and (max-width: 600px) {
      grid-template-columns: 1fr;
    }
  }

  .brands {
    overflow: hidden;
    padding: var(--cui-spacings-zetta) 0;
  }

  .card-grid {
    display: grid;
    gap: 1rem;

    & > :global(*) {
      margin-top: 0 !important;
    }

    @media (min-width: 50rem) {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .cta {
    padding: var(--cui-spacings-giga);
    background-color: var(--cui-bg-subtle);
    border-radius: var(--cui-border-radius-byte);
  }

  .cta > :global(*:not(:last-child)) {
    margin-bottom: var(--cui-spacings-kilo);
  }

  .cta :global(h2) {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--cui-spacings-byte);
  }
</style>
