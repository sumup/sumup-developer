---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";
import Card from "@components/Card.astro";
import Brands from "@components/Landing/Brands.astro";
import { Headline, ListItem } from "@sumup-oss/circuit-ui";
import {
  InterestOnBalance,
  NoCosts,
  SecurePayments,
  CardReaderSolo,
  OnlinePayments,
  Code,
  BrowserSecure,
  Refresh,
  Refunded,
  CardIn,
  AlternativePaymentMethod,
} from "@sumup-oss/icons";
import CardLink from "@components/CardLink.astro";
import CardStack from "@components/CardStack.astro";

const props = {
  frontmatter: {
    title: "SumUp Developer Portal",
    description:
      "Welcome to SumUp portal for developers. We’ve got everything you need to build your own payment acceptance solutions for your business.",
    tableOfContents: false,
    hero: {
      title: "SumUp developer platform",
    },
  },
  custom: true,
} as StarlightPageProps;
---

<StarlightPage {...props}>
  <main>
    <section>
      <Headline as="h2" className="header">Discover our Solutions</Headline>
      <div class="button-links">
        <ListItem
          href="/terminal-payments"
          variant="navigation"
          label="Accept card reader payments"
          details="Integrate with SumUp Solo card reader to accept in-person payments."
          leadingComponent={CardReaderSolo}
        />
        <ListItem
          variant="navigation"
          leadingComponent={OnlinePayments}
          href="/online-payments"
          label="Accept online payments"
          details="Integrate SumUp in your Online Store."
        />
        <ListItem
          variant="navigation"
          leadingComponent={Code}
          href="/terminal-payments/sdks"
          label="Integrations"
          details="Build integrations for your customers"
        />
        <ListItem
          variant="navigation"
          leadingComponent={BrowserSecure}
          href="/tools/authorization/authorization"
          label="Authorization"
          details="Explore authorization and authentication options for your use case."
        />
        <ListItem
          variant="navigation"
          leadingComponent={Refresh}
          href="/online-payments/guides/recurring-payments"
          label="Recurring payments"
          details="Provide smooth user experience for recurring payments."
        />
        <ListItem
          variant="navigation"
          leadingComponent={Refunded}
          href="/online-payments/guides/refund"
          label="Refunds"
          details="Provide smooth user experience for refunds."
        />
        <ListItem
          variant="navigation"
          leadingComponent={AlternativePaymentMethod}
          href="/online-payments/apm"
          label="Alternative payment options"
          details="Allow your customers to pay with Apple or Google pay."
        />
        <ListItem
          variant="navigation"
          leadingComponent={CardIn}
          href="/online-payments/checkouts/card-widget"
          label="Card widget"
          details="Collect payment data online securely with card widget."
        />
      </div>
    </section>
    <section>
      <div class="card-grid">
        <Card title="Online Payments" icon="online_payments">
          <ul>
            <li>
              <a href="/online-payments/">Overview</a>
            </li>
            <li>
              <a href="/online-payments/guides/">Guides</a>
            </li>
            <li>
              <a href="/online-payments/plugins/">Plugins</a>
            </li>
            <li>
              <a href="/tools/">Common Topics</a>
            </li>
          </ul>
        </Card>
        <Card title="Terminal Payments" icon="card_in">
          <ul>
            <li>
              <a href="/terminal-payments/">Overview</a>
            </li>
            <li>
              <a href="/online-payments/guides/">Guides</a>
            </li>
            <li>
              <a href="/tools/">Common Topics</a>
            </li>
          </ul>
        </Card>
        <Card title="Tooling" icon="apps">
          <ul>
            <li>
              <a href="/tools/authorization/authorization">Authorization</a>
            </li>
            <li>
              <a href="/api">API reference</a>
            </li>
            <li>
              <a href="/tools">Common Topics</a>
            </li>
          </ul>
        </Card>
      </div>
    </section>
    <section>
      <Headline as="h2" className="header">Building blocks</Headline>
      <CardStack>
        <CardLink
          href="/online-payments/checkouts/swift-checkout/"
          title="Swift checkout"
          description="Collect payment, address, and contact information with the click of a button."
          image="/img/swift-checkout.svg"
        />
        <CardLink
          href="/terminal-payments/cloud-api/"
          title="Card reader payments"
          description="Integrate card payments from any platform using Cloud API."
          image="/img/api-call.svg"
        />
        <CardLink
          href="/online-payments/checkouts/card-widget/"
          title="Payment widget"
          description="Securely collect and process customers payment information."
          image="/img/swift-checkout.svg"
        />
        <CardLink
          href="/online-payments/plugins/"
          title="Plugins"
          description="Use SumUp plugin for Prestashop, Wix, or WooCommerce."
          image="/img/api-call.svg"
        />
        <CardLink
          href="/terminal-payments/sdks/"
          title="Mobile app integration"
          description="Accept card reader payments from your own app using SumUp card readers."
          image="/img/swift-checkout.svg"
        />
        <CardLink
          href="/terminal-payments/sdks/"
          title="SDKs"
          description="Use your favorite programming language with one of our SDKs."
          image="/img/api-call.svg"
        />
      </CardStack>
    </section>
    <section class="antifraud">
      <div class="content">
        <h2>Our anti-fraud protection</h2>
        <div class="callouts">
          <div>
            <SecurePayments aria-hidden="true" className="icon" />
            <p>
              We’re committed to protecting you from fraud, chargebacks and
              headaches
            </p>
          </div>
          <div>
            <InterestOnBalance aria-hidden="true" className="icon" />
            <p>
              We use advanced artificial intelligence to constantly monitor
              transactions for unusual activity
            </p>
          </div>
          <div>
            <NoCosts aria-hidden="true" className="icon" />
            <p>
              All of our anti-fraud protection is included at no additional cost
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="brands">
      <h2>Brands that build with SumUp</h2>
      <Brands />
    </section>
  </main>
</StarlightPage>

<style>
  :root {
    --sl-content-width: 68rem !important;
  }
</style>

<style lang="scss">
  ul {
    list-style-type: none;
    padding-left: 0;
    margin-top: var(--cui-spacings-mega);

    li {
      margin-bottom: 10px;
    }
  }

  section {
    margin: var(--cui-spacings-exa) 0;

    a {
      color: var(--cui-fg-accent);

      &:hover {
        text-decoration: underline;
      }
    }

    @media screen and (min-width: 941px) {
      &:nth-child(even) {
        .image {
          grid-area: right;
        }

        .text {
          grid-area: left;
        }
      }
    }
  }

  h3 {
    margin-bottom: var(--cui-spacings-giga);
  }

  section :global(h2) {
    margin-bottom: var(--cui-spacings-giga) !important;
  }

  .icon {
    width: 48px;
    height: 48px;
    margin-bottom: var(--cui-spacings-mega);
  }

  .callouts {
    margin: var(--cui-spacings-zetta) 0;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-gap: var(--cui-spacings-giga);

    & > div {
      margin-bottom: var(--cui-spacings-mega);
    }

    @media screen and (max-width: 940px) {
      grid-template-columns: 1fr;
    }
  }

  .antifraud img {
    width: 56px;
    margin-bottom: var(--cui-spacings-kilo);
  }

  .antifraud .callouts {
    text-align: center;
  }

  .links {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-gap: var(--cui-spacings-giga);
    ul {
      li {
        margin-bottom: var(--cui-spacings-bit);
      }
    }
    & > div {
      margin-bottom: var(--cui-spacings-giga);
    }
    @media screen and (max-width: 940px) {
      grid-template-columns: 1fr 1fr;
    }
    @media screen and (max-width: 600px) {
      grid-template-columns: 1fr;
    }
  }

  .brands {
    overflow: hidden;
    padding: var(--cui-spacings-zetta) 0;
  }

  .card-grid {
    display: grid;
    gap: 1rem;

    & > :global(*) {
      margin-top: 0 !important;
    }

    @media (min-width: 50rem) {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .button-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--cui-spacings-kilo);
  }

  @media (max-width: 1279px) {
    .button-links {
      grid-template-columns: 1fr;
    }
  }
</style>
