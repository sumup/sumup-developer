---
import { getSidebar } from "@cloudflare/nimbus-docs/runtime";
import DocsLayout from "../layouts/DocsLayout.astro";
import { addDocsHome } from "../utils/docsSidebar";
import Brands from "@components/Landing/Brands.astro";
import Button from "@components/Button";
import GetStarted from "@components/Landing/GetStarted.astro";
import PaymentScenes from "@components/Landing/PaymentScenes.astro";
import { Body, Display, Headline } from "@sumup-oss/circuit-ui";
import { InterestOnBalance, NoCosts, SecurePayments } from "@sumup-oss/icons";

const sidebar = await getSidebar("/", {
  collection: "docs",
  transform: ({ tree }) => addDocsHome(tree, "/"),
});
---

<DocsLayout
  title="SumUp Developer Portal"
  description="Start building with SumUp APIs and SDKs. Choose an integration, create a sandbox, and make your first online or in-person payment."
  sidebar={sidebar}
  headings={false}
  breadcrumbs={[]}
  prevNext={{}}
  socialImage="/og/index.png"
  markdownUrl="/index.md"
  hideTitle
  prose={false}
  wide
>
  <div class="homepage">
    <header class="hero">
      <div class="hero-copy">
        <Display
          as="h1"
          size="m"
          weight="black"
          id="_top"
          className="title"
          data-pagefind-meta="title"
        >
          Build payments with SumUp
        </Display>
        <Body size="l" color="subtle" className="subtitle">
          APIs, SDKs, and guides for accepting payments online and in person.
          Choose your integration and start building in a sandbox.
        </Body>
        <div class="hero-actions">
          <Button
            href="#start-building"
            variant="primary"
            label="Start building"
          />
          <Button href="/api/" variant="secondary" label="Explore the API" />
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <img
          class="hero-sky"
          src="/img/landing/sumup-sky-v01.webp"
          alt=""
          width="960"
          height="640"
          fetchpriority="high"
          decoding="async"
        />
        <PaymentScenes />
      </div>
    </header>
    <GetStarted />
    <section class="antifraud">
      <div class="content">
        <Headline as="h2" size="m">
          Our Anti-fraud Protection
        </Headline>
        <div class="callouts">
          <div>
            <SecurePayments aria-hidden="true" className="icon" />
            <Body>
              We’re committed to protecting you from fraud, chargebacks and
              headaches
            </Body>
          </div>
          <div>
            <InterestOnBalance aria-hidden="true" className="icon" />
            <Body>
              We use advanced artificial intelligence to constantly monitor
              transactions for unusual activity
            </Body>
          </div>
          <div>
            <NoCosts aria-hidden="true" className="icon" />
            <Body>
              All of our anti-fraud protection is included at no additional cost
            </Body>
          </div>
        </div>
      </div>
    </section>
    <section class="brands">
      <Headline as="h2" size="m">
        Brands That Build With SumUp
      </Headline>
      <Brands />
    </section>
  </div>
</DocsLayout>

<style>
  .homepage {
    container-type: inline-size;
    max-width: 68rem;
    margin: 0 auto;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: var(--cui-spacings-giga);
    margin: var(--cui-spacings-giga) 0 var(--cui-spacings-exa);
    text-align: left;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-visual {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 28rem;
    aspect-ratio: 1;
    padding: clamp(1rem, 2.5vw, 2rem);
    justify-self: end;
    overflow: hidden;
    border-radius: var(--cui-border-radius-mega);
  }

  .hero-sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-actions {
    display: flex;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: var(--cui-spacings-kilo);
    margin-top: var(--cui-spacings-giga);
  }

  .hero :global(.subtitle) {
    margin-top: var(--cui-spacings-kilo);
  }

  @container (max-width: 48rem) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      justify-self: start;
    }
  }

  @media (max-width: 61.25rem) {
    .hero :global(.title) {
      font-size: var(--cui-headline-l-font-size);
      line-height: var(--cui-headline-l-line-height);
    }
    .hero :global(.subtitle) {
      font-size: var(--cui-body-m-font-size);
      line-height: var(--cui-body-m-line-height);
    }
  }
</style>

<style lang="scss">
  ul {
    list-style-type: none;
    padding-left: 0;
    margin-top: var(--cui-spacings-mega);

    li {
      margin-bottom: 10px;
    }
  }

  section {
    margin: var(--cui-spacings-exa) 0;

    @media screen and (min-width: 941px) {
      &:nth-child(even) {
        .image {
          grid-area: right;
        }

        .text {
          grid-area: left;
        }
      }
    }
  }

  h3 {
    margin-bottom: var(--cui-spacings-giga);
  }

  section :global(h2) {
    margin-bottom: var(--cui-spacings-giga) !important;
  }

  .icon {
    width: 48px;
    height: 48px;
    margin-bottom: var(--cui-spacings-mega);
  }

  .callouts {
    margin: var(--cui-spacings-zetta) 0;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-gap: var(--cui-spacings-giga);

    & > div {
      margin-bottom: var(--cui-spacings-mega);
    }

    @media screen and (max-width: 940px) {
      grid-template-columns: 1fr;
    }
  }

  .antifraud img {
    width: 56px;
    margin-bottom: var(--cui-spacings-kilo);
  }

  .antifraud .callouts {
    text-align: center;
  }

  .brands {
    overflow: hidden;
    padding: var(--cui-spacings-zetta) 0;
  }
</style>
