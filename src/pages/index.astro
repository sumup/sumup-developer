---
import { getSidebar } from "@cloudflare/nimbus-docs/runtime";
import DocsLayout from "../layouts/DocsLayout.astro";
import { addDocsHome } from "../utils/docsSidebar";
import Button from "@components/Button";
import CopyPrompt from "@components/nimbus/CopyPrompt.astro";
import ApiExamples from "@components/Landing/ApiExamples.astro";
import Products from "@components/Landing/Products.astro";
import Platform from "@components/Landing/Platform.astro";
import PaymentScenes from "@components/Landing/PaymentScenes.astro";
import { Body, Display } from "@sumup-oss/circuit-ui";

const sidebar = await getSidebar("/", {
  collection: "docs",
  transform: ({ tree }) => addDocsHome(tree, "/"),
});
---

<DocsLayout
  title="SumUp Developer Portal"
  description="Start building with SumUp APIs and SDKs. Choose an integration, create a sandbox, and make your first online or in-person payment."
  sidebar={sidebar}
  headings={false}
  breadcrumbs={[]}
  prevNext={{}}
  socialImage="/og/index.png"
  markdownUrl="/index.md"
  hideTitle
  prose={false}
  wide
>
  <div class="homepage">
    <header class="hero">
      <div class="hero-copy">
        <Display
          as="h1"
          size="m"
          weight="black"
          id="_top"
          className="title"
          data-pagefind-meta="title"
        >
          Build payments with SumUp
        </Display>
        <Body size="l" color="subtle" className="subtitle">
          APIs, SDKs, and guides for accepting payments online and in person.
          Choose your integration and start building in a sandbox.
        </Body>
        <div class="hero-actions" id="build-with-ai">
          <Button
            href="/get-started/"
            variant="primary"
            label="Start building"
          />
          <CopyPrompt compact />
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <PaymentScenes />
      </div>
    </header>
    <ApiExamples />
    <Products />
    <Platform />
  </div>
</DocsLayout>

<style>
  .homepage {
    container-type: inline-size;
    max-width: 68rem;
    margin: 0 auto;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: var(--cui-spacings-giga);
    margin: var(--cui-spacings-giga) 0 var(--cui-spacings-exa);
    text-align: left;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-visual {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 28rem;
    justify-self: end;
  }

  .hero-actions {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: var(--cui-spacings-kilo);
    margin-top: var(--cui-spacings-giga);
    scroll-margin-top: calc(var(--portal-header-height) + 1.5rem);
  }

  .hero-actions :global(.copy-prompt) {
    min-width: 0;
    max-width: 100%;
  }

  .hero :global(.subtitle) {
    margin-top: var(--cui-spacings-kilo);
  }

  @container (max-width: 48rem) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      justify-self: start;
    }
  }

  @media (max-width: 61.25rem) {
    .hero :global(.title) {
      font-size: var(--cui-headline-l-font-size);
      line-height: var(--cui-headline-l-line-height);
    }
    .hero :global(.subtitle) {
      font-size: var(--cui-body-m-font-size);
      line-height: var(--cui-body-m-line-height);
    }
  }
</style>
