---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";
import Card from "@components/Card.astro";
import Brands from "@components/Landing/Brands.astro";
import TryItOut from "@components/TryItOut/TryItOut.astro";
import { Headline, Body, ButtonGroup } from "@sumup-oss/circuit-ui";
import {
  AlternativePaymentMethod,
  InterestOnBalance,
  Refunded,
  Refresh,
  ArrowRight,
  NoCosts,
  SecurePayments,
  CardIn,
  Key,
  MobilePhone,
  CardReaderSolo,
  BrowserSecure,
} from "@sumup-oss/icons";
import CardLink from "@components/CardLink.astro";
import CardStack from "@components/CardStack.astro";

const props = {
  frontmatter: {
    title: "SumUp developer platform",
    description:
      "Welcome to SumUp portal for Developers. We’ve got everything you need to build your own payment acceptance solutions for your business.",
    tableOfContents: false,
    template: "splash",
    hero: {
      title: "SumUp developer platform",
    },
  },
  custom: true,
} as StarlightPageProps;
---

<StarlightPage {...props}>
  <main>
    <div class="cta">
      <Headline as="h2" size="s"><Key /> Get your API key</Headline>
      <Body>
        Create a merchant account to access API keys and a suite of developer
        tools.
      </Body>
      <ButtonGroup
        align="left"
        actions={{
          primary: {
            children: "Sign Up",
            size: "s",
            href: "https://me.sumup.com/signup?intent=developer",
          },
          secondary: {
            children: "Login",
            size: "s",
            href: "https://me.sumup.com/settings-v2/api-keys",
          },
        }}
      />
    </div>
    <section>
      <div class="card-grid">
        <Card title="Online Payments" icon="online_payments">
          <ul>
            <li>
              <a href="/online-payments/">Overview</a>
            </li>
            <li>
              <a href="/online-payments/guides/">Guides</a>
            </li>
            <li>
              <a href="/online-payments/plugins/">Plugins</a>
            </li>
            <li>
              <a href="/online-payments/tools/">Tools</a>
            </li>
          </ul>
        </Card>
        <Card title="Terminal Payments" icon="card_in">
          <ul>
            <li>
              <a href="/terminal-payments/">Overview</a>
            </li>
            <li>
              <a href="/online-payments/guides/">Guides</a>
            </li>
            <li>
              <a href="/terminal-payments/tools/">Tools</a>
            </li>
          </ul>
        </Card>
        <Card title="Tooling" icon="apps">
          <ul>
            <li>
              <a href="/api">API reference</a>
            </li>
            <li>
              <a href="/changelog">Changelog</a>
            </li>
            <li>
              <a href="/online-payments/tools/introduction">Tools</a>
            </li>
          </ul>
        </Card>
      </div>
    </section>
    <section>
      <TryItOut />
    </section>
    <section>
      <Headline as="h2" className="header">Building blocks</Headline>
      <CardStack>
        <CardLink
          href="/online-payments/tools/swift-checkout/"
          title="Swift checkout"
          description="Collect payment, address, and contact information with the click of a button."
          image="/img/swift-checkout.svg"
        />
        <CardLink
          href="/terminal-payments/tools/cloud-api/"
          title="Card reader payments"
          description="Integrate card payments from any platform using Cloud API."
          image="/img/api-call.svg"
        />
        <CardLink
          href="/online-payments/tools/card-widget/"
          title="Payment widget"
          description="Securely collect and process customers payment information."
          image="/img/swift-checkout.svg"
        />
        <CardLink
          href="/online-payments/plugins"
          title="Plugins"
          description="Use SumUp plugin for Prestashop, Wix, or WooCommerce."
          image="/img/api-call.svg"
        />
        <CardLink
          href="/online-payments/plugins"
          title="Mobile app integration"
          description="Accept card reader payments from your own app using SumUp card readers."
          image="/img/swift-checkout.svg"
        />
        <CardLink
          href="/online-payments/plugins"
          title="SDKs"
          description="Use your favorite programming language with one of our SDKs."
          image="/img/api-call.svg"
        />
      </CardStack>
    </section>
    <section>
      <Headline as="h2" className="header">Explore our guides</Headline>
      <div class="button-links">
        <a class="button-link" href="/terminal-payments/guides/pairing-solo/">
          <CardReaderSolo />
          <div>
            <div class="button-title">
              Accept card reader payments<ArrowRight size={"16"} />
            </div>
            <div class="button-description">
              Integrate with SumUp Solo card reader to accept in-person
              payments.
            </div>
          </div>
        </a>
        <a
          class="button-link"
          href="/online-payments/introduction/authorization/"
        >
          <BrowserSecure />
          <div>
            <div class="button-title">
              Authorization<ArrowRight size={"16"} />
            </div>
            <div class="button-description">
              Explore authorization and authentication options for your use
              case.
            </div>
          </div>
        </a>
        <a
          class="button-link"
          href="/online-payments/guides/recurring-payments/"
        >
          <Refresh />
          <div>
            <div class="button-title">
              Recurring payments<ArrowRight size={"16"} />
            </div>
            <div class="button-description">
              Provide smooth user experience for subsequent checkouts.
            </div>
          </div>
        </a>
        <a class="button-link" href="/online-payments/guides/refund/">
          <Refunded />
          <div>
            <div class="button-title">Refunds<ArrowRight size={"16"} /></div>
            <div class="button-description">
              Issue refunds of accepted payments.
            </div>
          </div>
        </a>
        <a class="button-link" href="/terminal-payments/tools/api/">
          <MobilePhone />
          <div>
            <div class="button-title">
              Integrate with your own app<ArrowRight size={"16"} />
            </div>
            <div class="button-description">
              Use API payment switch for lightweight integration of payments in
              your own app.
            </div>
          </div>
        </a>
        <a class="button-link" href="/online-payments/apm/">
          <AlternativePaymentMethod />
          <div>
            <div class="button-title">
              Alternative payment options<ArrowRight size={"16"} />
            </div>
            <div class="button-description">
              Allow your customers to pay with Apple or Google pay.
            </div>
          </div>
        </a>
        <a class="button-link" href="/online-payments/tools/card-widget/">
          <CardIn />
          <div>
            <div class="button-title">
              Card widget<ArrowRight size={"16"} />
            </div>
            <div class="button-description">
              Collect payment data online securely with card widget.
            </div>
          </div>
        </a>
      </div>
    </section>
    <section class="antifraud">
      <div class="content">
        <h2>Our anti-fraud protection</h2>
        <div class="callouts">
          <div>
            <SecurePayments aria-hidden="true" className="icon" />
            <p>
              We’re committed to protecting you from fraud, chargebacks and
              headaches
            </p>
          </div>
          <div>
            <InterestOnBalance aria-hidden="true" className="icon" />
            <p>
              We use advanced artificial intelligence to constantly monitor
              transactions for unusual activity
            </p>
          </div>
          <div>
            <NoCosts aria-hidden="true" className="icon" />
            <p>
              All of our anti-fraud protection is included at no additional cost
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="brands">
      <h2>Brands that build with SumUp</h2>
      <Brands />
    </section>
  </main>
</StarlightPage>

<style>
  :root {
    --sl-content-width: 68rem !important;
  }
</style>

<style lang="scss">
  ul {
    list-style-type: none;
    padding-left: 0;
    margin-top: var(--cui-spacings-mega);

    li {
      margin-bottom: 10px;
    }
  }

  section {
    margin: var(--cui-spacings-exa) 0;

    a {
      color: var(--cui-fg-accent);

      &:hover {
        text-decoration: underline;
      }
    }

    @media screen and (min-width: 941px) {
      &:nth-child(even) {
        .image {
          grid-area: right;
        }

        .text {
          grid-area: left;
        }
      }
    }
  }

  h3 {
    margin-bottom: var(--cui-spacings-giga);
  }

  section :global(h2) {
    margin-bottom: var(--cui-spacings-giga) !important;
  }

  .icon {
    width: 48px;
    height: 48px;
    margin-bottom: var(--cui-spacings-mega);
  }

  .callouts {
    margin: var(--cui-spacings-zetta) 0;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-gap: var(--cui-spacings-giga);

    & > div {
      margin-bottom: var(--cui-spacings-mega);
    }

    @media screen and (max-width: 940px) {
      grid-template-columns: 1fr;
    }
  }

  .antifraud img {
    width: 56px;
    margin-bottom: var(--cui-spacings-kilo);
  }

  .antifraud .callouts {
    text-align: center;
  }

  .links {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-gap: var(--cui-spacings-giga);
    ul {
      li {
        margin-bottom: var(--cui-spacings-bit);
      }
    }
    & > div {
      margin-bottom: var(--cui-spacings-giga);
    }
    @media screen and (max-width: 940px) {
      grid-template-columns: 1fr 1fr;
    }
    @media screen and (max-width: 600px) {
      grid-template-columns: 1fr;
    }
  }

  .brands {
    overflow: hidden;
    padding: var(--cui-spacings-zetta) 0;
  }

  .card-grid {
    display: grid;
    gap: 1rem;

    & > :global(*) {
      margin-top: 0 !important;
    }

    @media (min-width: 50rem) {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .cta {
    padding: var(--cui-spacings-giga);
    background-color: var(--cui-bg-subtle);
    border-radius: var(--cui-border-radius-byte);
  }

  .cta > :global(*:not(:last-child)) {
    margin-bottom: var(--cui-spacings-kilo);
  }

  .cta :global(h2) {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--cui-spacings-byte);
  }

  .button-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--cui-spacings-kilo);
  }

  @media (max-width: 767px) {
    .button-links {
      grid-template-columns: 1fr;
    }
  }

  .button-link {
    text-decoration: none;
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: var(--cui-spacings-mega);
    align-items: center;
    cursor: pointer;
    border-radius: var(--cui-border-radius-byte);
    padding: var(--cui-spacings-kilo);
    min-height: 5rem;
  }

  .button-link > :global(svg) {
    width: 24px;
    height: 24px;
  }

  .button-link:hover {
    text-decoration: none;
    background-color: var(--cui-bg-normal-hovered);
  }

  .button-title {
    color: var(--cui-fg-normal);
    font-weight: var(--cui-font-weight-bold);
    display: flex;
    align-items: center;
    gap: var(--cui-spacings-byte);
  }

  .button-title :global(svg) {
    display: none;
    width: 12px;
    height: 12px;
  }

  .button-link:hover .button-title :global(svg) {
    display: block;
  }

  .button-description {
    color: var(--cui-fg-subtle);
    font-size: var(--cui-body-s-font-size);
    line-height: var(--cui-body-s-line-height);
  }
</style>
