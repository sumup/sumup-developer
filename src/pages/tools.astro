---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";
import { Headline } from "@sumup-oss/circuit-ui";
import SwiftCheckout from "../assets/swift-checkout.svg?raw";
import ApiCall from "../assets/api-call.svg?raw";
import CardLink from "@components/CardLink.astro";
import CardStack from "@components/CardStack.astro";
import GoLogo from "../assets/languages/go.svg?raw";
import PhpLogo from "../assets/languages/php.svg?raw";
import TsLogo from "../assets/languages/ts.svg?raw";
import IosLogo from "../assets/languages/ios.svg?raw";
import AndroidLogo from "../assets/languages/android.svg?raw";

const props = {
  frontmatter: {
    title: "Tools and SDKs",
    description:
      "Welcome to SumUp portal for Developers. We’ve got everything you need to build your own payment acceptance solutions for your business.",
    tableOfContents: false,
    template: "splash",
  },
  custom: true,
} as StarlightPageProps;
---

<StarlightPage {...props}>
  <main>
    <section>
      <Headline as="h2">Building blocks</Headline>
      <CardStack>
        <CardLink
          href="/online-payments/tools/swift-checkout/"
          title="Swift checkout"
          description="Collect payment, address, and contact information with the click of a button."
          image={SwiftCheckout}
        />
        <CardLink
          href="/terminal-payments/tools/cloud-api/"
          title="Card reader payments"
          description="Integrate card payments from any platform using Cloud API."
          image={ApiCall}
        />
        <CardLink
          href="/online-payments/tools/card-widget/"
          title="Payment widget"
          description="Securely collect and process customers payment information."
          image={SwiftCheckout}
        />
        <CardLink
          href="/online-payments/plugins"
          title="Plugins"
          description="Use SumUp plugin for Prestashop, Wix, or WooCommerce."
          image={ApiCall}
        />
        <CardLink
          href="/online-payments/plugins"
          title="Mobile app integration"
          description="Accept card reader payments from your own app using SumUp card readers."
          image={SwiftCheckout}
        />
      </CardStack>
    </section>
    <section>
      <Headline as="h2">SDKs</Headline>
      <div class="sdks">
        <a href="https://github.com/sumup/sumup-go" class="sdk-link">
          <div class="sdk-logo">
            <Fragment set:html={GoLogo} />
          </div>
          <div>
            <div class="sdk-title">Go SDK</div>
            <div class="sdk-url">https://github.com/sumup/sumup-go</div>
          </div>
        </a>
        <a href="https://github.com/sumup/sumup-ts" class="sdk-link">
          <div class="sdk-logo">
            <Fragment set:html={TsLogo} />
          </div>
          <div>
            <div class="sdk-title">Node.js SDK</div>
            <div class="sdk-url">https://github.com/sumup/sumup-ts</div>
          </div>
        </a>
        <a href="https://github.com/sumup/sumup-ecom-php-sdk" class="sdk-link">
          <div class="sdk-logo">
            <Fragment set:html={PhpLogo} />
          </div>
          <div>
            <div class="sdk-title">Php SDK</div>
            <div class="sdk-url">
              https://github.com/sumup/sumup-ecom-php-sdk
            </div>
          </div>
        </a>
        <a href="https://github.com/sumup/sumup-ios-sdk" class="sdk-link">
          <div class="sdk-logo">
            <Fragment set:html={IosLogo} />
          </div>
          <div>
            <div class="sdk-title">iOS mPOS SDK</div>
            <div class="sdk-url">https://github.com/sumup/sumup-ios-sdk</div>
          </div>
        </a>
        <a href="https://github.com/sumup/sumup-android-sdk" class="sdk-link">
          <div class="sdk-logo">
            <Fragment set:html={AndroidLogo} />
          </div>
          <div>
            <div class="sdk-title">Android mPOS SDK</div>
            <div class="sdk-url">
              https://github.com/sumup/sumup-android-sdk
            </div>
          </div>
        </a>
      </div>
    </section>
  </main>
</StarlightPage>

<style>
  section {
    margin-bottom: var(--cui-spacings-tera);
  }
  section :global(h2) {
    margin-bottom: var(--cui-spacings-giga) !important;
  }
  .sdks {
    display: flex;
    flex-direction: column;
    gap: var(--cui-spacings-kilo);
  }

  .sdk-link {
    display: flex;
    align-items: center;
    gap: var(--cui-spacings-tera);
    padding: var(--cui-spacings-giga);
    border-radius: var(--cui-border-radius-byte);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    justify-self: stretch;
    border: var(--cui-border-width-kilo) solid var(--cui-border-subtle);
  }

  .sdk-logo {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
  }

  .sdk-title {
    font-size: var(--cui-body-l-font-size);
    line-height: var(--cui-body-l-line-height);
    font-weight: var(--cui-font-weight-bold);
  }

  .sdk-url {
    margin-top: var(--cui-spacings-bit);
    color: var(--cui-fg-subtle);
  }
</style>
