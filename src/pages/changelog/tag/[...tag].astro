---
import { getCollection } from "astro:content";
import slugify from "@sindresorhus/slugify";
import ChangelogListPage from "../../../components/ChangelogListPage.astro";

const { tag: currentTag } = Astro.params;

export async function getStaticPaths() {
  const posts = (await getCollection("changelog")).flatMap(
    ({ data }) => data.tags,
  );
  const tags = [...new Set(posts)];

  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
  }));
}
---

<ChangelogListPage currentTag={currentTag} />
