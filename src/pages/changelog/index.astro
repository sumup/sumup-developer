---
import Button from "@components/Button";
import RssIcon from "@components/RssIcon";
import { getCollection, render } from "astro:content";
import slugify from "@sindresorhus/slugify";
import { Status, Body, Anchor, Headline } from "@sumup-oss/circuit-ui";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import MarkdownContent from "@components/MarkdownContent.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";

const changelogDocs = await getCollection("changelog");

const allTags = [
  ...new Set(changelogDocs.flatMap(({ data: { tags } }) => tags)),
];

const getEntryHref = (slug: string) => `/changelog/${slug}/`;
const getTagHref = (tag: string) => `/changelog/tags/${slugify(tag)}/`;

const collectionDocs = changelogDocs.sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);

const posts = await Promise.all(
  collectionDocs.map(async (entry) => {
    const { Content } = await render(entry);
    return { Content, ...entry };
  }),
);

const props = {
  frontmatter: {
    title: "Changelog",
    pagefind: false,
    template: "splash",
    tableOfContents: false,
  },
  custom: true,
} as StarlightPageProps;
---

<StarlightPage {...props}>
  <div>
    <ul class="tags">
      <li>
        <a href="/changelog">
          <Status as="span">All</Status>
        </a>
      </li>
      {
        allTags.map((tag) => (
          <li>
            <a href={getTagHref(tag)}>
              <Status as="span">{tag}</Status>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="rssSubscribe">
    <Button
      size="s"
      href="/changelog/rss.xml"
      icon={RssIcon}
      label="Subscribe to RSS"
    />
  </div>
  <main class="content">
    {
      posts.map(
        async ({ Content, id, data: { title, tags, publishedDate } }) => (
          <div class="post" id={`entry-${id}`}>
            <Headline as="h2" size="s" className="title">
              <a class="titleLink" href={getEntryHref(id)}>
                {title}
              </a>
            </Headline>
            <Body size="s" color="subtle" className="meta">
              <span class="metaItem">
                <time
                  data-pagefind-meta="datetime"
                  datetime={publishedDate.toISOString()}
                >
                  {publishedDate.toISOString().split("T")[0]}
                </time>
              </span>
              {tags &&
                tags.map((tag) => (
                  <span class="metaItem">
                    <Anchor size="s" href={getTagHref(tag)}>
                      {tag}
                    </Anchor>
                  </span>
                ))}
              <span class="metaItem">
                <Anchor size="s" href={getEntryHref(id)}>
                  Permalink
                </Anchor>
              </span>
            </Body>
            <MarkdownContent>
              <Content />
            </MarkdownContent>
          </div>
        ),
      )
    }
  </main>
</StarlightPage>

<style lang="scss">
  .content {
    margin-top: var(--cui-spacings-giga);
    display: flex;
    flex-direction: column;
    gap: var(--cui-spacings-giga);
  }

  :global(.expressive-code .frame pre) {
    overflow: auto;
    scrollbar-width: thin;
  }

  .meta {
    margin-bottom: var(--cui-spacings-kilo);
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }

  .metaItem {
    display: inline-flex;
    align-items: center;
  }

  .metaItem:not(:last-child)::after {
    content: "\00B7";
    margin: 0 var(--cui-spacings-byte);
  }

  .title {
    margin-bottom: var(--cui-spacings-bit);
  }

  .titleLink {
    color: inherit;
    text-decoration: none;
  }

  .titleLink:hover,
  .titleLink:focus-visible {
    text-decoration: underline;
  }

  .post {
    padding-bottom: var(--cui-spacings-tera);
    border-bottom: 1px solid var(--cui-border-divider);

    :global(article > *:last-child) {
      margin-bottom: 0;
    }

    &:last-of-type {
      border-bottom: none;
    }
  }

  .tags {
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    list-style: none;
    justify-content: center;
    gap: var(--cui-spacings-byte);
  }

  .rssSubscribe {
    margin-top: var(--cui-spacings-giga);
    display: flex;
    justify-content: center;
  }
</style>
