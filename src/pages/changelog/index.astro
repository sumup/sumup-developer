---
import { getCollection } from "astro:content";
import slugify from "@sindresorhus/slugify";
import { Badge } from "@sumup-oss/circuit-ui";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";
import Subscribe from "@components/Subscribe.astro";
import { Headline } from "@sumup-oss/circuit-ui";
import MarkdownContent from "@astrojs/starlight/components/MarkdownContent.astro";

const collectionDocs = (await getCollection("changelog"))
  .sort(
    (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
  )
  .map((entry) => ({
    ...entry,
  }));

const posts = await Promise.all(
  collectionDocs.map(async (page) => {
    const { Content } = await page.render();
    return { Content, ...page };
  }),
);

const props = {
  frontmatter: {
    title: "Changelog",
    description:
      "Subscribe to stay up to date with new features and API and SDK changes.",
    template: "splash",
    tableOfContents: false,
  },
  custom: true,
} as StarlightPageProps;
---

<StarlightPage {...props}>
  <div class="subscription">
    <Subscribe />
  </div>
  <main class="content" data-pagefind-body>
    {
      posts.map(async ({ Content, data: { title, tags, publishedDate } }) => {
        return (
          <>
            <div class="time">
              <time
                data-pagefind-meta="datetime"
                datetime={publishedDate.toISOString()}
              >
                {publishedDate.toISOString().split("T")[0]}
              </time>
            </div>
            <div class="post">
              <Headline as="h2" size="m">
                {title}
              </Headline>
              <div class="details">
                {tags && tags.length > 0 && (
                  <ul class="tags">
                    {tags.map((tag) => (
                      <li>
                        <a href={`./${slugify(tag)}`}>
                          <Badge>{tag}</Badge>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              <MarkdownContent>
                <Content />
              </MarkdownContent>
            </div>
          </>
        );
      })
    }
  </main>
</StarlightPage>

<style lang="scss">
  .content {
    margin-top: var(--cui-spacings-zetta);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    row-gap: var(--cui-spacings-zetta);
    column-gap: var(--cui-spacings-giga);
  }

  @media screen and (max-width: 940px) {
    .content {
      grid-template-columns: 100%;
      row-gap: var(--cui-spacings-mega);
    }
  }

  :global(.expressive-code .frame pre) {
    overflow: auto;
    scrollbar-width: thin;
  }

  .subscription {
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .time {
    word-break: keep-all;
    justify-self: end;
  }

  @media screen and (max-width: 940px) {
    .time {
      justify-self: start;
    }
  }

  .post {
    padding-bottom: var(--cui-spacings-zetta);
    border-bottom: 1px solid var(--cui-border-divider);

    :global(article > *:last-child) {
      margin-bottom: 0;
    }

    &:last-of-type {
      border-bottom: none;
    }

    .details {
      display: block;
      margin-bottom: var(--cui-spacings-mega);
      color: var(--cui-fg-subtle);
    }
  }

  .tags {
    margin: 0;
    margin-top: var(--cui-spacings-byte);
    padding: 0;
    display: inline-flex;
    flex-direction: row;
    list-style: none;

    li {
      margin-right: var(--cui-spacings-byte);
    }
  }
</style>
