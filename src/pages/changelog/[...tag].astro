---
import { getCollection } from "astro:content";
import slugify from "@sindresorhus/slugify";
import { Badge, Body } from "@sumup-oss/circuit-ui";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import type { StarlightPageProps } from "@astrojs/starlight/props";
import Subscribe from "@components/Subscribe.astro";
import { Headline } from "@sumup-oss/circuit-ui";
import MarkdownContent from "@astrojs/starlight/components/MarkdownContent.astro";

const { tag: currentTag } = Astro.params;

const changelogDocs = await getCollection("changelog");

const allTags = [
  ...new Set(changelogDocs.flatMap(({ data: { tags } }) => tags)),
];

const collectionDocs = (
  await getCollection(
    "changelog",
    ({ data: { tags } }) =>
      !currentTag || tags.map((tag) => slugify(tag)).includes(currentTag),
  )
)
  .sort(
    (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
  )
  .map((entry) => ({
    ...entry,
  }));

export async function getStaticPaths() {
  const posts = (await getCollection("changelog")).flatMap(
    ({ data }) => data.tags,
  );
  const tags = ["", ...new Set(posts)];

  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
  }));
}

const posts = await Promise.all(
  collectionDocs.map(async (page) => {
    const { Content } = await page.render();
    return { Content, ...page };
  }),
);

const tagName = posts.at(0)?.data.tags.find((t) => slugify(t) === currentTag);

const props = {
  frontmatter: {
    title: tagName ? `${tagName} Changelog` : `Changelog`,
    template: "splash",
    tableOfContents: false,
  },
  custom: true,
} as StarlightPageProps;
---

<StarlightPage {...props}>
  <div>
    <ul class="tags">
      <li>
        <a href="/changelog">
          <Badge>All</Badge>
        </a>
      </li>
      {
        allTags.map((tag) => (
          <li>
            <a href={`/changelog/${slugify(tag)}`}>
              <Badge>{tag}</Badge>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  {
    !currentTag && (
      <div class="subscription">
        <Subscribe />
      </div>
    )
  }
  <main class="content" data-pagefind-body>
    {
      posts.map(async ({ Content, data: { title, tags, publishedDate } }) => {
        return (
          <>
            <div class="post">
              <Body size="s" color="subtle">
                <time
                  data-pagefind-meta="datetime"
                  datetime={publishedDate.toISOString()}
                >
                  {publishedDate.toISOString().split("T")[0]}
                </time>
              </Body>
              <Headline as="h2" size="m" className="title">
                {title}
              </Headline>
              <MarkdownContent>
                <Content />
              </MarkdownContent>
              {tags && tags.length > 0 && (
                <ul class="tags entryTags">
                  {tags.map((tag) => (
                    <li>
                      <a href={`./${slugify(tag)}`}>
                        <Badge>{tag}</Badge>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </>
        );
      })
    }
  </main>
</StarlightPage>

<style lang="scss">
  .content {
    margin-top: var(--cui-spacings-zetta);
    display: flex;
    flex-direction: column;
    gap: var(--cui-spacings-giga);
  }

  :global(.expressive-code .frame pre) {
    overflow: auto;
    scrollbar-width: thin;
  }

  .subcription {
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .time {
    word-break: keep-all;
    justify-self: end;
  }

  .title {
    margin-bottom: var(--cui-spacings-mega);
  }

  .post {
    padding-bottom: var(--cui-spacings-zetta);
    border-bottom: 1px solid var(--cui-border-divider);

    :global(article > *:last-child) {
      margin-bottom: 0;
    }

    &:last-of-type {
      border-bottom: none;
    }
  }

  .tags {
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    list-style: none;
    justify-content: center;
    gap: var(--cui-spacings-byte);
  }

  .entryTags {
    margin-top: var(--cui-spacings-tera);
    justify-content: start;
  }
</style>
