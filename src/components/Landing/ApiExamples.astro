---
import { Body, Headline } from "@sumup-oss/circuit-ui";
import { ArrowRight } from "@sumup-oss/icons";
import CodeSamples from "@components/ApiDocs/CodeSamples.astro";
import { homepageIntegrations as examples } from "@lib/homepageIntegrations";
---

<section
  id="checkout-example"
  aria-labelledby="api-examples-heading"
  class="api-examples"
>
  <Headline as="h2" size="m" id="api-examples-heading">
    Try it out
  </Headline>
  <Body color="subtle" className="intro">
    Choose an integration path to see a short acceptance example.
  </Body>

  <div class="explorer" data-home-api-examples>
    <nav
      class="tasks"
      aria-label="Integration examples"
      data-home-api-task-list
    >
      {examples.map(({ title, guide }, index) => (
        <a
          id={`homepage-task-${index}`}
          class="task"
          href={guide.href}
          data-home-api-task
          aria-controls={`homepage-example-${index}`}
        >
          {title}
        </a>
      ))}
    </nav>
    <div class="panels">
      {examples.map(
        (
          {
            id,
            title,
            description,
            prerequisites,
            codeTitle,
            responseTitle,
            samples,
            responses,
            result,
            guide,
            links = [],
          },
          index,
        ) => (
          <div
            id={`homepage-example-${index}`}
            data-home-api-panel
            hidden={index !== 0}
          >
            <div class="task-description">
              <Headline as="h3" size="s">
                {title}
              </Headline>
              <Body size="s" color="subtle" className="description">
                {description}
              </Body>
            </div>
            <Body size="s" color="subtle" className="prerequisites">
              {prerequisites}
            </Body>
            <CodeSamples
              coordinate={`homepage.${id}`}
              samples={samples}
              responses={responses}
              title={codeTitle}
              responseTitle={responseTitle}
              showResponseStatus={false}
              headingLevel={4}
              compact
            />
            <Body size="s" color="subtle" className="result">
              {result}
            </Body>
            <div class="task-links">
              {[guide, ...links].map(({ href, label }) => (
                <a href={href}>
                  <span>{label}</span>
                  <ArrowRight size="16" aria-hidden="true" />
                </a>
              ))}
            </div>
          </div>
        ),
      )}
    </div>
  </div>
  <Body size="s" color="subtle" className="example-note">
    Use a{" "}
    <a href="/online-payments/#getting-a-sandbox-merchant-account">
      sandbox account
    </a>
    and replace the sample credentials and IDs with your own. Create a unique
    reference for each payment attempt. These snippets fit into an application
    after setup; follow each guide for the full integration. Install your{" "}
    <a href="/tools/sdks/">SDK</a> or <a href="/tools/cli/">CLI</a> before
    running the backend examples.
  </Body>
</section>

<script>
  import "./api-examples.client";
</script>

<style>
  .api-examples {
    container-type: inline-size;
    margin-block: var(--cui-spacings-exa);
    scroll-margin-top: calc(var(--portal-header-height) + 1.5rem);
  }
  .api-examples :global(.intro) {
    margin: var(--cui-spacings-kilo) 0 var(--cui-spacings-giga);
  }
  .explorer {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    border: 1px solid var(--cui-border-normal);
    border-radius: var(--cui-border-radius-mega);
    overflow: hidden;
  }
  .tasks {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--cui-spacings-bit);
    padding: var(--cui-spacings-kilo);
    border-right: 1px solid var(--cui-border-divider);
    background: var(--cui-bg-subtle);
  }
  .task {
    padding: var(--cui-spacings-kilo);
    border: 1px solid transparent;
    border-radius: var(--cui-border-radius-byte);
    color: var(--cui-fg-subtle);
    text-decoration: none;
    font-size: var(--cui-body-s-font-size);
    font-weight: var(--cui-font-weight-semibold);
  }
  .task:hover {
    color: var(--cui-fg-normal);
    background: var(--cui-bg-normal-hovered);
  }
  .task[aria-selected="true"],
  .explorer:not([data-ready]) .task:first-child {
    color: var(--cui-fg-normal);
    border-color: var(--cui-border-normal);
    background: var(--cui-bg-normal);
  }
  .panels {
    min-width: 0;
    padding: var(--cui-spacings-mega);
  }
  .task-description {
    padding: var(--cui-spacings-byte) 0 var(--cui-spacings-mega);
  }
  .task-description :global(.description) {
    margin: var(--cui-spacings-byte) 0 0;
  }
  .panels :global(.prerequisites) {
    margin: 0 0 var(--cui-spacings-mega);
  }
  .panels :global(.result) {
    margin: var(--cui-spacings-mega) 0 0;
  }
  .task-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--cui-spacings-kilo) var(--cui-spacings-mega);
    margin-top: var(--cui-spacings-mega);
    font-size: var(--cui-body-s-font-size);
  }
  .task-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--cui-spacings-byte);
    color: var(--cui-fg-normal);
    text-align: end;
    text-underline-offset: 0.2em;
  }
  .task-links a :global(svg) {
    flex: none;
  }
  .api-examples :global(.example-note) {
    margin: var(--cui-spacings-kilo) 0 0;
  }
  @container (max-width: 48rem) {
    .explorer {
      grid-template-columns: 1fr;
    }
    .tasks {
      flex-direction: row;
      overflow-x: auto;
      border-right: 0;
      border-bottom: 1px solid var(--cui-border-divider);
    }
    .task {
      flex: none;
      white-space: nowrap;
    }
    .panels {
      padding: var(--cui-spacings-kilo);
    }
  }
</style>
