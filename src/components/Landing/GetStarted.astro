---
import Button from "@components/Button";
import Code from "@components/Code/Code.astro";
import { Tabs, TabItem } from "@components/nimbus";
import { Apps, CardIn, Globe } from "@sumup-oss/icons";
import CopyPrompt from "@components/nimbus/CopyPrompt.astro";
import { Body, Headline } from "@sumup-oss/circuit-ui";

const paths = [
  {
    label: "Online payments",
    icon: Globe,
    title: "Create your first online checkout",
    description:
      "Start with a payment page hosted by SumUp, or embed the Payment Widget in your own website. Your server creates the checkout; SumUp collects the payment details.",
    cta: {
      label: "Start with Hosted Checkout",
      href: "/online-payments/checkouts/hosted-checkout/",
    },
    exampleTitle: "Create a Hosted Checkout",
    example: String.raw`curl --request POST https://api.sumup.com/v0.1/checkouts \
  --header "Authorization: Bearer $SUMUP_API_KEY" \
  --header "Content-Type: application/json" \
  --data '{
    "merchant_code": "YOUR_MERCHANT_CODE",
    "amount": 12.00,
    "currency": "EUR",
    "checkout_reference": "YOUR_UNIQUE_REFERENCE",
    "hosted_checkout": { "enabled": true }
  }'`,
    note: "Use your sandbox API key, replace the merchant code, and choose a unique reference for each request. Open the returned hosted_checkout_url, then verify the payment on your server.",
    links: [
      { label: "Online quickstart", href: "/online-payments/" },
      {
        label: "Payment Widget",
        href: "/online-payments/checkouts/card-widget/",
      },
      { label: "Payment methods", href: "/online-payments/payment-methods/" },
      { label: "Test payments", href: "/online-payments/testing/" },
    ],
  },
  {
    label: "In-person payments",
    icon: CardIn,
    title: "Connect your app to a reader",
    description:
      "Accept payments in a native mobile app with our SDKs, or control a Solo reader from your server with the Cloud API. Follow the quickstart to choose your integration and make a test payment.",
    cta: {
      label: "Start the in-person quickstart",
      href: "/terminal-payments/quickstart/",
    },
    exampleTitle: "Cloud API: list your paired readers",
    example: String.raw`curl "https://api.sumup.com/v0.1/merchants/$SUMUP_MERCHANT_CODE/readers" \
  --header "Authorization: Bearer $SUMUP_API_KEY"`,
    note: "Use your sandbox API key and merchant code. Try the Cloud API with Virtual Solo before connecting a physical reader; the quickstart covers pairing and checkout credentials.",
    links: [
      { label: "Compare integrations", href: "/terminal-payments/" },
      { label: "Mobile SDKs", href: "/terminal-payments/sdks/" },
      { label: "Cloud API", href: "/terminal-payments/cloud-api/" },
      { label: "Reader guides", href: "/terminal-payments/readers/" },
    ],
  },
  {
    label: "Tools & SDKs",
    icon: Apps,
    title: "Build with the tools you already use",
    description:
      "Use an official SDK in your preferred language, explore endpoints in the API reference, or give your AI assistant access to current SumUp documentation and tools.",
    cta: { label: "Explore SDKs and the CLI", href: "/tools/sdks/" },
    exampleTitle: "Install the JavaScript and TypeScript SDK",
    example: "npm install @sumup/sdk",
    note: "Call SumUp APIs from your server. Keep secret API keys and OAuth client secrets out of browsers and mobile apps.",
    links: [
      { label: "JavaScript SDK", href: "/tools/sdks/javascript/" },
      { label: "API reference", href: "/api/" },
      { label: "Authorization", href: "/tools/authorization/" },
      { label: "Set up your AI assistant", href: "/tools/llms/setup/" },
    ],
  },
];
---

<section
  class="get-started"
  id="start-building"
  aria-labelledby="start-building-heading"
>
  <header class="section-heading">
    <Headline as="h2" size="m" id="start-building-heading">
      Payment building blocks, ready to connect
    </Headline>
    <Body color="subtle" className="section-description">
      From a hosted checkout to a connected reader, choose the building blocks
      that fit your app. Start in a sandbox and follow the guides to your first
      payment.
    </Body>
  </header>

  <ol class="start-steps" aria-label="Get started with SumUp">
    <li>
      <span class="step-number" aria-hidden="true">
        1
      </span>
      <div>
        <a href="/online-payments/#getting-a-sandbox-merchant-account">
          Create a sandbox
        </a>
        <Body size="s" color="subtle" className="step-description">
          Test without moving real money.
        </Body>
      </div>
    </li>
    <li>
      <span class="step-number" aria-hidden="true">
        2
      </span>
      <div>
        <a href="/tools/authorization/">Get your credentials</a>
        <Body size="s" color="subtle" className="step-description">
          Set up an API key or OAuth.
        </Body>
      </div>
    </li>
    <li>
      <span class="step-number" aria-hidden="true">
        3
      </span>
      <div>
        <a href="#payment-integrations">Choose your integration</a>
        <Body size="s" color="subtle" className="step-description">
          Start online or connect a reader.
        </Body>
      </div>
    </li>
  </ol>

  <div class="integration-picker" id="payment-integrations">
    <Tabs>
      {paths.map(
        ({
          label,
          icon: Icon,
          title,
          description,
          cta,
          exampleTitle,
          example,
          note,
          links,
        }) => (
          <TabItem label={label}>
            <div class="integration-panel">
              <div class="panel-intro">
                <span class="path-icon">
                  <Icon aria-hidden="true" />
                </span>
                <Headline as="h3" size="s" className="panel-title">
                  {title}
                </Headline>
                <Body color="subtle" className="panel-description">
                  {description}
                </Body>
                <Button href={cta.href} variant="primary" label={cta.label} />
              </div>
              <div class="panel-example">
                <Body size="s" weight="semibold" className="example-title">
                  {exampleTitle}
                </Body>
                <Code code={example} lang="bash" />
                <Body size="s" color="subtle" className="example-note">
                  {note}
                </Body>
              </div>
            </div>
            <ul class="related-links" aria-label={`${label} guides`}>
              {links.map(({ label, href }) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))}
            </ul>
            {label === "Tools & SDKs" && (
              <div class="agent-setup">
                <Headline as="h3" size="s">
                  Build with your AI assistant
                </Headline>
                <Body color="subtle" className="agent-description">
                  Paste this prompt into your assistant to get started with
                  SumUp skills and tools.
                </Body>
                <CopyPrompt />
              </div>
            )}
          </TabItem>
        ),
      )}
    </Tabs>
  </div>
</section>

<style>
  .get-started {
    container-type: inline-size;
    margin-block: var(--cui-spacings-exa);
  }

  .section-heading :global(h2) {
    text-wrap: balance;
  }

  .section-heading :global(.section-description) {
    max-width: 42rem;
    margin: var(--cui-spacings-kilo) 0 var(--cui-spacings-giga);
    text-wrap: pretty;
  }

  .start-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--cui-spacings-mega);
    padding: 0;
    margin: 0 0 var(--cui-spacings-giga);
    list-style: none;
  }

  .start-steps li {
    display: flex;
    align-items: start;
    gap: var(--cui-spacings-kilo);
  }

  .step-number,
  .path-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: var(--cui-bg-subtle);
    border: 1px solid var(--cui-border-subtle);
    border-radius: var(--cui-border-radius-byte);
  }

  .start-steps a {
    font-weight: var(--cui-font-weight-semibold);
  }

  .start-steps :global(.step-description) {
    margin: var(--cui-spacings-bit) 0 0;
  }

  .integration-picker {
    min-width: 0;
    padding: var(--cui-spacings-mega);
    border: 1px solid var(--cui-border-divider);
    border-radius: var(--cui-border-radius-mega);
    background-color: var(--cui-bg-elevated);
  }

  .integration-picker :global(.tabs) {
    margin: 0;
  }

  .integration-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--cui-spacings-giga);
    padding-block: var(--cui-spacings-mega);
  }

  .panel-intro,
  .panel-example {
    min-width: 0;
  }

  .panel-intro :global(.panel-title) {
    margin: var(--cui-spacings-mega) 0 var(--cui-spacings-kilo);
    text-wrap: balance;
  }

  .panel-intro :global(.panel-description) {
    margin: 0 0 var(--cui-spacings-mega);
  }

  .panel-example :global(.example-title) {
    margin: 0 0 var(--cui-spacings-kilo);
  }

  .panel-example :global(.example-note) {
    margin: var(--cui-spacings-kilo) 0 0;
    overflow-wrap: anywhere;
  }

  .related-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cui-spacings-kilo) var(--cui-spacings-mega);
    padding: var(--cui-spacings-mega) 0 0;
    margin: 0;
    border-top: 1px solid var(--cui-border-divider);
    list-style: none;
  }

  .start-steps a,
  .related-links a {
    color: var(--cui-fg-normal);
    text-decoration: none;
  }

  .start-steps a:hover,
  .related-links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .agent-setup :global(.agent-description) {
    margin: var(--cui-spacings-kilo) 0 var(--cui-spacings-mega);
  }

  @container (max-width: 48rem) {
    .start-steps,
    .integration-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
