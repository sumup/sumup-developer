---
const themes = ["light", "dark"];
const sizes = "min(calc(100vw - 1.5rem), 28rem)";
const srcSet = (theme: string, format: string) =>
  [1, 2, 3]
    .map(
      (density) =>
        `/img/landing/hero-${theme}${density > 1 ? `@${density}x` : ""}.${format} ${448 * density}w`,
    )
    .join(", ");
---

{themes.map((theme) => (
  <picture class={`payment-scenes-${theme}`}>
    <source type="image/avif" srcset={srcSet(theme, "avif")} sizes={sizes} />
    <source type="image/webp" srcset={srcSet(theme, "webp")} sizes={sizes} />
    <img
      src={`/img/landing/hero-${theme}.png`}
      srcset={srcSet(theme, "png")}
      sizes={sizes}
      width="448"
      height="317"
      class="payment-scenes"
      alt=""
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
  </picture>
))}

<style>
  picture {
    width: 100%;
  }

  .payment-scenes {
    display: block;
    width: 100%;
    height: auto;
  }

  .payment-scenes-dark,
  :global(:root[data-color-scheme="dark"]) .payment-scenes-light {
    display: none;
  }

  :global(:root[data-color-scheme="dark"]) .payment-scenes-dark {
    display: block;
  }
</style>
