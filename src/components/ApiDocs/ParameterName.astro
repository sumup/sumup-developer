---
import { resolveReference } from "@lib/openapi";
import type { OpenAPIV3_1 } from "openapi-types";
import Constraints from "./Constraints.astro";

type Constraint =
  | {
      text: string;
    }
  | {
      text: string;
      href: string;
    }
  | {
      key: string;
      value: string;
    }
  | {
      key: string;
      code: string;
    };

type Props = {
  name: string;
  required: boolean;
  def:
    | OpenAPIV3_1.ReferenceObject
    | OpenAPIV3_1.ResponseObject
    | OpenAPIV3_1.SchemaObject
    | undefined
    | null;
};
let { name, required, def } = Astro.props;

if (def && "$ref" in def) {
  def = resolveReference(def.$ref);
}

const formatValue = (value: unknown): string => {
  if (value === undefined || value === null) return "";
  if (typeof value === "string") return value;
  try {
    return JSON.stringify(value);
  } catch {
    return String(value);
  }
};

const addConstraint = (
  constraints: Constraint[],
  key: string,
  value: unknown,
) => {
  if (value === undefined || value === null || value === "") return;
  constraints.push({ key, value: formatValue(value) });
};

const schema = def && "type" in def ? def : undefined;
const constraints: Constraint[] = [];

if (schema) {
  if (schema.type === "string") {
    addConstraint(constraints, "min length", schema.minLength);
    addConstraint(constraints, "max length", schema.maxLength);
    if (schema.pattern) {
      constraints.push({ key: "pattern", code: schema.pattern });
    }
    if (schema.format) {
      addConstraint(constraints, "format", schema.format);
    }
  }

  if (schema.type === "array") {
    addConstraint(constraints, "min items", schema.minItems);
    addConstraint(constraints, "max items", schema.maxItems);
    if (schema.uniqueItems) {
      constraints.push({ text: "unique items" });
    }
  }

  if (schema.type === "object") {
    addConstraint(constraints, "min properties", schema.minProperties);
    addConstraint(constraints, "max properties", schema.maxProperties);
  }

  addConstraint(constraints, "minimum", schema.minimum);
  addConstraint(constraints, "maximum", schema.maximum);
  addConstraint(constraints, "exclusive min", schema.exclusiveMinimum);
  addConstraint(constraints, "exclusive max", schema.exclusiveMaximum);
  addConstraint(constraints, "multiple of", schema.multipleOf);

  if (schema.default !== undefined) {
    constraints.push({ key: "default", code: formatValue(schema.default) });
  }
  if ("nullable" in schema && schema.nullable) {
    constraints.push({ text: "nullable" });
  }
  if (schema.deprecated) {
    constraints.push({ text: "deprecated" });
  }
  if (schema.readOnly) {
    constraints.push({ text: "Read only" });
  }
  if (schema.writeOnly) {
    constraints.push({ text: "Write only" });
  }
  if (schema.externalDocs?.url) {
    constraints.push({ text: "docs", href: schema.externalDocs.url });
  }
}

const toSchemaTypeText = (
  value:
    | OpenAPIV3_1.ReferenceObject
    | OpenAPIV3_1.SchemaObject
    | OpenAPIV3_1.ResponseObject
    | undefined
    | null,
): string | undefined => {
  if (!value) return undefined;
  if ("$ref" in value) {
    return value.$ref.split("/").pop() || "object";
  }

  if ("items" in value && value.items) {
    return `[]${toSchemaTypeText(value.items) || "object"}`;
  }

  if ("title" in value && value.title) {
    return value.title;
  }

  if ("type" in value && value.type) {
    return Array.isArray(value.type) ? value.type.join(" | ") : value.type;
  }

  return undefined;
};

const typeText = toSchemaTypeText(def);
---

<div class="parameter">
  <span class="name">{name}</span>
  <span class="type">{typeText}</span>
  {required && <span class="required">required</span>}
  <Constraints constraints={constraints} />
</div>

<style>
  .parameter {
    margin-bottom: var(--cui-spacings-bit);
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--cui-spacings-bit);
    align-items: baseline;
  }

  .name {
    font-family: var(--cui-font-stack-mono);
    font-weight: 600;
    margin-right: var(--cui-spacings-bit);
  }

  .required {
    color: var(--cui-fg-warning);
  }
</style>
