---
import type { HTMLAttributes } from "astro/types";
import type { OperationObject } from "src/types/openapi";

export type Props = HTMLAttributes<"div"> & {
  operation: OperationObject;
};

const { operation, class: className, ...props } = Astro.props;
---

<div
  {...props}
  class:list={["endpoint", className]}
  title={`${operation.method.toUpperCase()} ${operation.path}`}
>
  <span class:list={["method", operation.method]}
    >{operation.method.toUpperCase()}</span
  >
  <span class="path">{operation.path}</span>
</div>

<style>
  .endpoint {
    align-items: baseline;
    display: flex;
    gap: var(--cui-spacings-byte);
    max-width: 100%;
    min-width: 0;
  }

  .method {
    flex-shrink: 0;
    font-weight: var(--cui-font-weight-bold);
  }

  .path {
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .method.get {
    color: var(--cui-fg-accent);
  }

  .method.post {
    color: var(--cui-fg-success);
  }

  .method.patch {
    color: var(--cui-fg-promo);
  }

  .method.put {
    color: var(--cui-fg-warning);
  }

  .method.delete {
    color: var(--cui-fg-danger);
  }
</style>
