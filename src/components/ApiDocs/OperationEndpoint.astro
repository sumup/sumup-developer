---
import type { ApiOperationPage } from "@cloudflare/nimbus-docs/api";
import MethodStatus from "./MethodStatus.astro";
interface Props {
  operation: ApiOperationPage;
}
const { operation } = Astro.props;
---

<div class="endpoint">
  <MethodStatus method={operation.method} />
  <code>{operation.path}</code>
  {operation.isWebhook && <span>Webhook</span>}
</div>
<style>
  .endpoint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--cui-spacings-byte);
    overflow-wrap: anywhere;
  }
  code {
    font-family: var(--cui-font-stack-mono);
  }
</style>
