---
import type { ApiOperationPage } from "@cloudflare/nimbus-docs/api";
import { Tabs, TabItem } from "@components/nimbus";
import MarkdownContent from "@components/MarkdownContent.astro";
import LRGrid from "./LRGrid.astro";
import SectionHeading from "./SectionHeading.astro";
import Schema from "./Schema.astro";
import Example from "./Example.astro";
import CodeSamples from "./CodeSamples.astro";
import OperationEndpoint from "./OperationEndpoint.astro";
interface Props {
  page: ApiOperationPage;
}
const { page } = Astro.props;
const bodyExists =
  page.body.length > 0 ||
  page.bodyUnion ||
  page.bodyMediaType ||
  page.bodyDescriptionHtml;
---

<LRGrid>
  <div class="operation-content">
    <OperationEndpoint operation={page} />
    {page.descriptionHtml && (
      <MarkdownContent set:html={page.descriptionHtml} />
    )}
    {page.auth.length > 0 && (
      <section class="authorization">
        <SectionHeading as="h2">Authorization</SectionHeading>
        <p>
          {page.auth.some((alternative) => alternative.length === 0)
            ? "Authentication is optional. When provided, use one of:"
            : page.auth.length > 1
              ? "Use one of the following alternatives:"
              : "Required authentication:"}
        </p>
        <ul>
          {page.auth.map((alternative) => (
            <li>
              {alternative.length === 0
                ? "No authentication"
                : alternative.map((scheme, i) => (
                    <>
                      {i > 0 && " and "}
                      <code>{scheme.scheme}</code>
                      {scheme.scopes.length > 0 && (
                        <>
                          {" "}
                          with scopes{" "}
                          {scheme.scopes.map((scope) => (
                            <code>{scope}</code>
                          ))}
                        </>
                      )}
                    </>
                  ))}
            </li>
          ))}
        </ul>
        <a href="/tools/authorization/">Authorization guide</a>
      </section>
    )}
    {page.parameters.map((group) => (
      <Schema
        fields={group.fields}
        title={group.label}
        anchor={group.anchor}
        truncated={group.truncated}
      />
    ))}
    {bodyExists && (
      <Schema
        fields={page.body}
        title="Body parameters"
        union={page.bodyUnion}
        mediaType={page.bodyMediaType}
        required={page.bodyRequired}
        descriptionHtml={page.bodyDescriptionHtml}
        truncated={page.bodyTruncated}
      />
    )}
    {page.requestExamples && page.requestExamples.length > 0 && (
      <section>
        <SectionHeading as="h2">Request examples</SectionHeading>
        <Tabs>
          {page.requestExamples.map((example) => (
            <TabItem label={example.label}>
              {example.description && <p>{example.description}</p>}
              <Example example={example} title={example.label} />
            </TabItem>
          ))}
        </Tabs>
      </section>
    )}
    {!page.samples.length && !page.requestExamples?.length && page.example && (
      <Example example={page.example} title="Request example" />
    )}
    {page.additionalBodies?.map((body) => (
      <Schema
        fields={body.fields}
        title="Body parameters"
        anchor={body.anchor}
        union={body.union}
        mediaType={body.mediaType}
        required={page.bodyRequired}
        truncated={body.truncated}
      >
        {body.example && <Example example={body.example} />}
      </Schema>
    ))}
    <section class="responses" data-api-responses>
      <SectionHeading as="h2">Responses</SectionHeading>
      {page.responses.map((response) => {
        const Response = /^[45]/.test(response.status) ? "details" : "section";
        const Heading = Response === "details" ? "summary" : "h3";
        return (
          <Response id={response.anchor} class="response">
            <Heading class="response-heading">
              {response.status}
              {response.mediaType && <span>{response.mediaType}</span>}
            </Heading>
            {response.descriptionHtml && (
              <MarkdownContent set:html={response.descriptionHtml} />
            )}
            {response.headers && response.headers.length > 0 && (
              <Schema fields={response.headers} title="Headers" />
            )}
            <Schema
              fields={response.fields}
              union={response.bodyUnion}
              truncated={response.truncated}
            />
            {!response.mediaType && (
              <p class="empty-response">Returns an empty response.</p>
            )}
            {response.additionalMedia?.map((body) => (
              <Schema
                fields={body.fields}
                title={body.mediaType}
                anchor={body.anchor}
                union={body.union}
                truncated={body.truncated}
              >
                {body.example && <Example example={body.example} />}
              </Schema>
            ))}
          </Response>
        );
      })}
    </section>
  </div>
  <div class="examples">
    <div class="example-stack">
      <CodeSamples
        samples={page.samples}
        responses={page.responses}
        method={page.method}
        title={page.title}
        coordinate={page.coordinate}
      />
    </div>
  </div>
</LRGrid>
<style>
  .operation-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--cui-spacings-giga);
  }
  .authorization p {
    margin-block: var(--cui-spacings-byte);
  }
  .authorization ul {
    padding-left: var(--cui-spacings-giga);
    margin-block: var(--cui-spacings-byte);
  }
  .authorization code + code {
    margin-left: var(--cui-spacings-byte);
  }
  .examples {
    position: relative;
    min-width: 0;
  }
  .example-stack {
    position: sticky;
    top: calc(var(--portal-header-height) + var(--cui-spacings-giga));
    display: flex;
    flex-direction: column;
    gap: var(--cui-spacings-giga);
  }
  .example-stack > :global(*) {
    flex-shrink: 0;
  }
  @media (min-width: 76.001rem) {
    .example-stack {
      max-height: calc(
        100vh - var(--portal-header-height) - 2 * var(--cui-spacings-giga)
      );
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }
  }
  .response {
    margin-top: var(--cui-spacings-mega);
    scroll-margin-top: calc(var(--portal-header-height) + 1.5rem);
  }
  .response-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--cui-spacings-byte);
    font-size: var(--portal-font-size-mono);
    font-family: var(--cui-font-stack-mono);
  }
  .response-heading span {
    font-family: var(--cui-font-stack-default);
    color: var(--cui-fg-subtle);
    font-size: var(--cui-body-s-font-size);
  }
  summary {
    cursor: pointer;
    padding-block: var(--cui-spacings-byte);
  }
  summary::before {
    content: "▸";
  }
  details[open] > summary::before {
    content: "▾";
  }
  .empty-response {
    color: var(--cui-fg-subtle);
  }
</style>
