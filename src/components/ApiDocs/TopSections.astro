---
import { CodeBlock, MultiCode } from "@components/Code";
import Markdown from "@components/Markdown.astro";
import type { ApiTopSection } from "@lib/openapi/routes";
import { doc, resolveSchema } from "@lib/openapi";
import type { OpenAPIV3_1 } from "openapi-types";
import { ArrowSlanted } from "@sumup-oss/icons";
import { Anchor, Body, Button, Card } from "@sumup-oss/circuit-ui";
import { getJavaSdkVersion } from "@lib/sdks/javaSdkVersion";
import Table from "@components/content/Table";
import Example from "./Example.astro";
import LRGrid from "./LRGrid.astro";
import Schema from "./Schema.astro";
import SDKList from "./SDKList";
import SectionHeading from "./SectionHeading.astro";

export interface Props {
  topSection?: ApiTopSection;
}

const { topSection = "introduction" } = Astro.props;
const javaSdkVersion = await getJavaSdkVersion();
const problemSchema = doc.components?.schemas?.Problem as
  OpenAPIV3_1.SchemaObject | OpenAPIV3_1.ReferenceObject | undefined;
const resolvedProblemSchema = problemSchema
  ? resolveSchema(problemSchema)
  : undefined;

const sectionAttrs = (id: ApiTopSection) =>
  topSection === id
    ? { "data-pagefind-body": "" }
    : { "data-pagefind-ignore": "all" };
---

<section id="introduction" {...sectionAttrs("introduction")}>
  <LRGrid>
    <div class="info">
      <Markdown>{doc.info.description}</Markdown>
      <div class="spec-links">
        <Button
          size="s"
          href="https://raw.githubusercontent.com/sumup/sumup-openapi/refs/heads/main/openapi.yaml"
          target="_blank"
          rel="noreferrer noopener"
          icon={ArrowSlanted}
        >
          View YAML spec
        </Button>
        <Button
          size="s"
          href="https://raw.githubusercontent.com/sumup/sumup-openapi/refs/heads/main/openapi.json"
          target="_blank"
          rel="noreferrer noopener"
          icon={ArrowSlanted}
        >
          View JSON spec
        </Button>
      </div>
    </div>
    {
      doc.servers && (
        <div class="servers api-docs-codeblock-stack">
          {doc.servers.map((server) => (
            <CodeBlock title="Base URL" language="bash" code={server.url} />
          ))}
        </div>
      )
    }
  </LRGrid>
</section>

<section id="sdks" {...sectionAttrs("sdks")}>
  <LRGrid class="sdks">
    <div>
      <div class="info sl-markdown-content">
        <SectionHeading as="h2" id="sdks-heading">SDKs</SectionHeading>
        <p>
          The SumUp SDKs reduce the amount of work required to use our REST
          APIs. SumUp maintains SDKs for PHP, JavaScript, Python, Java, Go, Rust,
          and .NET.
        </p>
      </div>
      <SDKList />
    </div>
    <div>
      <MultiCode
        data-pagefind-ignore="all"
        options={[
          {
            label: "cURL",
            code: "# Select a client library to see installation instructions.",
            lang: "bash",
          },
          {
            label: "JavaScript",
            code: `npm install --save @sumup/sdk
# or
yarn add @sumup/sdk
# or
pnpm add @sumup/sdk
# or
ant i land:@sumup/sdk`,
            lang: "bash",
          },
          {
            label: "Go",
            code: "go get github.com/sumup/sumup-go",
            lang: "bash",
          },
          {
            label: "Java",
            code: `// Maven
<dependency>
  <groupId>com.sumup</groupId>
  <artifactId>sumup-sdk</artifactId>
  <version>${javaSdkVersion}</version>
</dependency>

// Gradle
implementation "com.sumup:sumup-sdk:${javaSdkVersion}"`,
            lang: "xml",
          },
          {
            label: ".NET",
            code: "dotnet add package SumUp",
            lang: "bash",
          },
          {
            label: "Python",
            code: `pip install sumup
# or
uv add sumup`,
            lang: "bash",
          },
          {
            label: "PHP",
            code: "composer require sumup/sumup-php",
            lang: "bash",
          },
          {
            label: "Rust",
            code: "cargo add sumup",
            lang: "bash",
          },
        ]}
        isLanguageSelect
      >
        <div slot="left">Install SDK</div>
      </MultiCode>
      <Card style={{ marginTop: "var(--cui-spacings-mega)" }}>
        <Body size="s">
          You can also explore our APIs in Postman using
          <Anchor
            href="https://www.postman.com/sumupengineering/sumup-developers/overview"
            target="_blank"
            size="s"
            externalLabel="Opens in a new tab"
          >
            SumUp Developers
          </Anchor>
          public collection.
        </Body>
      </Card>
    </div>
  </LRGrid>
</section>

<section id="authentication" {...sectionAttrs("authentication")}>
  <LRGrid>
    <div class="info sl-markdown-content">
      <SectionHeading as="h2" id="authentication-heading">
        Authentication
      </SectionHeading>
      <p>
        The SumUp API uses API keys to authenticate requests. You can view,
        create, and manage your API keys in the{" "}
        <a href="https://me.sumup.com/settings/api-keys">Dashboard</a>.
      </p>
      <p>
        Test mode secret keys have the prefix sk_test_ and live mode secret keys
        have the prefix sk_live_. Alternatively, you can use restricted API keys
        for granular permissions.
      </p>
      <p>
        Keep your API keys secret and safe. Do not share your API keys or expose
        them in a publicly accessible areas such as client-side code (browser or
        apps) or in the GitHub.
      </p>
      <p>
        All API requests must be made over HTTPS and authenticated. Calls made
        over plain HTTP or calls without authentication will fail.
      </p>
    </div>
    <div class="servers">
      <MultiCode
        data-pagefind-ignore="all"
        options={[
          {
            label: "cURL",
            code: `curl https://api.sumup.com/v0.1/checkouts \\
  -H "Authorization: Bearer sup_sk_MvxmLOl0..."`,
            lang: "bash",
          },
          {
            label: "JavaScript",
            code: `import { SumUp } from '@sumup/sdk';

const sumup = new SumUp({ apiKey: 'sup_sk_MvxmLOl0...' });`,
            lang: "ts",
          },
          {
            label: "Go",
            code: `package main

import (
  "github.com/sumup/sumup-go/client"
  sumup "github.com/sumup/sumup-go"
)

func main() {
  client := sumup.NewClient(client.WithAPIKey("sup_sk_MvxmLOl0..."))
}
`,
            lang: "go",
          },
          {
            label: "Java",
            code: `SumUpClient client =
    SumUpClient.builder()
        .accessToken("sup_sk_MvxmLOl0...")
        .build();`,
            lang: "java",
          },
          {
            label: ".NET",
            code: `using SumUp;

var client = new SumUpClient(new SumUpClientOptions
{
    AccessToken = "sup_sk_MvxmLOl0...",
});`,
            lang: "csharp",
          },
          {
            label: "Python",
            code: `from sumup import Sumup

client = SumUp(api_key="sup_sk_MvxmLOl0...")`,
            lang: "python",
          },
          {
            label: "PHP",
            code: `$sumup = new \\SumUp\\SumUp("sup_sk_MvxmLOl0...");`,
            lang: "php",
          },
          {
            label: "Rust",
            code: `use sumup::Client;

let client = Client::default().with_authorization("sup_sk_MvxmLOl0...");`,
            lang: "rust",
          },
        ]}
        isLanguageSelect
      >
        <div slot="left">Authenticate</div>
      </MultiCode>
    </div>
  </LRGrid>
</section>

<section id="errors" {...sectionAttrs("errors")}>
  <LRGrid>
    <div class="info sl-markdown-content">
      <SectionHeading as="h2" id="errors-heading"> Errors </SectionHeading>
      <p>
        Newer APIs use{" "}
        <a
          href="https://www.rfc-editor.org/rfc/rfc9457.html"
          target="_blank"
          rel="noreferrer noopener"
        >
          Problem Details (RFC 9457)
        </a>{" "}
        for error responses.
      </p>
      <p>
        Some APIs support both <code>application/problem+json</code> and{" "}
        <code>application/json</code> for backwards compatibility.
      </p>
      <p>
        If you do not use our SDKs, send the header{" "}
        <code>Accept: application/problem+json, application/json</code> to ensure
        you receive the newer Problem Details error format.
      </p>
      <div class="not-content">
        <Table
          columns={[
            {
              key: "status",
              label: "Status",
              as: "code",
              nowrap: true,
              minWidth: "9rem",
            },
            { key: "name", label: "Type", nowrap: true, minWidth: "12rem" },
            { key: "details", label: "When it is returned", minWidth: "24rem" },
          ]}
          rows={[
            {
              status: "200",
              name: "OK",
              details: "The request finished successfully.",
            },
            {
              status: "400",
              name: "Bad Request",
              details:
                "The payload is invalid, incomplete, or does not match the API contract.",
            },
            {
              status: "401",
              name: "Unauthorized",
              details:
                "Authentication is missing or the provided API key is invalid.",
            },
            {
              status: "402",
              name: "Request Failed",
              details:
                "The request format is valid, but it could not be completed.",
            },
            {
              status: "403",
              name: "Forbidden",
              details:
                "The authenticated key does not have permission for this operation.",
            },
            {
              status: "404",
              name: "Not Found",
              details:
                "The requested endpoint or resource could not be located.",
            },
            {
              status: "409",
              name: "Conflict",
              details: "The request collides with the current resource state.",
            },
            {
              status: "422",
              name: "Unprocessable Entity",
              details:
                "The payload is syntactically valid, but semantic validation failed.",
            },
            {
              status: "424",
              name: "External Dependency Failed",
              details:
                "A required upstream service failed, so the request could not finish.",
            },
            {
              status: "429",
              name: "Too Many Requests",
              details:
                "Rate limits were exceeded. Retry with exponential backoff.",
            },
            {
              status: "5XX",
              name: "Server Errors",
              details:
                "An issue occurred on our side. These failures should be uncommon.",
            },
          ]}
          tableLayout="auto"
        />
      </div>
      {
        problemSchema && (
          <div class="not-content">
            <Schema
              kind="Problem"
              title="Problem schema"
              schema={problemSchema}
            />
          </div>
        )
      }
    </div>
    <div class="errors-panel api-docs-codeblock-stack">
      <CodeBlock
        data-pagefind-ignore="all"
        title="Content-Type"
        language="http"
        code={`application/problem+json`}
      />
      {
        resolvedProblemSchema && (
          <Example
            name="Example problem response"
            schema={resolvedProblemSchema}
          />
        )
      }
    </div>
  </LRGrid>
</section>

<style>
  .spec-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cui-spacings-kilo);
    margin-top: var(--cui-spacings-giga);
  }

  .servers {
    position: relative;
  }
</style>
