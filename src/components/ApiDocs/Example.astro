---
import type { ApiExampleView } from "@cloudflare/nimbus-docs/api";
interface Props {
  example: ApiExampleView;
  title?: string;
}
const { example, title } = Astro.props;
if (!example.highlightedHtml)
  throw new Error("Nimbus API example was not prepared during content sync.");
---

<div class="api-example" data-pagefind-ignore="all">
  {title && <p class="example-title">{title}</p>}
  <Fragment set:html={example.highlightedHtml} />
</div>
<style>
  .api-example {
    min-width: 0;
  }
  .example-title {
    margin-bottom: var(--cui-spacings-byte);
    font-weight: var(--cui-font-weight-semibold);
    font-size: var(--cui-body-s-font-size);
  }
  .api-example :global(.nb-code-figure) {
    margin: 0;
  }
</style>
