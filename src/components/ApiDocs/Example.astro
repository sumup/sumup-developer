---
import { schemaToExample } from "@lib/openapi";
import type { OpenAPIV3_1 } from "openapi-types";
import { CodeBlock } from "@components/Code";

type Props = { name: string; schema: OpenAPIV3_1.SchemaObject };
const { name, schema } = Astro.props;

const example = schemaToExample(schema);
---

<CodeBlock
  data-pagefind-ignore="all"
  title={name}
  language="json"
  code={JSON.stringify(example, null, 2)}
/>
