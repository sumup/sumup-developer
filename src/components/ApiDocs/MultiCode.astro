---
// Code component wrapper that renders custom header for switching
// between code variants. Could be implemented as a plugin for
// Expressive Code, but that's a bit of work:
// https://expressive-code.com/guides/developing-plugins/
// If attempted, inspiration can be taken from:
// https://github.com/expressive-code/expressive-code/tree/main/packages/@expressive-code/plugin-frames
import { Code } from "@astrojs/starlight/components";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  name?: string;
  isLanguageSelect?: boolean;
  options: {
    label: string;
    value?: string;
    code: string;
    description?: string;
    lang: string;
  }[];
}

const {
  options,
  name,
  isLanguageSelect = false,
  class: cls,
  ...attrs
} = Astro.props;
const defaultOption = options[0].label;
---

<div
  class:list={["codeblock", isLanguageSelect && "multi-lang", cls]}
  {...attrs}
>
  <div class="header">
    <div class="name">{name}</div>
    <select
      name="codes-options"
      class:list={[isLanguageSelect ? "langSelector" : "codesSelector"]}
    >
      {
        options.map(({ label, value }) => (
          <option value={value || label.toLowerCase()}>{label}</option>
        ))
      }
    </select>
  </div>
  {
    options.map(({ lang, code, label, value, description }) => (
      <div
        class:list={["code", label === defaultOption ? "active" : ""]}
        data-lang={value || label.toLowerCase()}
      >
        {description && <div class="description">{description}</div>}
        <Code lang={lang} code={code} />
      </div>
    ))
  }
</div>

<script>
  import { setCurrentLanguage } from "@lib/code";

  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".codeblock .langSelector")?.forEach((s) => {
      s.addEventListener("change", (e) => {
        const target = e.target as HTMLSelectElement;
        setCurrentLanguage(target.value);
      });
    });

    for (const mc of document.querySelectorAll(".codeblock")) {
      const blocks = mc.querySelectorAll(".code");
      mc.querySelector(".codesSelector")?.addEventListener("change", (e) => {
        const target = e.target as HTMLSelectElement;
        blocks.forEach((b) => b.classList.remove("active"));
        mc.querySelector(`[data-lang="${target.value}"]`)?.classList.add(
          "active",
        );
      });
    }
  });
</script>

<style>
  .codeblock {
    background: var(--ec-frm-trmTtbBg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-self: start;
    margin: var(--cui-spacings-giga) 0;
    border: var(--ec-brdWd) solid var(--ec-brdCol);
    border-radius: var(--cui-border-radius-byte);
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--ec-uiPadBlk) var(--cui-spacings-kilo);
    color: var(--ec-frm-trmTtbFg);
    border-bottom: var(--ec-brdWd) solid var(--ec-brdCol);
  }

  .name {
    color: var(--cui-fg-subtle);
  }

  .description {
    color: var(--ec-frm-trmTtbFg);
    padding: var(--cui-spacings-byte) var(--cui-spacings-kilo);
  }

  .code {
    background: var(--ec-frm-trmBg);
    overflow: auto;
    display: none;
  }

  .code.active {
    display: block;
  }

  .codeblock :global(figure.frame pre) {
    border: none !important;
    border-radius: 0;
    --code-background: var(--ec-frm-trmBg);
    background: var(--ec-frm-trmBg);
  }
</style>
