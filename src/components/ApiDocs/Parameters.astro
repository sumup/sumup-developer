---
import { resolveSchema } from "@lib/openapi";
import Markdown from "@components/Markdown.astro";
import type { OpenAPIV3_1 } from "openapi-types";
import ParameterName from "./ParameterName.astro";
import SectionHeading from "./SectionHeading.astro";
import { getSchemaEnumValues } from "./schemaUtils";

type Props = {
  parameters: OpenAPIV3_1.ParameterObject[];
  kind: string;
};

const { parameters = [], kind } = Astro.props;
---

<div class="parameters" data-pagefind-ignore>
  <SectionHeading>{kind}</SectionHeading>
  <ul>
    {
      parameters.map((p) => {
        const schema = resolveSchema(p.schema!);
        const enumValues = getSchemaEnumValues(schema);
        return (
          <li>
            <ParameterName
              name={p.name}
              def={p.schema}
              required={!!p.required}
            />
            {enumValues && (
              <div class="enum">
                <span>Options:&nbsp;</span>
                {enumValues.map((value) => (
                  <code dir="auto">{value}</code>
                ))}
              </div>
            )}
            {p.description && <Markdown>{p.description}</Markdown>}
            {"example" in schema && (
              <div>
                Example:{" "}
                <code dir="auto">{JSON.stringify(schema.example)}</code>
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .parameters {
    margin-bottom: var(--cui-spacings-giga);
  }
  ul {
    list-style: none;
    padding: 0;
    margin-bottom: 32px;
    width: 100%;
  }
  ul li {
    padding: var(--cui-spacings-kilo) 0;
  }
  ul li:last-child {
    border-bottom: none;
  }
  .enum {
    margin-bottom: var(--cui-spacings-bit);
    display: inline-flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--cui-spacings-bit);
  }
</style>
