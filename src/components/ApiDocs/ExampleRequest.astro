---
import { doc } from "@lib/openapi";
// TODO: explore alternatives such as https://github.com/Kong/httpsnippet
// This packages is no longer maintained.
import { getEndpointSnippets } from "openapi-snippet";
import MultiCode from "./MultiCode.astro";
import type { OperationObject } from "src/types/openapi";
import { node, go } from "@lib/codesamples";

export interface Props {
  operation: OperationObject;
}

const { operation } = Astro.props;

const snippets = getEndpointSnippets(
  doc,
  operation.path,
  operation.method,
  ["shell_curl"],
  undefined,
);
---

<MultiCode
  name={`${operation.method} ${operation.path}`}
  options={[
    {
      label: "CUrl",
      value: "curl",
      code: snippets.snippets[0].content,
      lang: "bash",
    },
    {
      label: "Node.js",
      value: "node",
      code: node(operation),
      lang: "ts",
    },
    {
      label: "Go",
      value: "go",
      code: go(operation),
      lang: "go",
    },
  ]}
  isLanguageSelect
/>
