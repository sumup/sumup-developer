---
import { MultiCode } from "@components/Code";
import { getCodeSample } from "@lib/codesamples";
import type { OperationObject } from "src/types/openapi";
import OperationEndpoint from "./OperationEndpoint.astro";

export interface Props {
  operation: OperationObject;
}

const { operation } = Astro.props;
---

<MultiCode
  data-pagefind-ignore="all"
  options={[
    {
      label: "cURL",
      code: getCodeSample("curl", operation),
      lang: "bash",
    },
    {
      label: "JavaScript",
      code: getCodeSample("node", operation),
      lang: "ts",
    },
    {
      label: ".NET",
      code: getCodeSample("dotnet", operation),
      lang: "csharp",
    },
    {
      label: "Java",
      code: getCodeSample("java", operation),
      lang: "java",
    },
    {
      label: "Python",
      code: getCodeSample("python", operation),
      lang: "python",
    },
    {
      label: "PHP",
      code: getCodeSample("php", operation),
      lang: "php",
    },
    {
      label: "Go",
      code: getCodeSample("go", operation),
      lang: "go",
    },
    {
      label: "Rust",
      code: getCodeSample("rust", operation),
      lang: "rust",
    },
  ]}
  isLanguageSelect
>
  <OperationEndpoint operation={operation} slot="left" />
</MultiCode>
