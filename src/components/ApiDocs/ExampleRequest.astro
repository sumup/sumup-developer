---
import { doc } from "@lib/openapi";
// TODO: explore alternatives such as https://github.com/Kong/httpsnippet
// This packages is no longer maintained.
import { getEndpointSnippets } from "openapi-snippet";
import {
  MultiCode,
  CodeBlockHeader,
  CopyButton,
  CodeLangSelector,
} from "@components/Code";
import OperationEndpoint from "./OperationEndpoint.astro";
import type { OperationObject } from "src/types/openapi";
import { node, go, python } from "@lib/codesamples";

export interface Props {
  operation: OperationObject;
}

const { operation } = Astro.props;

const snippets = getEndpointSnippets(
  doc,
  operation.path,
  operation.method,
  ["shell_curl"],
  undefined,
);
---

<MultiCode
  options={[
    {
      label: "cURL",
      value: "curl",
      code: snippets.snippets[0].content,
      lang: "bash",
    },
    {
      label: "Node.js",
      value: "node",
      code: node(operation),
      lang: "ts",
    },
    {
      label: "Python",
      value: "python",
      code: python(operation),
      lang: "python",
    },
    {
      label: "Go",
      value: "go",
      code: go(operation),
      lang: "go",
    },
  ]}
  isLanguageSelect
>
  <CodeBlockHeader slot="header">
    <OperationEndpoint operation={operation} slot="left" />
    <CodeLangSelector
      slot="right"
      options={[
        {
          label: "cURL",
          value: "curl",
        },
        {
          label: "Node.js",
          value: "node",
        },
        {
          label: "Python",
          value: "python",
        },
        {
          label: "Go",
          value: "go",
        },
      ]}
    />
    <CopyButton slot="right" />
  </CodeBlockHeader>
</MultiCode>
