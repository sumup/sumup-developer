---
import {
  CodeBlockHeader,
  CodeLangSelector,
  CopyButton,
  MultiCode,
} from "@components/Code";
import { curl, go, node, python, rust } from "@lib/codesamples";
import type { OperationObject } from "src/types/openapi";
import OperationEndpoint from "./OperationEndpoint.astro";

export interface Props {
  operation: OperationObject;
}

const { operation } = Astro.props;
---

<MultiCode
  options={[
    {
      label: "cURL",
      value: "curl",
      code: curl(operation),
      lang: "bash",
    },
    {
      label: "Node.js",
      value: "node",
      code: node(operation),
      lang: "ts",
    },
    {
      label: "Python",
      value: "python",
      code: python(operation),
      lang: "python",
    },
    {
      label: "Go",
      value: "go",
      code: go(operation),
      lang: "go",
    },
    {
      label: "Rust",
      value: "rust",
      code: rust(operation),
      lang: "rust",
    },
  ]}
  isLanguageSelect
>
  <CodeBlockHeader slot="header">
    <OperationEndpoint operation={operation} slot="left" />
    <CodeLangSelector
      slot="right"
      options={[
        {
          label: "cURL",
          value: "curl",
        },
        {
          label: "Node.js",
          value: "node",
        },
        {
          label: "Python",
          value: "python",
        },
        {
          label: "Go",
          value: "go",
        },
        {
          label: "Rust",
          value: "rust",
        },
      ]}
    />
    <CopyButton slot="right" />
  </CodeBlockHeader>
</MultiCode>
