---
import { MultiCode } from "@components/Code";
import {
  cli,
  curl,
  dotnet,
  go,
  java,
  php,
  python,
  rust,
  typescript,
} from "@lib/codesamples";
import type { OperationObject } from "src/types/openapi";
import OperationEndpoint from "./OperationEndpoint.astro";

export interface Props {
  operation: OperationObject;
}

const { operation } = Astro.props;
---

<MultiCode
  data-pagefind-ignore="all"
  options={[
    {
      label: "cURL",
      code: curl(operation),
      lang: "bash",
    },
    {
      label: "CLI",
      code: cli(operation),
      lang: "bash",
    },
    {
      label: "JavaScript",
      code: typescript(operation),
      lang: "ts",
    },
    {
      label: ".NET",
      code: dotnet(operation),
      lang: "csharp",
    },
    {
      label: "Java",
      code: java(operation),
      lang: "java",
    },
    {
      label: "Python",
      code: python(operation),
      lang: "python",
    },
    {
      label: "PHP",
      code: php(operation),
      lang: "php",
    },
    {
      label: "Go",
      code: go(operation),
      lang: "go",
    },
    {
      label: "Rust",
      code: rust(operation),
      lang: "rust",
    },
  ]}
  isLanguageSelect
>
  <OperationEndpoint operation={operation} slot="left" />
</MultiCode>
