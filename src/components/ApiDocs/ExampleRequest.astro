---
import { MultiCode } from "@components/Code";
import { curl, dotnet, go, node, python, rust } from "@lib/codesamples";
import type { OperationObject } from "src/types/openapi";
import OperationEndpoint from "./OperationEndpoint.astro";

export interface Props {
  operation: OperationObject;
}

const { operation } = Astro.props;
---

<MultiCode
  options={[
    {
      label: "cURL",
      code: curl(operation),
      lang: "bash",
    },
    {
      label: "Node.js",
      code: node(operation),
      lang: "ts",
    },
    {
      label: ".NET",
      code: dotnet(operation),
      lang: "csharp",
    },
    {
      label: "Python",
      code: python(operation),
      lang: "python",
    },
    {
      label: "Go",
      code: go(operation),
      lang: "go",
    },
    {
      label: "Rust",
      code: rust(operation),
      lang: "rust",
    },
  ]}
  isLanguageSelect
>
  <OperationEndpoint operation={operation} slot="left" />
</MultiCode>
