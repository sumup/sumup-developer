---
import type { OpenAPIV3_1 } from "openapi-types";
import { Code } from "@astrojs/starlight/components";

type Props = {
  name: string;
  example: OpenAPIV3_1.ExampleObject;
};

const { example, name } = Astro.props;
---

<Code
  meta={`title="${name}"`}
  lang="json"
  code={JSON.stringify(example.value || "", null, 2)}
/>
