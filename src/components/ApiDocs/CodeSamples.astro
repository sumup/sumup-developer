---
import "@components/Code/code-samples.css";
import type { ApiOperationPage } from "@cloudflare/nimbus-docs/api";
import { Select } from "@sumup-oss/circuit-ui";
import MethodStatus from "./MethodStatus.astro";
import Code from "@components/Code/Code.astro";
import SampleCopyButton from "@components/Code/SampleCopyButton.astro";

type Props = Pick<
  ApiOperationPage,
  "samples" | "responses" | "title" | "coordinate"
> & {
  method?: string;
  headingLevel?: 2 | 3 | 4;
  compact?: boolean;
  responseTitle?: string;
  showResponseStatus?: boolean;
};
const {
  responses,
  method,
  title,
  coordinate,
  headingLevel = 2,
  compact = false,
  responseTitle = "Response example",
  showResponseStatus = true,
} = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3" | "h4";
// A generated HTTP request works without choosing or installing an SDK.
const samples = [...Astro.props.samples].sort(
  (a, b) => Number(b.label === "cURL") - Number(a.label === "cURL"),
);
const examples = responses.flatMap((response) =>
  response.example
    ? [{ status: response.status, example: response.example }]
    : [],
);
// Multiple responses always retain tabs so each example remains accessible.
const responseTabs = showResponseStatus || examples.length > 1;
// API routes provide prepared HTML; other pages can render the same model
// through the portal's standard Nimbus-themed Code component.
const options = samples.map((sample) => ({
  label: sample.label,
  value: sample.id,
}));
const responseId = `api-sample-responses-${encodeURIComponent(coordinate)}`;
---

{(samples.length > 0 || examples.length > 0) && (
  <aside
    class:list={["code-samples", { compact }]}
    aria-label="Code samples"
    data-pagefind-ignore="all"
  >
    {samples.length > 0 && (
      <section
        class="request-samples"
        data-api-samples
        aria-label="Request samples"
      >
        <header class="sample-header request-header">
          <div class="request-title">
            {method && <MethodStatus method={method} />}
            <Heading title={title}>{title}</Heading>
          </div>
          <div class="sample-controls">
            {samples.length > 1 ? (
              <div class="sample-select">
                <Select
                  size="s"
                  label="Code sample"
                  hideLabel
                  options={options}
                  defaultValue={samples[0].id}
                  disabled
                  data-api-sample-select
                />
              </div>
            ) : (
              <span class="sample-language">{samples[0].label}</span>
            )}
            <SampleCopyButton />
          </div>
        </header>
        <div class="request-body sample-body" data-cg-row>
          {samples.map((sample, i) => (
            <div
              data-api-sample={sample.id}
              data-api-language={sample.lang}
              hidden={i !== 0}
            >
              {sample.highlightedHtml ? (
                <Fragment set:html={sample.highlightedHtml} />
              ) : (
                <Code
                  code={sample.source}
                  lang={sample.lang === "curl" ? "bash" : sample.lang}
                />
              )}
            </div>
          ))}
        </div>
        <script is:inline data-api-samples-restore>
          // Restore the preferred sample while parsing, before deferred scripts
          // or the first paint. Inactive samples are already hidden by the HTML.
          (() => {
            const root = document.currentScript.parentElement;
            const panels = [...root.querySelectorAll("[data-api-sample]")];
            const find = (value) =>
              panels.find((panel) => panel.dataset.apiSample === value) ??
              panels.find(
                (panel) =>
                  panel.dataset.apiLanguage.toLowerCase() ===
                  value.toLowerCase(),
              );
            let saved = "";
            try {
              saved = localStorage.getItem("nb-api-code-rail__lang") ?? "";
            } catch {
              // Storage is optional; the URL or default sample still works.
            }
            const linked =
              new URL(location.href).searchParams.get("lang") ?? "";
            const selected = find(linked) ?? find(saved) ?? panels[0];
            for (const panel of panels) panel.hidden = panel !== selected;
            const select = root.querySelector("[data-api-sample-select]");
            if (select) select.value = selected.dataset.apiSample;
            root.setAttribute("data-api-samples-restored", "");
          })();
        </script>
      </section>
    )}
    {examples.length > 0 && (
      <section
        class="response-samples"
        data-api-response-samples={responseTabs ? "" : undefined}
        aria-label="Response examples"
      >
        <header class="sample-header response-header">
          <Heading>{responseTitle}</Heading>
          <div class="sample-controls">
            {responseTabs && (
              <div
                class="response-statuses"
                role="tablist"
                aria-label="Response status"
              >
                {examples.map(({ status }, i) => (
                  <button
                    type="button"
                    role="tab"
                    id={`${responseId}-tab-${i}`}
                    aria-controls={`${responseId}-panel-${i}`}
                    aria-selected={i === 0 ? "true" : "false"}
                    tabindex={i === 0 ? 0 : -1}
                    data-api-response-trigger
                    disabled
                    data-status-class={status[0]}
                  >
                    {status}
                  </button>
                ))}
              </div>
            )}
            <SampleCopyButton />
          </div>
        </header>
        {examples.map(({ example }, i) => (
          <div
            role={responseTabs ? "tabpanel" : undefined}
            id={`${responseId}-panel-${i}`}
            aria-labelledby={
              responseTabs ? `${responseId}-tab-${i}` : undefined
            }
            data-api-response-panel
            hidden={i !== 0}
          >
            <div class="sample-body response-body" data-cg-row>
              {example.highlightedHtml ? (
                <Fragment set:html={example.highlightedHtml} />
              ) : (
                <Code
                  code={
                    typeof example.value === "string" &&
                    !example.mediaType.includes("json")
                      ? example.value
                      : JSON.stringify(example.value, null, 2)
                  }
                  lang={example.mediaType.includes("json") ? "json" : "text"}
                />
              )}
            </div>
          </div>
        ))}
      </section>
    )}
  </aside>
)}

<script>
  import "./samples.client";
</script>
