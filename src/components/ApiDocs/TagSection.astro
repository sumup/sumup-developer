---
import Callout from "@components/content/Callout";
import Markdown from "@components/Markdown.astro";
import MarkdownContent from "@components/MarkdownContent.astro";
import { formatSlug } from "@lib/helpers";
import { getTagDescriptionId } from "@lib/openapiContent";
import type { HTMLAttributes } from "astro/types";
import { getEntry, render } from "astro:content";
import type { OperationObject, TagObject } from "src/types/openapi";
import EndpointList from "./EndpointList";
import LRGrid from "./LRGrid.astro";
import SchemaObject from "./Object.astro";
import Operation from "./Operation.astro";

interface Props extends HTMLAttributes<"section"> {
  tag: TagObject;
  operations: OperationObject[];
  target?: string;
}

const {
  tag: {
    name,
    description,
    "x-core-objects": coreObjects = [],
    "x-deprecation-notice": deprecationNotice,
  },
  operations = [],
  target,
  ...attrs
} = Astro.props;

const slug = formatSlug(name);
// Tag descriptions are content entries so they use the configured Satteri
// pipeline, matching operation descriptions and authored documentation.
const descriptionEntry = await getEntry(
  "apiDescriptions",
  getTagDescriptionId(name),
);

if (description && !descriptionEntry) {
  throw new Error(`Missing Markdown content entry for tag ${name}`);
}

const Description = descriptionEntry
  ? (await render(descriptionEntry)).Content
  : undefined;
const [targetTag, targetOp] = (target || "").split("/");
const tagIsTarget = !targetOp && targetTag === slug;
const objectPagefindAttributes = tagIsTarget
  ? {
      "data-pagefind-body": "",
      "data-pagefind-tag": name,
      "data-pagefind-kind": "object",
      "data-pagefind-meta": "kind[data-pagefind-kind], tag[data-pagefind-tag]",
    }
  : {
      "data-pagefind-ignore": "all",
    };
const coreObjectSections = coreObjects.map((schema, index) => {
  const refName =
    "$ref" in schema
      ? (schema.$ref.split("/").pop() ?? `object-${String(index + 1)}`)
      : `object-${String(index + 1)}`;
  const objectSlug = formatSlug(refName);

  return {
    schema,
    sectionId: `${slug}-object-${objectSlug}`,
  };
});
---

<section
  id={slug}
  {...tagIsTarget
    ? {
        "data-pagefind-body": "",
        "data-pagefind-tag": name,
        "data-pagefind-kind": "tag",
        "data-pagefind-meta":
          "kind[data-pagefind-kind], tag[data-pagefind-tag]",
      }
    : {
        "data-pagefind-ignore": "all",
      }}
  {...attrs}
>
  <LRGrid class="tag-overview">
    <div class="tag-info">
      {
        deprecationNotice && (
          <div class="notice">
            <Callout type="caution">
              <Markdown>{deprecationNotice}</Markdown>
            </Callout>
          </div>
        )
      }
      {
        description && Description && (
          <MarkdownContent>
            <Description />
          </MarkdownContent>
        )
      }
    </div>
    {
      operations.length > 0 && (
        <EndpointList operations={operations} tagSlug={slug} />
      )
    }
  </LRGrid>
</section>
{
  coreObjects?.length > 0 && (
    <>
      {coreObjectSections.map(({ schema, sectionId }) => (
        <SchemaObject
          schema={schema}
          sectionId={sectionId}
          {...objectPagefindAttributes}
        />
      ))}
    </>
  )
}
{
  operations && (
    <div
      class="operations"
      {...(tagIsTarget
        ? {
            "data-pagefind-ignore": "all",
          }
        : {})}
    >
      {operations.map((operation) => (
        <Operation
          operation={operation}
          coreObjects={coreObjectSections.map(({ schema }) => schema)}
          {...(targetTag === slug && targetOp === operation.slug
            ? {
                "data-pagefind-body": "",
                "data-pagefind-tag": name,
                "data-pagefind-kind": "operation",
                "data-pagefind-meta":
                  "kind[data-pagefind-kind], tag[data-pagefind-tag]",
              }
            : {
                "data-pagefind-ignore": "all",
              })}
        />
      ))}
    </div>
  )
}

<style>
  .tag-overview {
    align-items: start;
  }

  .notice {
    margin-bottom: var(--cui-spacings-giga);
  }
</style>
