---
import TopSections from "./TopSections.astro";
import TagDocs from "./TagDocs.astro";

export interface Props {
  tagSlug?: string;
  operationSlug?: string;
  topSection?: "introduction" | "sdks" | "authentication" | "errors";
}

const { tagSlug, operationSlug, topSection } = Astro.props;
const target = tagSlug
  ? operationSlug
    ? `${tagSlug}/${operationSlug}`
    : tagSlug
  : topSection;
---

<article data-selected-operation={target}>
  <div class="specs">
    {!tagSlug && <TopSections topSection={topSection} />}
    {tagSlug && <TagDocs tagSlug={tagSlug} operationSlug={operationSlug} />}
  </div>
</article>

<script>
  import { setCurrentLanguage } from "@lib/code";

  const initApiDocsUI = () => {
    document.querySelectorAll("button[data-lang]").forEach((btn) => {
      if ((btn as HTMLElement).dataset.languageHandlerBound === "true") {
        return;
      }
      (btn as HTMLElement).dataset.languageHandlerBound = "true";
      btn.addEventListener("click", () => {
        const lang = (btn as HTMLElement).dataset.lang;
        if (lang) {
          setCurrentLanguage(lang);
        }
      });
    });
  };

  document.addEventListener("astro:page-load", initApiDocsUI);
</script>

<style>
  .specs {
    font-size: 0.9rem;
    flex-grow: 1;
  }

  .specs section:last-child {
    padding-top: 0;
  }

  .specs :global(h2) {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--cui-spacings-byte);
  }

  .specs :global(section) {
    border-bottom: var(--cui-border-width-kilo) solid var(--cui-border-subtle);
    padding: var(--cui-spacings-giga) 0;
    width: 100%;
  }

  .specs :global(section:first-child) {
    padding-top: 0;
  }

  .specs :global(section:last-child) {
    border-bottom: none;
    padding-bottom: 0;
  }

  .specs :global(.api-docs-stack-mega > * + *) {
    margin-top: var(--cui-spacings-mega);
  }

  .specs :global(.api-docs-codeblock-stack .codeblock + .codeblock) {
    margin-top: var(--cui-spacings-mega);
  }

  .specs :global(.api-docs-sticky) {
    position: sticky;
    top: calc(var(--sl-nav-height) + var(--cui-spacings-kilo));
  }

  h1 {
    margin: var(--cui-spacings-giga) 0;
  }

  .lang-switch {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--cui-spacings-kilo);
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: var(--cui-spacings-byte);
    padding: var(--cui-spacings-bit) var(--cui-spacings-byte);
    border: none;
    border-radius: var(--cui-border-radius-byte);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    justify-self: stretch;
    background-color: var(--cui-bg-subtle);
    font-size: var(--cui-body-s-font-size);
    line-height: var(--cui-body-s-line-height);
    font-weight: var(--cui-font-weight-semibold);
  }

  .lang-option:hover {
    background: var(--cui-bg-strong);
    color: var(--cui-fg-on-strong-hovered);
  }
</style>
