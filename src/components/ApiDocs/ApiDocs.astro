---
import Markdown from "@components/Markdown.astro";
import { formatSlug } from "@lib/helpers";
import { doc, pathsByTag } from "@lib/openapi";
import { ExternalLink } from "@sumup-oss/icons";
import LRGrid from "./LRGrid.astro";
import {
  CodeBlock,
  MultiCode,
  CodeLangSelector,
  CopyButton,
  CodeBlockHeader,
} from "@components/Code";
import TagSection from "./TagSection.astro";
import Go from "@assets/languages/go.svg";
import Php from "@assets/languages/php.svg";
import Python from "@assets/languages/python.svg";
import Nodejs from "@assets/languages/nodejs.svg";

export interface Props {
  target?: string;
}

const { target } = Astro.props;
---

<article data-selected-operation={target}>
  <div class="specs">
    <section id="introduction" data-pagefind-body={!target}>
      <LRGrid>
        <div class="info">
          <Markdown>{doc.info.description}</Markdown>
        </div>
        {
          doc.servers && (
            <div class="servers">
              {doc.servers.map((server) => (
                <CodeBlock title="Base URL" language="bash" code={server.url} />
              ))}
            </div>
          )
        }
      </LRGrid>
      <LRGrid class="sdks">
        <div>
          <div class="info sl-markdown-content">
            <h3>SDKs</h3>
            <p>
              The SumUp SDKs reduce the amount of work required to use our REST
              APIs. SumUp maintains SDKs for PHP, Node.js, and Go.
            </p>
          </div>
          <div class="sdk-cards">
            <a
              class="sdk-card"
              href="https://github.com/sumup/sumup-ts"
              target="_blank"
            >
              <div>
                <div class="title"><Nodejs /> Node.js</div>
                <div class="detail">https://github.com/sumup/sumup-ts</div>
              </div>
              <ExternalLink />
            </a>
            <a
              class="sdk-card"
              href="https://github.com/sumup/sumup-go"
              target="_blank"
            >
              <div>
                <div class="title"><Go /> Go</div>
                <div class="detail">https://github.com/sumup/sumup-go</div>
              </div>
              <ExternalLink />
            </a>
            <a
              class="sdk-card"
              href="https://github.com/sumup/sumup=py"
              target="_blank"
            >
              <div>
                <div class="title"><Python /> Python</div>
                <div class="detail">
                  https://github.com/sumup/sumup-py
                </div>
              </div>
              <ExternalLink />
            </a>
            <a
              class="sdk-card"
              href="https://github.com/sumup/sumup-ecom-php-sdk"
              target="_blank"
            >
              <div>
                <div class="title"><Php /> Php</div>
                <div class="detail">
                  https://github.com/sumup/sumup-ecom-php-sdk
                </div>
              </div>
              <ExternalLink />
            </a>
          </div>
        </div>
        <div>
          <MultiCode
            options={[
              {
                label: "Node.js",
                value: "node",
                code: "npm install --save @sumup/sdk",
                lang: "bash",
              },
              {
                label: "Go",
                value: "go",
                code: "go get github.com/sumup/sumup-go",
                lang: "bash",
              },
              {
                label: "Python",
                value: "python",
                code: "pip install python",
                lang: "bash",
              },
              {
                label: "Php",
                value: "php",
                code: "composer require sumup/sumup-ecom-php-sdk",
                lang: "bash",
              },
            ]}
            isLanguageSelect
          >
            <CodeBlockHeader slot="header">
              <div slot="left">Install SDK</div>
              <CodeLangSelector
                slot="right"
                options={[
                  {
                    label: "Node.js",
                    value: "node",
                  },
                  {
                    label: "Go",
                    value: "go",
                  },
                  {
                    label: "Python",
                    value: "python",
                  },
                  {
                    label: "Php",
                    value: "php",
                  },
                ]}
              />
              <CopyButton slot="right" />
            </CodeBlockHeader>
          </MultiCode>
        </div>
      </LRGrid>
    </section>
    <section id="authentication" data-pagefind-body={!target}>
      <LRGrid>
        <div class="info sl-markdown-content">
          <h2>Authentication</h2>
          <p>
            The SumUp API uses API keys to authenticate requests. You can view,
            create, and manage your API keys in the <a
              href="https://me.sumup.com/settings/api-keys">Dashboard</a
            >.
          </p>
          <p>
            Test mode secret keys have the prefix sk_test_ and live mode secret
            keys have the prefix sk_live_. Alternatively, you can use restricted
            API keys for granular permissions.
          </p>
          <p>
            Keep your API keys secret and safe. Do not share your API keys or
            expose them in a publicly accessible areas such as client-side code
            (browser or apps) or in the GitHub.
          </p>
          <p>
            All API requests must be made over HTTPS and authenticated. Calls
            made over plain HTTP or calls without authentication will fail.
          </p>
        </div>
        <div class="servers">
          <MultiCode
            options={[
              {
                label: "Node.js",
                value: "node",
                code: `import { SumUp } from '@sumup/sdk';

const sumup = new SumUp({ apiKey: 'sup_sk_MvxmLOl0...' });`,
                lang: "ts",
              },
              {
                label: "Go",
                value: "go",
                code: `package main

import (
  sumup "github.com/sumup/sumup-go"
)

func main() {
  client := sumup.NewClient().WithAuth("sup_sk_MvxmLOl0...")  
}
`,
                lang: "go",
              },
              {
                label: "Python",
                value: "python",
                code: `from sumup import Sumup

client = SumUp(api_key="sup_sk_MvxmLOl0...")`,
                lang: "python",
              },
              {
                label: "Php",
                value: "php",
                code: "composer require sumup/sumup-ecom-php-sdk",
                lang: "php",
              },
            ]}
            isLanguageSelect
          >
            <CodeBlockHeader slot="header">
              <div slot="left">Authenticate</div>
              <CodeLangSelector
                slot="right"
                options={[
                  {
                    label: "Node.js",
                    value: "node",
                  },
                  {
                    label: "Go",
                    value: "go",
                  },
                  {
                    label: "Python",
                    value: "python",
                  },
                  {
                    label: "Php",
                    value: "php",
                  },
                ]}
              />
              <CopyButton slot="right" />
            </CodeBlockHeader>
          </MultiCode>
        </div>
      </LRGrid>
    </section>
    {
      Object.entries(pathsByTag).map(([tag, operations]) => (
        <TagSection
          tag={
            // eslint-disable-next-line @typescript-eslint/no-non-null-asserted-optional-chain
            doc.tags?.find((t) => formatSlug(t.name) === tag)!
          }
          operations={operations}
          target={target}
        />
      ))
    }
  </div>
</article>

<script>
  import { setCurrentLanguage } from "@lib/code";

  const scrollToCurrent = () => {
    document.querySelectorAll("button[data-lang]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const lang = (btn as HTMLElement).dataset.lang;
        if (lang) {
          setCurrentLanguage(lang);
        }
      });
    });

    const main = document.querySelector("main[data-selected-operation]");
    if (main) {
      const selectedOperation = main.getAttribute("data-selected-operation");
      if (selectedOperation) {
        const target = document.getElementById(selectedOperation);
        if (target) {
          console.info({
            target,
          });
          target.scrollIntoView();
        }
      }
    }
  };

  document.addEventListener("astro:page-load", scrollToCurrent);
  document.addEventListener("DOMContentLoaded", scrollToCurrent);

  const persistSidebar = () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            sessionStorage.setItem("lastVisible", entry.target.id);
          }
        });
      },
      { threshold: 0.5 },
    );

    document.querySelectorAll("section").forEach((section) => {
      observer.observe(section);
    });
  };

  document.addEventListener("astro:page-load", persistSidebar);
  document.addEventListener("DOMContentLoaded", persistSidebar);
</script>

<style>
  .specs {
    font-size: 0.9rem;
    flex-grow: 1;
  }

  .specs :global(h2) {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--cui-spacings-byte);
  }

  :global(section) {
    border-bottom: var(--cui-border-width-kilo) solid var(--cui-border-subtle);
    padding: var(--cui-spacings-giga) 0;
    width: 100%;
  }

  h1 {
    margin: var(--cui-spacings-giga) 0;
  }

  .servers {
    position: relative;
  }

  .lang-switch {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--cui-spacings-kilo);
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: var(--cui-spacings-byte);
    padding: var(--cui-spacings-bit) var(--cui-spacings-byte);
    border: none;
    border-radius: var(--cui-border-radius-byte);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    justify-self: stretch;
    background-color: var(--cui-bg-subtle);
    font-size: var(--cui-body-s-font-size);
    line-height: var(--cui-body-s-line-height);
    font-weight: var(--cui-font-weight-semibold);
  }

  .lang-option:hover {
    background: var(--cui-bg-strong);
    color: var(--cui-fg-on-strong-hovered);
  }

  .sdks {
    margin-top: var(--cui-spacings-tera);
  }

  .sdk-cards {
    margin-top: var(--cui-spacings-mega);
    display: flex;
    flex-direction: column;
    gap: var(--cui-spacings-byte);
  }

  .sdk-card {
    color: var(--cui-fg-subtle);
    padding: var(--cui-spacings-byte) var(--cui-spacings-kilo);
    border-radius: var(--cui-border-radius-byte);
    border: var(--cui-border-width-kilo) solid var(--cui-border-subtle);
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
  }

  .sdk-card:hover {
    text-decoration: none;
    background-color: var(--cui-bg-normal-hovered);
  }

  .sdk-card .title {
    color: var(--cui-fg-normal);
    font-size: var(--cui-body-m-font-size);
    line-height: var(--cui-body-m-line-height);
    margin-bottom: var(--cui-spacings-bit);
    font-weight: var(--cui-font-weight-semibold);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--cui-spacings-byte);
  }

  .sdk-card .detail {
    font-size: var(--cui-body-s-font-size);
    line-height: var(--cui-body-s-line-height);
  }
</style>
