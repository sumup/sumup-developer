---
import type { ApiPageProps } from "@cloudflare/nimbus-docs/api";
import type { ApiHome } from "@cloudflare/nimbus-docs/runtime";
import MarkdownContent from "@components/MarkdownContent.astro";
import Operation from "./Operation.astro";
import ApiIndex from "./ApiIndex.astro";
import EndpointList from "./EndpointList.astro";
import TagOverview from "./TagOverview.astro";
import type { TagOverview as TagOverviewData } from "@lib/api/tagOverview";
interface Props {
  page: ApiPageProps;
  home?: ApiHome;
  tagOverview?: TagOverviewData;
}
const { page, home, tagOverview } = Astro.props;
const nextPart = home?.parts[home.part.number];
---

<div
  class="api-docs"
  data-api-endpoint-index={
    page.kind === "api" || (page.kind === "section" && !tagOverview)
      ? ""
      : undefined
  }
>
  {page.deprecated && (
    <div class="deprecation" role="note">
      <strong>Deprecated.</strong>
      {page.deprecation?.successor && (
        <>
          {" "}
          Use{" "}
          <a href={page.deprecation.successor.href}>
            {page.deprecation.successor.label}
          </a>{" "}
          instead.
        </>
      )}
      {page.deprecation?.migrationHref && (
        <>
          {" "}
          Read the <a href={page.deprecation.migrationHref}>migration guide</a>.
        </>
      )}
    </div>
  )}
  {(page.kind === "api" || (page.kind === "section" && !tagOverview)) && (
    <div class="endpoint-filter">
      <label hidden>
        <span class="visually-hidden">Filter endpoints on this page</span>
        <input
          type="search"
          data-api-endpoint-filter
          placeholder="Filter endpoints on this page"
        />
      </label>
      <p role="status" data-api-endpoint-status></p>
    </div>
  )}
  {page.kind === "operation" ? (
    <Operation page={page} />
  ) : page.kind === "section" && tagOverview ? (
    <TagOverview page={page} overview={tagOverview} />
  ) : (
    <>
      {page.descriptionHtml && (!home || home.part.number === 1) && (
        <MarkdownContent set:html={page.descriptionHtml} />
      )}
      {page.kind === "section" && (
        <>
          <EndpointList operations={page.operations} />
          {page.sections && page.sections.length > 0 && (
            <ul>
              {page.sections.map((section) => (
                <li>
                  <a href={section.href}>{section.label}</a>
                </li>
              ))}
            </ul>
          )}
        </>
      )}
      {page.kind === "api" && (
        <>
          {page.servers.length > 0 && (!home || home.part.number === 1) && (
            <section>
              <h2>Base URL</h2>
              {page.servers.map((server) => (
                <p>
                  <code>{server}</code>
                </p>
              ))}
            </section>
          )}
          {home && (
            <ApiIndex
              chunk={home.part}
              grouped={page.index.groups.some((group) => group.label !== null)}
            />
          )}
          {nextPart && (
            <a href={nextPart.href} rel="next">
              Next: endpoints {nextPart.start}–{nextPart.end} of {home?.total}
            </a>
          )}
        </>
      )}
    </>
  )}
</div>
<script>
  import "./endpoint-filter.client";
</script>
<style>
  .endpoint-filter input {
    width: 100%;
    max-width: 32rem;
    padding: var(--cui-spacings-byte) var(--cui-spacings-kilo);
    border: 1px solid var(--cui-border-normal);
    border-radius: var(--cui-border-radius-byte);
    background: var(--cui-bg-normal);
    color: var(--cui-fg-normal);
    font: inherit;
  }
  [data-api-endpoint-status] {
    color: var(--cui-fg-subtle);
    font-size: var(--cui-body-s-font-size);
    margin-top: var(--cui-spacings-byte);
  }
  [data-api-endpoint-status]:empty {
    display: none;
  }

  .api-docs {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--cui-spacings-giga);
  }
  .deprecation {
    padding: var(--cui-spacings-mega);
    border-radius: var(--cui-border-radius-byte);
    background: var(--cui-bg-warning);
    color: var(--cui-fg-warning);
  }
  h2 {
    font-size: var(--cui-headline-s-font-size);
    margin-bottom: var(--cui-spacings-byte);
  }
</style>
