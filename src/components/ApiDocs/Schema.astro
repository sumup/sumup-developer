---
import { resolveSchema } from "@lib/openapi";
import { Headline } from "@sumup-oss/circuit-ui";
import { ChevronDown, Close } from "@sumup-oss/icons";
import type { OpenAPIV3_1 } from "openapi-types";
import Attributes from "./Attributes.astro";
import ParameterName from "./ParameterName.astro";
import SchemaPropertyRow from "./SchemaPropertyRow.astro";
import SectionHeading from "./SectionHeading.astro";
import { getRenderableAttributesSchema } from "./schemaUtils";

export interface Props {
  kind: string;
  title?: string;
  schema: OpenAPIV3_1.SchemaObject | OpenAPIV3_1.ReferenceObject;
  nested?: boolean;
  collapsable?: boolean;
  collapsed?: boolean;
}

const {
  kind,
  title,
  schema: obj,
  nested,
  collapsable,
  collapsed,
} = Astro.props;

const schema = resolveSchema(obj);
---

<div
  class:list={["schema", { nested, collapsable, collapsed }]}
  data-pagefind-ignore
>
  {
    nested && (
      <div class="header">
        <div class="close">
          <Close size="16" />
          &nbsp;Close
        </div>
        <div>{schema.title || kind}</div>
        <div />
      </div>
    )
  }
  {
    collapsable && (
      <div class="header">
        <div class="icon">
          <ChevronDown size="16" />
        </div>
        <Headline as="h3">{schema.title || kind}</Headline>
      </div>
    )
  }
  {title && <SectionHeading>{title}</SectionHeading>}
  {
    schema.type === "array" &&
      "items" in schema &&
      (() => {
        const attributesSchema = getRenderableAttributesSchema(schema.items);

        return (
          <div>
            <ParameterName name={""} def={schema} required={false} />
            {attributesSchema && (
              <Attributes schema={attributesSchema} kind={"Attributes"} />
            )}
          </div>
        );
      })()
  }
  <ul class:list={[{ nested }]}>
    {
      Object.entries(schema.properties || {}).map(([name, def]) => {
        return (
          <SchemaPropertyRow
            name={name}
            def={def}
            required={!!schema.required?.includes(name)}
          />
        );
      })
    }
  </ul>
</div>

<style>
  :global(.schema p) {
    margin-bottom: var(--cui-spacings-bit);
  }

  .schema {
    margin-bottom: var(--cui-spacings-giga);
  }
  .schema.nested {
    margin-bottom: 0;
  }

  .collapsable > .header {
    display: flex;
    flex-direction: row;
    align-items: center;
    cursor: pointer;
  }
  .collapsable > .header .icon {
    padding-top: var(--cui-spacings-bit);
    width: var(--cui-spacings-giga);
    display: flex;
    align-items: center;
    justify-content: baseline;
  }
  .collapsable > .header .icon :global(svg) {
    transition: 0.1s ease-in-out;
  }
  .collapsable > .header :global(h3) {
    width: 100%;
  }
  .collapsable.collapsed {
    margin-bottom: 0;
  }
  .collapsable.collapsed ul {
    display: none;
  }
  .collapsable.collapsed > .header :global(h3) {
    border: none;
  }
  .collapsable.collapsed :global(.icon svg) {
    transform: rotate(-90deg);
  }
  .collapsable .icon.open {
    display: none;
  }
  .collapsable > .icon.close {
    display: block;
  }

  .nested > .header {
    border-bottom: var(--cui-border-width-kilo) solid var(--cui-border-subtle);
    padding: var(--cui-spacings-bit) var(--cui-spacings-byte);
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--cui-spacings-byte);
    justify-items: center;
    justify-content: space-between;
  }

  .nested > .header .close {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-self: start;
    cursor: pointer;
    color: var(--cui-fg-subtle);
  }

  .nested > .header .close:hover {
    color: var(--cui-fg-subtle-hovered);
  }

  .body {
    margin-bottom: var(--cui-spacings-kilo);
  }

  ul {
    list-style: none;
    padding: 0;
  }
  ul.nested {
    margin: 0 var(--cui-spacings-mega);
  }

  ul li {
    width: 100%;
    padding: var(--cui-spacings-kilo) 0;
  }
  ul li:last-child {
    border-bottom: none;
  }
  h3 {
    margin-top: var(--cui-spacings-mega);
    padding-bottom: var(--cui-spacings-byte);
    border-bottom: var(--cui-border-width-kilo) solid var(--cui-border-subtle);
    font-size: 1rem;
  }
</style>

<script>
  const buttons = document.querySelectorAll(".nested .close");
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const grandParentElement = button.closest(".open");
      grandParentElement?.classList.remove("open");
    });
  });

  const chevrons = document.querySelectorAll(".collapsable .header");
  chevrons.forEach((chevron) => {
    chevron.addEventListener("click", () => {
      chevron.parentElement?.classList.toggle("collapsed");
    });
  });
</script>
