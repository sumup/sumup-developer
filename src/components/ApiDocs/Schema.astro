---
import type { ApiFieldView, ApiUnionView } from "@cloudflare/nimbus-docs/api";
import MarkdownContent from "@components/MarkdownContent.astro";
import SectionHeading from "./SectionHeading.astro";
import SchemaPropertyRow from "./SchemaPropertyRow.astro";
import Union from "./Union.astro";
import { isExpandable } from "./schemaUtils";
interface Props {
  fields: ApiFieldView[];
  title?: string;
  anchor?: string;
  union?: ApiUnionView;
  nested?: boolean;
  mediaType?: string;
  required?: boolean;
  descriptionHtml?: string;
  truncated?: { total: number };
}
const {
  fields,
  title,
  anchor,
  union,
  nested = false,
  mediaType,
  required,
  descriptionHtml,
  truncated,
} = Astro.props;
const expandable = Boolean(union || fields.some(isExpandable));
---

<section
  id={anchor}
  class:list={["schema", nested && "nested"]}
  data-api-fields={nested ? undefined : ""}
>
  {(title ||
    mediaType ||
    required !== undefined ||
    (expandable && !nested)) && (
    <div class="schema-heading">
      {title && <SectionHeading as="h2">{title}</SectionHeading>}
      {mediaType && <code class="media-type">{mediaType}</code>}
      {required !== undefined && (
        <span class="requirement">{required ? "required" : "optional"}</span>
      )}
      {expandable && !nested && (
        <button
          type="button"
          hidden
          data-api-toggle-all
          data-nb-expanded="false"
        >
          <span class="expand-label">Expand all</span>
          <span class="collapse-label">Collapse all</span>
        </button>
      )}
    </div>
  )}
  {descriptionHtml && <MarkdownContent set:html={descriptionHtml} />}
  {union ? (
    <Union union={union} />
  ) : (
    <ul class="properties">
      {fields.map((field) => (
        <SchemaPropertyRow field={field} />
      ))}
    </ul>
  )}
  {truncated && truncated.total > fields.length && (
    <p>{truncated.total - fields.length} additional properties omitted.</p>
  )}
  <slot />
</section>
<script>
  import "./fields.client";
</script>
<style>
  .schema {
    min-width: 0;
    scroll-margin-top: calc(var(--portal-header-height) + 1.5rem);
  }
  .schema-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--cui-spacings-byte);
    margin-bottom: var(--cui-spacings-byte);
    padding-bottom: var(--cui-spacings-byte);
    border-bottom: 1px solid var(--cui-border-subtle);
  }
  .schema-heading :global(h2) {
    margin: 0;
    font-size: var(--cui-headline-s-font-size);
  }
  .properties {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .media-type,
  .requirement {
    font-size: var(--cui-body-s-font-size);
    color: var(--cui-fg-subtle);
    overflow-wrap: anywhere;
  }
  .media-type {
    font-size: var(--portal-font-size-mono);
  }
  button {
    margin-inline-start: auto;
    padding: var(--cui-spacings-bit) var(--cui-spacings-byte);
    border: 1px solid var(--cui-border-normal);
    border-radius: var(--cui-border-radius-byte);
    color: var(--cui-fg-normal);
    background: var(--cui-bg-normal);
    font: inherit;
    font-size: var(--cui-body-s-font-size);
    cursor: pointer;
  }
  button:hover {
    background: var(--cui-bg-normal-hovered);
  }
  .collapse-label,
  [data-nb-expanded="true"] .expand-label {
    display: none;
  }
  [data-nb-expanded="true"] .collapse-label {
    display: inline;
  }
</style>
