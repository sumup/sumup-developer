---
import CodeGroup from "@components/Code/CodeGroup.astro";
import CodeGroupItem from "@components/Code/CodeGroupItem.astro";
import Code from "@components/Code/Code.astro";
import { getJavaSdkVersion } from "@lib/sdks/javaSdkVersion";
import { javaInstallExamples } from "@lib/sdks/javaInstallExamples";
const examples = javaInstallExamples(await getJavaSdkVersion());
---

<CodeGroup title="Install the Java SDK">
  {examples.map(({ label, language, code }) => (
    <CodeGroupItem label={label}>
      <Code lang={language} code={code} />
    </CodeGroupItem>
  ))}
</CodeGroup>
