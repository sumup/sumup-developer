---
const { src, controls = true, autoplay = true, loop = true } = Astro.props;
---

<style>
  .video-container {
    display: flex;
    justify-content: center; /* centers horizontally */
    /* optionally to center vertically as well: */
    /* align-items: center; */
  }
  video {
    max-width: 400px;
    height: auto;
  }
</style>

<div class="video-container">
  <video
    controls={controls}
    autoplay={autoplay}
    loop={loop}
  >
    <source src={src} type="video/mp4" />
    Your browser does not support the video tag.
  </video>
</div>
