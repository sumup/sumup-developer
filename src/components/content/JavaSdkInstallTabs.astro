---
import { Tabs, TabItem } from "@astrojs/starlight/components";
import { CodeBlock } from "@components/Code";
import { getJavaSdkVersion } from "@lib/sdks/javaSdkVersion";

const javaSdkVersion = await getJavaSdkVersion();
---

<Tabs>
  <TabItem label="Gradle (Kotlin DSL)">
    <CodeBlock
      language="kotlin"
      code={`dependencies {
    implementation("com.sumup:sumup-sdk:${javaSdkVersion}")
}`}
    />
  </TabItem>
  <TabItem label="Gradle (Groovy)">
    <CodeBlock
      language="groovy"
      code={`dependencies {
    implementation 'com.sumup:sumup-sdk:${javaSdkVersion}'
}`}
    />
  </TabItem>
  <TabItem label="Maven">
    <CodeBlock
      language="xml"
      code={`<dependency>
  <groupId>com.sumup</groupId>
  <artifactId>sumup-sdk</artifactId>
  <version>${javaSdkVersion}</version>
</dependency>`}
    />
  </TabItem>
</Tabs>

