---
import { getIconURL, type IconName } from "@sumup-oss/icons";
import countryData from "../../data/merchant-country-data.json";

interface Props {
  countries: string[];
}

const { countries } = Astro.props;

const countryNameByCode = new Map(
  countryData.countries.map((country) => [
    country.isoCode,
    country.displayName,
  ]),
);
---

<span class="country-list">
  {
    countries.map((code) => {
      const icon = `flag_${code.toLowerCase()}` as IconName;
      const name = countryNameByCode.get(code) ?? code;

      return (
        <span class="country-pill">
          <img
            class="country-flag"
            src={getIconURL(icon)}
            alt=""
            aria-hidden="true"
          />
          <span>{name}</span>
        </span>
      );
    })
  }
</span>

<style>
  .country-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    vertical-align: middle;
  }

  .country-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--cui-border-subtle);
    border-radius: 999px;
    background: var(--sl-color-gray-7);
    font-size: var(--cui-body-s-font-size);
    line-height: 1.4;
  }

  .country-flag {
    width: 1rem;
    height: 1rem;
    display: block;
    flex: 0 0 auto;
  }
</style>
