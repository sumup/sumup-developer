---

---

<div class="container not-content">
  <div class="inner">
    <div class="note">
      You can experience the Payment Widget's functionality by using the
      interactive demo below (no real charges will occur)
    </div>
    <div class="widget">
      <div id="sumup-card"></div>
    </div>
  </div>
</div>

<script>
  declare global {
    const SumUpCard: {
      mount: (options: {
        checkoutId: string;
        onResponse: (type: string) => void;
      }) => void;
    };
  }

  const appendScript = (scriptToAppend: string, onLoad: () => void) => {
    const existingScript = document.querySelector<HTMLScriptElement>(
      `script[src="${scriptToAppend}"]`,
    );
    if (existingScript) {
      existingScript.addEventListener("load", onLoad, { once: true });
      return;
    }

    const script = document.createElement("script");
    script.async = false;
    script.onload = onLoad;
    script.src = scriptToAppend;
    document.body.appendChild(script);
  };

  const initSumupCardWidget = () => {
    const target = document.querySelector<HTMLElement>("#sumup-card");
    if (
      target &&
      !target.dataset.initialized &&
      typeof SumUpCard !== "undefined"
    ) {
      target.dataset.initialized = "true";
      SumUpCard.mount({
        checkoutId: "demo",
        onResponse(type) {
          if (type === "success") {
            alert("[DEMO] Transaction is successful!");
          }
        },
      });
    }
  };

  const initCardWidget = () => {
    if (!document.querySelector("#sumup-card")) return;
    if (typeof SumUpCard !== "undefined") {
      initSumupCardWidget();
      return;
    }

    appendScript(
      "https://gateway.sumup.com/gateway/ecom/card/v2/sdk.js",
      initSumupCardWidget,
    );
  };

  initCardWidget();
  document.addEventListener("astro:page-load", initCardWidget);
</script>

<style>
  .container {
    background-color: #fafbfc;
    border-radius: 4px;
  }

  .inner {
    max-width: 450px;
    padding: 20px 10px 40px;
    margin: 0 auto;
  }

  .note {
    margin-bottom: 20px;
    font-size: 13px;
    text-align: center;
  }

  .widget {
    background-color: #fff;
    border-radius: 4px;
    box-shadow:
      rgb(12 15 20 / 2%) 0 0 0 1px,
      rgb(12 15 20 / 6%) 0 0 1px 0,
      rgb(12 15 20 / 6%) 0 2px 2px 0;
  }
</style>
