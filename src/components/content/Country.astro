---
import { getIconURL, type FlagProps } from "@sumup-oss/icons";

interface Props {
  code: FlagProps["countryCode"];
  name: string;
}

const { code, name } = Astro.props;
const countryCode = code.toLowerCase() as Lowercase<Props["code"]>;
---

<span class="country">
  <img
    src={getIconURL(`flag_${countryCode}`, "480")}
    alt={name}
    width="16"
    height="12"
  />
</span>

<style>
  .country {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--cui-icon-sizes-s);
    aspect-ratio: 1;
    vertical-align: middle;
    margin-right: var(--cui-spacings-bit);
  }

  .country img {
    width: var(--cui-icon-sizes-s);
    height: calc(var(--cui-icon-sizes-s) * 3 / 4);
    margin: 0;
    border: 0.5px solid #ccc;
    border-radius: 2px;
  }
</style>
