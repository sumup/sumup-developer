---
const { alt, src, srcset, width, height } = Astro.props;
---

<div class="reader-hero">
  <img
    src={src}
    srcset={srcset}
    sizes="(max-width: 50rem) 100vw, 50rem"
    alt={alt}
    width={width}
    height={height}
  />
</div>

<style>
  .reader-hero {
    margin: var(--cui-spacings-giga) 0;
    text-align: center;
  }

  .reader-hero img {
    display: inline-block;
    width: auto;
    max-width: min(100%, 32rem);
    max-height: 20rem;
    height: auto;
    margin: 0;
  }
</style>
