---
import { Code as Default } from "@astrojs/starlight/components";
import { Checkmark, Copy } from "@sumup-oss/icons";
import type { ExpressiveCodeBlockOptions } from "expressive-code";
import type { HTMLAttributes } from "astro/types";
import IconButton from "./IconButton.astro";

export type Props = HTMLAttributes<"div"> &
  Omit<ExpressiveCodeBlockOptions, "code" | "language"> & {
    title?: string;
    code?: string;
    language?: string;
    copy?: boolean;
  };

const {
  code,
  language,
  title,
  meta = `"$SUMUP_API_KEY" "SUMUP_API_KEY"`,
  copy = false,
  class: cls,
  ...props
} = Astro.props;
---

<div class:list={["codeblock", cls]} {...props}>
  <div class="header">
    <slot name="title">
      {title && <div class="name">{title}</div>}
    </slot>
    <div class="options">
      <slot name="extra-options" />
      {
        copy && (
          <IconButton class="copy-code-btn">
            <Copy className="copy" />
            <Checkmark className="checkmark" />
          </IconButton>
        )
      }
    </div>
  </div>
  <slot name="code">
    {code && language && <Default lang={language} code={code} meta={meta} />}
  </slot>
</div>

<script>
  async function clickHandler(event: Event) {
    const button = event.currentTarget as HTMLButtonElement;
    const wrap = button.closest(".codeblock")!;
    const target = wrap.querySelector(".active.code")! as HTMLElement;
    const dataset = target.dataset as { code: string; copied: string };
    const code = dataset.code.replace(/\u007f/g, "\n");
    try {
      await navigator.clipboard.writeText(code);
    } catch (err) {
      //  TODO
    }

    button.classList.add("copied");
    setTimeout(() => {
      button.classList.remove("copied");
    }, 2000);
  }

  function initButtons(container: ParentNode | Document) {
    container
      .querySelectorAll?.(".copy-code-btn")
      .forEach((btn) => btn.addEventListener("click", clickHandler));
  }

  document.addEventListener("DOMContentLoaded", () => {
    initButtons(document);
  });

  // Also re-initialize all buttons after view transitions initiated by popular frameworks
  document.addEventListener("astro:page-load", () => {
    initButtons(document);
  });
</script>

<style>
  :global(.expressive-code code) {
    white-space: pre;
  }

  :global(.expressive-code pre) {
    max-height: min(68vh, 1000px) !important;
    scrollbar-width: thin !important;
  }

  .codeblock {
    font-size: 0.8rem;
    font-family: var(--cui-font-stack-mono);
    background: var(--cui-bg-subtle);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-self: start;
    border: var(--cui-border-width-kilo) solid var(--cui-border-subtle);
    border-radius: var(--cui-border-radius-byte);
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--cui-spacings-bit) var(--cui-spacings-byte)
      var(--cui-spacings-bit) var(--cui-spacings-kilo);
    border-bottom: var(--cui-border-width-kilo) solid var(--cui-border-subtle);
  }

  .options {
    display: flex;
    flex-direction: row;
    gap: var(--cui-spacings-byte);
  }

  .description {
    color: var(--ec-frm-trmTtbFg);
    padding: var(--cui-spacings-byte) var(--cui-spacings-kilo);
  }

  .code {
    background: var(--cui-bg-subtle);
    overflow: auto;
    display: none;
  }

  .code.active {
    display: block;
  }

  button {
    appearance: none;
    color: var(--cui-fg-subtle);
  }

  :global(.copy-code-btn) .copy {
    display: block;
  }
  :global(.copy-code-btn) .checkmark {
    display: none;
  }
  :global(.copy-code-btn.copied) .copy {
    display: none;
  }
  :global(.copy-code-btn.copied) .checkmark {
    display: block;
  }
</style>
