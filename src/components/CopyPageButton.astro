---
import { Icon } from "@astrojs/starlight/components";
import Copy from "@sumup-oss/icons/copy_24.svg";
import Checkmark from "@sumup-oss/icons/checkmark_24.svg";

const currentPath = Astro.url.pathname.replace(/\/$/, "");
const currentUrl = Astro.url.href.replace(/\/$/, "/index.md");
const encodedPrompt = encodeURIComponent(
  `Read ${currentUrl}. I want to ask questions about it.`,
);
---

<div class="dropdown">
  <button
    class="combo-button"
    id="page-action"
    data-path={currentPath}
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="Copy Markdown or open more page actions"
    aria-controls="dropdown-menu"
  >
    <span class="button-content">
      <Copy name="mdx" class="icon-default" width="18px" height="18px" />
      <Checkmark
        name="approve-check"
        class="icon-success"
        width="18px"
        height="18px"
      />
      <span>Copy Markdown</span>
    </span>
    <span class="dropdown-toggle" aria-hidden="true">
      <Icon name="down-caret" size="1rem" />
    </span>
  </button>

  <div id="dropdown-menu" role="menu" aria-labelledby="page-action">
    <a
      href={`https://chatgpt.com/?q=${encodedPrompt}`}
      class="dropdown-item"
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
      aria-label={`Open in ChatGPT (opens in a new tab)`}
    >
      <svg
        name="external"
        class="external-icon"
        width="18px"
        height="18px"
        xmlns="http://www.w3.org/2000/svg"
        width="100"
        height="100"
        fill="currentColor"
        viewBox="0 0 100 100"
        class="h-[20px] w-[20px]"
        ><path
          color="currentColor"
          d="M38.355 36.52v-9.415c0-.793.297-1.388.99-1.784l18.93-10.902c2.578-1.486 5.65-2.18 8.82-2.18 11.894 0 19.426 9.218 19.426 19.029 0 .694 0 1.486-.1 2.28L66.799 22.05c-1.189-.694-2.379-.694-3.568 0L38.355 36.52Zm44.202 36.67V50.694c0-1.388-.596-2.38-1.785-3.073L55.897 33.15l8.126-4.658c.694-.396 1.289-.396 1.982 0l18.93 10.902c5.452 3.172 9.118 9.91 9.118 16.452 0 7.531-4.46 14.47-11.496 17.344Zm-50.05-19.82-8.127-4.757c-.693-.396-.99-.99-.99-1.784V25.025c0-10.605 8.126-18.633 19.127-18.633 4.163 0 8.028 1.388 11.3 3.865l-19.525 11.3c-1.189.693-1.784 1.684-1.784 3.072v28.74ZM50 63.478l-11.645-6.541V43.062L50 36.522l11.645 6.54v13.875L50 63.477Zm7.483 30.129c-4.163 0-8.028-1.388-11.3-3.865l19.525-11.3c1.189-.693 1.784-1.684 1.784-3.071V46.629l8.226 4.757c.694.396.991.991.991 1.784v21.803c0 10.605-8.226 18.633-19.226 18.633v.001Zm-23.49-22.101-18.93-10.902c-5.45-3.172-9.117-9.91-9.117-16.451 0-7.632 4.559-14.47 11.595-17.344v22.596c0 1.388.595 2.379 1.784 3.072l24.777 14.37-8.126 4.659c-.694.396-1.289.396-1.982 0ZM32.905 87.76c-11.2 0-19.425-8.425-19.425-18.83 0-.794.1-1.587.198-2.38L33.2 77.85c1.189.693 2.379.693 3.568 0l24.876-14.37v9.415c0 .793-.298 1.388-.992 1.784L41.724 85.58c-2.576 1.486-5.649 2.18-8.82 2.18h.001Zm24.579 11.793c11.992 0 22.001-8.523 24.281-19.822C92.864 76.857 100 66.451 100 55.846c0-6.937-2.973-13.676-8.325-18.533.496-2.081.793-4.163.793-6.243 0-14.172-11.496-24.777-24.777-24.777-2.676 0-5.253.396-7.83 1.288C55.401 3.221 49.257.445 42.517.445c-11.992 0-22.001 8.523-24.281 19.822C7.136 23.14 0 33.547 0 44.152c0 6.938 2.973 13.676 8.325 18.533-.496 2.081-.793 4.163-.793 6.243 0 14.172 11.497 24.778 24.777 24.778 2.676 0 5.253-.397 7.83-1.289 4.459 4.36 10.604 7.136 17.344 7.136Z"
        ></path></svg
      >
      <span>Open in ChatGPT</span>
    </a>
    <a
      href={`https://claude.ai/new?q=${encodedPrompt}`}
      class="dropdown-item"
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
      aria-label={`Open in Claude (opens in a new tab)`}
    >
      <svg
        name="external"
        class="external-icon"
        width="18px"
        height="18px"
        viewBox="0 0 12 12"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        ><g clip-path="url(#clip0_2002_2)"
          ><path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M2.3545 7.9775L4.7145 6.654L4.7545 6.539L4.7145 6.475H4.6L4.205 6.451L2.856 6.4145L1.6865 6.366L0.5535 6.305L0.268 6.2445L0 5.892L0.0275 5.716L0.2675 5.5555L0.6105 5.5855L1.3705 5.637L2.5095 5.716L3.3355 5.7645L4.56 5.892H4.7545L4.782 5.8135L4.715 5.7645L4.6635 5.716L3.4845 4.918L2.2085 4.074L1.5405 3.588L1.1785 3.3425L0.9965 3.1115L0.9175 2.6075L1.2455 2.2465L1.686 2.2765L1.7985 2.307L2.245 2.65L3.199 3.388L4.4445 4.3045L4.627 4.4565L4.6995 4.405L4.709 4.3685L4.627 4.2315L3.9495 3.0085L3.2265 1.7635L2.9045 1.2475L2.8195 0.938C2.78711 0.819128 2.76965 0.696687 2.7675 0.5735L3.1415 0.067L3.348 0L3.846 0.067L4.056 0.249L4.366 0.956L4.867 2.0705L5.6445 3.5855L5.8725 4.0345L5.994 4.4505L6.0395 4.578H6.1185V4.505L6.1825 3.652L6.301 2.6045L6.416 1.257L6.456 0.877L6.644 0.422L7.0175 0.176L7.3095 0.316L7.5495 0.6585L7.516 0.8805L7.373 1.806L7.0935 3.2575L6.9115 4.2285H7.0175L7.139 4.1075L7.6315 3.4545L8.4575 2.4225L8.8225 2.0125L9.2475 1.5605L9.521 1.345H10.0375L10.4175 1.9095L10.2475 2.4925L9.7155 3.166L9.275 3.737L8.643 4.587L8.248 5.267L8.2845 5.322L8.3785 5.312L9.8065 5.009L10.578 4.869L11.4985 4.7115L11.915 4.9055L11.9605 5.103L11.7965 5.5065L10.812 5.7495L9.6575 5.9805L7.938 6.387L7.917 6.402L7.9415 6.4325L8.716 6.5055L9.047 6.5235H9.858L11.368 6.636L11.763 6.897L12 7.216L11.9605 7.4585L11.353 7.7685L10.533 7.574L8.6185 7.119L7.9625 6.9545H7.8715V7.0095L8.418 7.5435L9.421 8.4485L10.6755 9.6135L10.739 9.9025L10.578 10.13L10.408 10.1055L9.3055 9.277L8.88 8.9035L7.917 8.0935H7.853V8.1785L8.075 8.503L9.2475 10.2635L9.3085 10.8035L9.2235 10.98L8.9195 11.0865L8.5855 11.0255L7.8985 10.063L7.191 8.9795L6.6195 8.008L6.5495 8.048L6.2125 11.675L6.0545 11.86L5.69 12L5.3865 11.7695L5.2255 11.396L5.3865 10.658L5.581 9.696L5.7385 8.931L5.8815 7.981L5.9665 7.665L5.9605 7.644L5.8905 7.653L5.1735 8.6365L4.0835 10.109L3.2205 11.0315L3.0135 11.1135L2.655 10.9285L2.6885 10.5975L2.889 10.303L4.083 8.785L4.803 7.844L5.268 7.301L5.265 7.222H5.2375L2.066 9.28L1.501 9.353L1.2575 9.125L1.288 8.752L1.4035 8.6305L2.3575 7.9745L2.3545 7.9775Z"
            fill="currentColor"></path></g
        ><defs
          ><clipPath id="clip0_2002_2"
            ><rect width="12" height="12" fill="white"></rect></clipPath
          ></defs
        ></svg
      >
      <span>Open in Claude</span>
    </a>
    <a
      href={`${currentPath}/index.md`}
      class="dropdown-item"
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
      aria-label={`View in Markdown (opens in a new tab)`}
    >
      <svg
        name="external"
        class="external-icon"
        width="18px"
        height="18px"
        viewBox="0 0 208 128"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        fill="currentColor"
        class="h-[20px] w-[20px]"
        ><g
          ><path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M15 10a5 5 0 0 0-5 5v98a5 5 0 0 0 5 5h178a5 5 0 0 0 5-5V15a5 5 0 0 0-5-5zM0 15A15 15 0 0 1 15 0h178a15 15 0 0 1 15 15v98a15 15 0 0 1-15 15H15a15 15 0 0 1-15-15z"
          ></path><path
            d="M30 98V30h20l20 25 20-25h20v68H90V59L70 84 50 59v39zm125 0-30-33h20V30h20v35h20z"
          ></path></g
        ></svg
      >
      <span>View in Markdown</span>
    </a>
  </div>
</div>

<style>
  .combo-button {
    background-color: var(--cui-bg-normal);
    color: var(--cui-fg-normal);
    border: 1px solid var(--cui-border-normal);
    border-radius: var(--cui-border-radius-byte);
    font-size: 0.875rem;
    cursor: pointer;
    display: inline-flex;
    align-items: stretch;
    height: 2rem;
    padding: 0;
    overflow: hidden;
  }

  .combo-button:disabled {
    opacity: 0.7;
  }

  .button-content {
    display: inline-flex;
    align-items: center;
    gap: var(--cui-spacings-byte);
    padding: var(--cui-spacings-bit) var(--cui-spacings-kilo)
      var(--cui-spacings-bit) var(--cui-spacings-byte);
    line-height: 1;
  }

  .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--cui-spacings-byte);
    border-left: 1px solid var(--cui-border-normal);
  }

  .icon-success {
    display: none;
  }

  #page-action.copied .icon-default {
    display: none;
  }

  #page-action.copied .icon-success {
    display: inline-block;
  }

  .dropdown {
    display: inline-block;
    position: relative;
  }

  #dropdown-menu {
    position: absolute;
    top: calc(100% + var(--cui-spacings-byte));
    right: 0;
    background-color: var(--cui-bg-normal);
    border: 1px solid var(--cui-border-normal);
    border-radius: var(--cui-border-radius-byte);
    padding: var(--cui-spacings-bit);
    min-width: 200px;
    display: none;
    z-index: 10;
  }

  #dropdown-menu.show {
    display: block;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: var(--cui-spacings-kilo);
    padding: var(--cui-spacings-bit) var(--cui-spacings-kilo)
      var(--cui-spacings-bit) var(--cui-spacings-byte);
    color: var(--cui-fg-normal);
    text-decoration: none;
    border-radius: var(--cui-border-radius-bit);
    font-size: 0.875rem;
    transition: background-color 0.15s ease;
    cursor: pointer;
  }

  .dropdown-item:hover {
    background-color: var(--cui-bg-normal-hovered);
  }

  .dropdown-item span {
    flex: 1;
  }

  .dropdown-item .external-icon {
    margin-left: auto;
  }
</style>

<script>
  const initPageActions = () => {
    const comboButton = document.querySelector(
      "#page-action",
    ) as HTMLButtonElement;
    const dropdownMenu = document.querySelector(
      "#dropdown-menu",
    ) as HTMLElement;

    if (!comboButton || !dropdownMenu || comboButton.dataset.initialized) {
      return;
    }
    comboButton.dataset.initialized = "true";

    comboButton.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement;

      if (target.closest(".dropdown-toggle")) {
        event.stopPropagation();
        const newState = !dropdownMenu.classList.contains("show");
        dropdownMenu.classList.toggle("show");
        comboButton.setAttribute("aria-expanded", newState ? "true" : "false");
        return;
      }

      try {
        comboButton.disabled = true;

        const currentPath = comboButton.dataset.path;
        const mdPath = `${currentPath}/index.md`;

        const res = await fetch(mdPath);
        const contentForClipboard = await res.text();

        await navigator.clipboard.writeText(contentForClipboard);

        comboButton.classList.add("copied");

        setTimeout(() => {
          comboButton.classList.remove("copied");
        }, 3000);
      } catch (error) {
        console.log(error);
      } finally {
        comboButton.disabled = false;
      }
    });

    dropdownMenu.addEventListener("click", (event) => {
      event.stopPropagation();
    });
  };

  document.addEventListener("click", () => {
    const comboButton = document.querySelector(
      "#page-action",
    ) as HTMLButtonElement;
    const dropdownMenu = document.querySelector(
      "#dropdown-menu",
    ) as HTMLElement;
    dropdownMenu?.classList.remove("show");
    comboButton?.setAttribute("aria-expanded", "false");
  });

  initPageActions();
  document.addEventListener("astro:page-load", initPageActions);
</script>
