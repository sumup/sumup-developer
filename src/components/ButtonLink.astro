---
import Icon from "./Icon.astro";
import ArrowRight from "@sumup-oss/icons/arrow_right_16.svg";

type Props = {
  icon: string;
  href: string;
  title: string;
  description: string;
};

const { icon, href, title, description } = Astro.props;
---

<a class="button-link" href={href}>
  <Icon icon={icon} />
  <div>
    <div class="button-title">
      {title}<ArrowRight />
    </div>
    <div class="button-description">
      {description}
    </div>
  </div>
</a>

<style>
  .button-link {
    text-decoration: none;
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: var(--cui-spacings-mega);
    align-items: center;
    cursor: pointer;
    border-radius: var(--cui-border-radius-byte);
    padding: var(--cui-spacings-kilo);
    min-height: 5rem;
  }

  .button-link > :global(svg) {
    color: var(--cui-fg-normal);
    width: 24px;
    height: 24px;
  }

  .button-link:hover {
    text-decoration: none;
    background-color: var(--cui-bg-normal-hovered);
  }

  .button-title {
    color: var(--cui-fg-normal);
    font-weight: var(--cui-font-weight-bold);
    display: flex;
    align-items: center;
    gap: var(--cui-spacings-byte);
  }

  .button-title :global(svg) {
    display: none;
    width: 12px;
    height: 12px;
  }

  .button-link:hover .button-title :global(svg) {
    display: block;
  }

  .button-description {
    color: var(--cui-fg-subtle);
    font-size: var(--cui-body-s-font-size);
    line-height: var(--cui-body-s-line-height);
  }
</style>
