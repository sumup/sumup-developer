---
import CodeBlock from "./CodeBlock.astro";
import CodeLangSelector from "./CodeLangSelector.astro";
import CodeBlockHeader from "./CodeBlockHeader.astro";
import Code from "./Code.astro";

export interface Props {
  class?: string;
  name?: string;
  title?: string;
  isLanguageSelect?: boolean;
  meta?: string;
  options: {
    label: string;
    code: string;
    lang: string;
    meta?: string;
  }[];
}

const {
  options = [],
  name,
  title,
  meta = `"$SUMUP_API_KEY" "SUMUP_API_KEY"`,
  isLanguageSelect = false,
  class: cn,
  ...props
} = Astro.props as Props;

const resolvedTitle = title ?? name;
const defaultOption = options[0]?.label;
const enableSelector = isLanguageSelect && options.length > 1;
const selectorOptions = options.map(({ label }) => ({ label }));
---

<CodeBlock class:list={[isLanguageSelect && "multi-lang", cn]} {...props}>
  <CodeBlockHeader slot="header">
    <slot slot="left" name="left">
      {resolvedTitle && <div class="name">{resolvedTitle}</div>}
    </slot>
    {
      enableSelector && (
        <CodeLangSelector slot="right" options={selectorOptions} />
      )
    }
  </CodeBlockHeader>
  <div slot="code">
    {
      options.map(({ lang, code, label, meta: optionMeta }) => (
        <div
          class:list={["code", label === defaultOption ? "active" : ""]}
          data-lang={label}
        >
          <Code lang={lang} code={code} meta={optionMeta ?? meta} />
        </div>
      ))
    }
  </div>
</CodeBlock>

<style>
  .code {
    min-width: 0;
    overflow: auto;
    display: none;
  }

  .code.active {
    display: block;
  }
</style>
