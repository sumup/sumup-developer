---
// Code component wrapper that renders custom header for switching
// between code variants. Could be implemented as a plugin for
// Expressive Code, but that's a bit of work:
// https://expressive-code.com/guides/developing-plugins/
// If attempted, inspiration can be taken from:
// https://github.com/expressive-code/expressive-code/tree/main/packages/@expressive-code/plugin-frames
import { Code as Default } from "@astrojs/starlight/components";
import CodeBlock from "./CodeBlock.astro";
import CodeLangSelector from "./CodeLangSelector.astro";

interface Props {
  class?: string;
  name?: string;
  isLanguageSelect?: boolean;
  options: {
    label: string;
    value?: string;
    code: string;
    lang: string;
    meta?: string;
  }[];
}

const {
  options,
  name,
  isLanguageSelect = false,
  class: cn,
  ...props
} = Astro.props;

const defaultOption = options[0].label;
---

<CodeBlock
  class:list={[isLanguageSelect && "multi-lang", cn]}
  withCopyButton
  {...props}
>
  <slot name="header" slot="header">
    <div slot="title">
      <slot name="title">
        <div class="name">{name}</div>
      </slot>
    </div>
    <CodeLangSelector slot="extra-options" options={options} />
  </slot>
  <div slot="code">
    {
      options.map(({ lang, code, label, value, meta }) => (
        <div
          class:list={["code", label === defaultOption ? "active" : ""]}
          data-lang={value || label.toLowerCase()}
          data-code={code.replace(/\n/g, "\u007f")}
        >
          <Default lang={lang} code={code} meta={meta} />
        </div>
      ))
    }
  </div>
</CodeBlock>

<script>
  import { setCurrentLanguage } from "@lib/code";

  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".langSelector")?.forEach((s) => {
      s.addEventListener("change", (e) => {
        const target = e.target as HTMLSelectElement;
        setCurrentLanguage(target.value);
      });
    });

    for (const mc of document.querySelectorAll(".codeblock")) {
      const blocks = mc.querySelectorAll(".code");
      mc.querySelector(".codesSelector")?.addEventListener("change", (e) => {
        const target = e.target as HTMLSelectElement;
        blocks.forEach((b) => b.classList.remove("active"));
        mc.querySelector(`[data-lang="${target.value}"]`)?.classList.add(
          "active",
        );
      });
    }
  });
</script>

<style>
  .description {
    color: var(--cui-fg-subtle);
    padding: var(--cui-spacings-byte) var(--cui-spacings-kilo);
  }

  .code {
    overflow: auto;
    display: none;
  }

  .code.active {
    display: block;
  }
</style>
