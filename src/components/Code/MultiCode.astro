---
// Code component wrapper that renders custom header for switching
// between code variants. Could be implemented as a plugin for
// Expressive Code, but that's a bit of work:
// https://expressive-code.com/guides/developing-plugins/
// If attempted, inspiration can be taken from:
// https://github.com/expressive-code/expressive-code/tree/main/packages/@expressive-code/plugin-frames
import { Code as Default } from "@astrojs/starlight/components";
import CodeBlock from "./CodeBlock.astro";
import CodeLangSelector from "./CodeLangSelector";
import CopyButton from "./CopyButton.astro";
import CodeBlockHeader from "./CodeBlockHeader.astro";

interface Props {
  class?: string;
  name?: string;
  title?: string;
  isLanguageSelect?: boolean;
  options: {
    label: string;
    code: string;
    lang: string;
    meta?: string;
  }[];
}

const {
  options = [],
  name,
  title,
  isLanguageSelect = false,
  class: cn,
  ...props
} = Astro.props as Props;

const resolvedTitle = title ?? name;
const defaultOption = options[0]?.label;
const enableSelector = isLanguageSelect && options.length > 1;
const selectorOptions = options.map(({ label }) => ({ label }));
---

<CodeBlock class:list={[isLanguageSelect && "multi-lang", cn]} {...props}>
  <CodeBlockHeader slot="header">
    <slot slot="left" name="left">
      {resolvedTitle && <div class="name">{resolvedTitle}</div>}
    </slot>
    {
      enableSelector && (
        <CodeLangSelector slot="right" options={selectorOptions} client:load />
      )
    }
    <CopyButton slot="right" />
  </CodeBlockHeader>
  <div slot="code">
    {
      options.map(({ lang, code, label, meta }) => (
        <div
          class:list={["code", label === defaultOption ? "active" : ""]}
          data-lang={label}
          data-code={code.replace(/\n/g, "\u007f")}
        >
          <Default lang={lang} code={code} meta={meta} />
        </div>
      ))
    }
  </div>
</CodeBlock>

<style>
  .description {
    color: var(--cui-fg-subtle);
    padding: var(--cui-spacings-byte) var(--cui-spacings-kilo);
  }

  .code {
    overflow: auto;
    display: none;
  }

  .code.active {
    display: block;
  }
</style>
