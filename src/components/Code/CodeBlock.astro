---
import { Code as Default } from "@astrojs/starlight/components";
import type { ExpressiveCodeBlockOptions } from "expressive-code";
import type { HTMLAttributes } from "astro/types";
import CopyButton from "./CopyButton.astro";

export type Props = HTMLAttributes<"div"> &
  Omit<ExpressiveCodeBlockOptions, "code" | "language"> & {
    title?: string;
    code?: string;
    language?: string;
    withCopyButton?: boolean;
  };

const {
  code,
  language,
  title,
  meta = `"$SUMUP_API_KEY" "SUMUP_API_KEY"`,
  class: cls,
  ...props
} = Astro.props;
---

<div class:list={["codeblock", "not-content", cls]} {...props}>
  <slot name="header">
    {
      title && (
        <div class="header">
          <div class="name">{title}</div>
          <div class="options">
            <slot name="extra-options" />
            <CopyButton />
          </div>
        </div>
      )
    }
  </slot>
  <slot name="code">
    {
      code && language && (
        <div
          class:list={["code", "active"]}
          data-lang={language}
          data-code={code.replace(/\n/g, "\u007f")}
        >
          <Default lang={language} code={code} meta={meta} />
        </div>
      )
    }
  </slot>
  {!Astro.slots.has("header") && !title && <CopyButton float />}
</div>

<style>
  :global(.expressive-code code) {
    white-space: pre;
  }

  :global(.expressive-code pre) {
    max-height: min(68vh, 1000px) !important;
    scrollbar-width: thin !important;
  }

  .codeblock {
    position: relative;
    font-size: 0.8rem;
    font-family: var(--cui-font-stack-mono);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-self: start;
    border: var(--cui-border-width-kilo) solid var(--cui-border-subtle);
    border-radius: var(--cui-border-radius-byte);
    background-color: var(--cui-bg-subtle);
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--cui-spacings-bit) var(--cui-spacings-byte)
      var(--cui-spacings-bit) var(--cui-spacings-kilo);
    border-bottom: var(--cui-border-width-kilo) solid var(--cui-border-subtle);
    background: var(--cui-bg-subtle);
  }

  .options {
    display: flex;
    flex-direction: row;
    gap: var(--cui-spacings-byte);
  }

  .description {
    color: var(--ec-frm-trmTtbFg);
    padding: var(--cui-spacings-byte) var(--cui-spacings-kilo);
  }

  .code {
    overflow: auto;
  }

  .code.active {
    display: block;
  }

  button {
    appearance: none;
    color: var(--cui-fg-subtle);
  }

  :global(.copy-code-btn) .copy {
    display: block;
  }
  :global(.copy-code-btn) .checkmark {
    display: none;
  }

  :global(.copy-code-btn.copied) .copy {
    display: none;
  }
  :global(.copy-code-btn.copied) .checkmark {
    display: block;
  }
</style>
