---
import { codeThemes } from "../../lib/codeThemes";
import { Code as AstroCode } from "astro:components";
import { defaultCodeTransformers } from "@cloudflare/nimbus-docs/runtime";

type AstroCodeProps = Parameters<typeof AstroCode>[0];
// Generated API examples supply language names as strings.
export type Props = Omit<AstroCodeProps, "lang"> & { lang?: string };
const rawProps = Astro.props as Props;
const usesPortalThemes = !("theme" in rawProps) && !("themes" in rawProps);
const themed = usesPortalThemes
  ? {
      ...rawProps,
      themes: codeThemes,
      defaultColor: false,
    }
  : rawProps;
const props = {
  ...themed,
  transformers: defaultCodeTransformers({
    classTokens: false,
    beforeTitleTransformers: themed.transformers ?? [],
  }),
};
---

<AstroCode {...(props as AstroCodeProps)} />
