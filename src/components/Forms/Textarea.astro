---
const { name, label, ...props } = Astro.props;
---

<label for={name}>{label}</label>
<textarea id={name} name={name} {...props}> </textarea>

<style lang="scss">
  textarea {
    appearance: none;
    background-color: var(--cui-bg-normal);
    box-shadow: 0 0 0 1px var(--cui-border-normal);
    border: none;
    outline: 0;
    border-radius: 8px;
    padding: 12px 16px;
    transition:
      box-shadow 120ms ease-in-out,
      padding 120ms ease-in-out;
    width: 100%;
    margin: 0;
    vertical-align: top;
    overflow: auto;
    overflow-y: auto;
    resize: vertical;

    &:invalid:focus {
      box-shadow: 0 0 0 1px var(--cui-border-danger);
    }
  }
</style>
