---
const { name, label, hideLabel, class: cls, ...props } = Astro.props;
const hasPrefix = Astro.slots.has("prefix");
---

<label for={name} class:list={[{ hide: hideLabel }]}>{label}</label>
<div class="wrap">
  <slot name="prefix" />
  <input id={name} name={name} class:list={[{ hasPrefix }, cls]} {...props} />
</div>

<style lang="scss">
  label {
    display: block;
    font-size: 0.875rem;
    line-height: 1.25rem;

    &.hide {
      display: none;
    }
  }

  input {
    font-size: 1rem;
    height: 48px;
    appearance: none;
    background-color: var(--cui-bg-normal);
    box-shadow: 0 0 0 1px var(--cui-border-normal);
    border: medium none;
    outline: 0px;
    border-radius: 8px;
    padding: 12px 16px;
    transition:
      box-shadow 120ms ease-in-out 0s,
      padding 120ms ease-in-out 0s;
    width: 100%;
    margin: 0px;

    &:focus {
      box-shadow: 0 0 0 2px var(--cui-border-accent);
    }

    &:invalid:focus {
      box-shadow: 0 0 0 1px var(--cui-border-danger);
    }

    &.hasPrefix {
      padding-left: 48px;
    }
  }

  .wrap :global(svg) {
    position: absolute;
    pointer-events: none;
    color: var(--cui-fg-subtle);
    padding: 12px 16px;
    height: 48px;
    width: 48px;
  }
</style>
