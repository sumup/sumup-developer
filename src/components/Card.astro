---
import { getIconURL, type IconName } from "@sumup-oss/icons";

interface Props {
  icon?: IconName;
  title?: string;
}

const { icon, title, ...props } = Astro.props;
const iconUrl = icon ? getIconURL(icon, "24") : null;
---

<div class="card" {...props}>
  {
    title && (
      <div class="title">
        {iconUrl && <img src={iconUrl} alt="" aria-hidden="true" />}
        {title}
      </div>
    )
  }
  <div class="body"><slot /></div>
</div>

<style>
  .card {
    padding: var(--cui-spacings-giga);
    border-radius: var(--cui-border-radius-byte);
    border: none
    background-color: var(--cui-bg-subtle);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    transition: all 0.2s ease;
  }

  /* Optional: Alternate background for even/odd if you want, but lighter */
  .card:nth-child(even) {
    background-color: var(--cui-bg-elevated);
  }
  .card:nth-child(odd) {
    background-color: var(--cui-bg-subtle);
  }

  /* Hover effect */
  .card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    transform: translateY(-1px);
    background-color: var(--cui-bg-elevated);
  }

  .title {
    color: var(--cui-fg-normal);
    font-weight: var(--cui-font-weight-bold);
    display: flex;
    gap: var(--cui-spacings-byte);
  }
</style>

