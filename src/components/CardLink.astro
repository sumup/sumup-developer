---
import { ArrowRight } from "@sumup-oss/icons";

type Props = {
  href: string;
  title: string;
  description: string;
  image: string;
};
const { href, title, description, image } = Astro.props;
---

<a href={href} class="card">
  <div class="title">{title}<ArrowRight size={"16"} /></div>
  <div class="body">
    {description}
  </div>
  <div class="image">
    <Fragment set:html={image} />
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    padding: var(--cui-spacings-giga);
    border-radius: var(--cui-border-radius-byte);
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    justify-self: stretch;
    height: 246px;
    min-width: 286px;
    border: var(--cui-border-width-kilo) solid var(--cui-border-subtle);
  }

  .card:nth-child(even) {
    background-color: var(--cui-bg-elevated);
  }

  .card:nth-child(odd) {
    background-color: var(--cui-bg-subtle);
  }

  .card:hover {
    text-decoration: none;
  }

  .title {
    color: var(--cui-fg-normal);
    font-weight: var(--cui-font-weight-bold);
    display: flex;
    gap: var(--cui-spacings-byte);
  }

  .title :global(svg) {
    display: none;
  }

  .card:hover :global(svg) {
    display: block;
  }

  .body {
    margin-top: var(
      --cui-spacings-bit
    ) !important; /* clashes with markdown styling */
    font-size: var(--cui-body-s-font-size);
    line-height: var(--cui-body-s-line-height);
  }

  .image :global(svg) {
    margin-top: 1.5rem;
    position: absolute;
    height: 134px;
    width: 220px;
    right: -8px;
    bottom: -8px;
  }
</style>
