---
import ArrowRight from "@sumup-oss/icons/arrow_right_16.svg";

type Props = {
  href: string;
  title: string;
  description: string;
  image: string;
};
const { href, title, description, image } = Astro.props;
---

<a href={href} class="card">
  <div class="title">{title}<ArrowRight /></div>
  <div class="body">
    {description}
  </div>
  <div class="image">
    <img src={image} alt={title} />
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    padding: var(--cui-spacings-giga);
    border-radius: var(--cui-border-radius-byte);
    text-decoration: none;
    color: inherit;
    border: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    justify-self: stretch;
    height: 246px;
    min-width: 286px;
  }

  .card:nth-child(even) {
    background-color: var(--cui-bg-elevated);
  }

  .card:nth-child(odd) {
    background-color: var(--cui-bg-subtle);
  }

  /* Hover effect */
  .card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    transform: translateY(-1px);
    background-color: var(--cui-bg-elevated);
  }

  .title {
    color: var(--cui-fg-normal);
    font-weight: var(--cui-font-weight-bold);
    display: flex;
    align-items: center;
    gap: var(--cui-spacings-byte);
  }

  .title :global(svg) {
    display: none;
    width: 14px;
    height: 14px;
  }

  .card:hover :global(svg) {
    display: block;
  }

  .body {
    margin-top: var(--cui-spacings-bit);
    font-size: var(--cui-body-s-font-size);
    line-height: var(--cui-body-s-line-height);
  }

  .image :global(svg),
  .image :global(img) {
    margin-top: 1.5rem;
    position: absolute;
    height: 134px;
    width: 220px;
    right: -8px;
    bottom: -8px;
  }
</style>
