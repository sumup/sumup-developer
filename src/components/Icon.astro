---
import { getIconURL, type IconName } from "@sumup-oss/icons";

interface Props {
  icon?: IconName;
  size?: "16" | "24" | "32";
}

const { icon, size = "24" } = Astro.props;

if (!icon) {
  throw new Error("Icon prop is required!");
}

const iconUrl = getIconURL(icon, size);
---

<img src={iconUrl} alt="" aria-hidden="true" />
