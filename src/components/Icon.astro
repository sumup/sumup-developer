---
import { getIconURL, type IconName } from "@sumup-oss/icons";

interface Props {
  icon: IconName;
  size?: "s" | "m" | "l";
  class?: string;
}

const { icon, size = "m", class: className, ...rest } = Astro.props;

const dimensions = { s: 16, m: 24, l: 32 };
const iconUrl = getIconURL(icon, "24");
---

<span
  {...rest}
  class:list={["icon", className]}
  style={{
    maskImage: `url("${iconUrl}")`,
    width: `${dimensions[size]}px`,
    height: `${dimensions[size]}px`,
  }}
  aria-hidden="true"></span>

<style>
  .icon {
    display: inline-block;
    flex-shrink: 0;
    background-color: currentColor;
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
  }
</style>
