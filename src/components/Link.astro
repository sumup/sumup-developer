---
import { ExternalLink } from "@sumup-oss/icons";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {}

const { href, ...props } = Astro.props;
---

<a href={href} {...props}>
  <slot />
  {
    href?.toString()?.startsWith("http") ? (
      <ExternalLink size="16" aria-label="(External link)" />
    ) : null
  }
</a>

<style lang="scss">
  a {
    display: flex;
    flex-direction: row;
    align-items: center;

    :global(svg) {
      margin-left: var(--cui-spacings-kilo);
    }
  }
</style>
