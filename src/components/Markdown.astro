---
import { getEntry } from "astro:content";
import { getMarkdownDescriptionId } from "@lib/openapiContent";

interface Props {
  class?: string;
  text?: unknown;
}

const { class: className, text } = Astro.props;
const source = typeof text === "string" ? text : "";
const entry = source
  ? await getEntry("_apiDescriptions", getMarkdownDescriptionId(source))
  : undefined;
if (source && !entry)
  throw new Error(
    "API Markdown fragment is missing from the content collection",
  );
const html = entry?.rendered?.html ?? "";
---

<div class:list={["docs-content", className]}>
  <Fragment set:html={html} />
</div>
