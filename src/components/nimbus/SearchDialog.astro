---

---

<dialog
  class="search-dialog"
  data-search-dialog
  aria-label="Search documentation"
>
  <div class="search-panel">
    <div class="search-field">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path
          d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
      <input
        data-search-input
        role="combobox"
        aria-expanded="false"
        aria-haspopup="listbox"
        aria-autocomplete="list"
        aria-controls="search-results"
        type="search"
        placeholder="Search documentation…"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" data-search-close aria-label="Close search"
        >Esc</button
      >
    </div>
    <div data-search-results role="listbox" id="search-results">
      <p data-search-empty>Type to search…</p>
    </div>
    <footer>
      <span>↑↓ navigate</span><span>↵ select</span><span>Esc close</span>
    </footer>
  </div>
</dialog>

<script>
  import "./search.client";
</script>

<style>
  .search-dialog {
    width: min(38rem, calc(100% - 2rem));
    max-height: min(42rem, calc(100dvh - 4rem));
    margin: 12vh auto auto;
    padding: 0;
    color: var(--cui-fg-normal);
    background: transparent;
    border: 0;
  }

  .search-dialog::backdrop {
    background: rgb(0 0 0 / 55%);
    backdrop-filter: blur(2px);
  }

  .search-panel {
    overflow: hidden;
    background: var(--cui-bg-normal);
    border: 1px solid var(--cui-border-normal);
    border-radius: var(--cui-border-radius-mega);
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 25%);
  }

  .search-field {
    display: flex;
    gap: var(--cui-spacings-kilo);
    align-items: center;
    padding: var(--cui-spacings-kilo) var(--cui-spacings-mega);
    border-bottom: 1px solid var(--cui-border-divider);
  }

  .search-field svg {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--cui-fg-subtle);
  }

  .search-field input {
    min-width: 0;
    flex: 1;
    color: var(--cui-fg-normal);
    background: transparent;
    border: 0;
    outline: 0;
  }

  .search-field button {
    padding: 0.1rem 0.4rem;
    color: var(--cui-fg-subtle);
    background: var(--cui-bg-subtle);
    border: 1px solid var(--cui-border-subtle);
    border-radius: var(--cui-border-radius-bit);
    cursor: pointer;
    font-size: var(--cui-body-s-font-size);
  }

  [data-search-results] {
    min-height: 10rem;
    max-height: 24rem;
    overflow-y: auto;
    padding: var(--cui-spacings-byte);
  }

  [data-search-empty] {
    margin: var(--cui-spacings-exa) 0;
    color: var(--cui-fg-subtle);
    text-align: center;
  }

  .search-panel footer {
    display: flex;
    gap: var(--cui-spacings-mega);
    padding: var(--cui-spacings-byte) var(--cui-spacings-mega);
    color: var(--cui-fg-subtle);
    background: var(--cui-bg-subtle);
    font-size: var(--cui-body-s-font-size);
  }

  :global(.search-result) {
    padding: var(--cui-spacings-kilo);
    border-radius: var(--cui-border-radius-byte);
    cursor: pointer;
  }

  :global(.search-result:hover),
  :global(.search-result[data-highlighted]) {
    background: var(--cui-bg-subtle-hovered);
  }

  :global(.search-result > a) {
    display: block;
    color: var(--cui-fg-normal);
    font-weight: var(--cui-font-weight-semibold);
    text-decoration: none;
  }

  :global(.search-result p) {
    display: -webkit-box;
    margin: var(--cui-spacings-bit) 0 0;
    overflow: hidden;
    color: var(--cui-fg-subtle);
    font-size: var(--cui-body-s-font-size);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :global(.search-sub-results) {
    margin-top: var(--cui-spacings-byte);
    padding-inline-start: var(--cui-spacings-kilo);
    border-inline-start: 1px solid var(--cui-border-divider);
  }

  :global(.search-sub-results a) {
    display: block;
    padding: var(--cui-spacings-bit) 0;
    color: var(--cui-fg-subtle);
    font-size: var(--cui-body-s-font-size);
  }
</style>
