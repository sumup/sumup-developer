---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {
  text: string;
  variant?: "default" | "tip" | "caution" | "danger";
}

const {
  text,
  variant = "default",
  class: className,
  ...attributes
} = Astro.props;
---

<span class:list={["badge", variant, className]} {...attributes}>{text}</span>

<style>
  .badge {
    display: inline-flex;
    padding: 0 var(--cui-spacings-byte);
    color: var(--cui-fg-subtle);
    background: var(--cui-bg-subtle);
    border-radius: var(--cui-border-radius-pill);
    font-size: var(--cui-body-s-font-size);
    font-weight: var(--cui-font-weight-semibold);
  }

  .tip {
    color: var(--cui-fg-success);
    background: var(--cui-bg-success);
  }

  .caution {
    color: var(--cui-fg-warning);
    background: var(--cui-bg-warning);
  }

  .danger {
    color: var(--cui-fg-danger);
    background: var(--cui-bg-danger);
  }
</style>
