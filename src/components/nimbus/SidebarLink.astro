---
import type { SidebarItem } from "@cloudflare/nimbus-docs/types";
import MethodStatus from "@components/ApiDocs/MethodStatus.astro";

interface Props {
  item: Exclude<SidebarItem, { type: "group" }>;
}

const { item } = Astro.props;
const external = item.type === "external";
const badge = typeof item.badge === "string" ? item.badge : item.badge?.text;
const method = !external && item.attrs?.["data-http-method"];
---

<a
  href={item.href}
  aria-current={!external && item.isCurrent ? "page" : undefined}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  {...(!external && item.attrs)}
>
  <span>{item.label}</span>
  {method ? <MethodStatus method={method} /> : badge && <small>{badge}</small>}
</a>
