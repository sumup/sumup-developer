---
import Codeblock from "@components/Codeblock.astro";
import { Headline } from "@sumup-oss/circuit-ui";
import CreateCheckout from "./CreateCheckout.astro";
import CardReaderPayment from "./CardReaderPayment.astro";

const example1 = `func main() {
  client := sumup.NewClient().WithAuth(os.Getenv("SUMUP_API_KEY"))
  ctx := context.Background()
  merchantCode := "MERCHANT_CODE"

  checkout, err := client.Checkouts.Create(ctx, sumup.CreateCheckoutBody{
  	Amount:            19,
  	CheckoutReference: "CO746453",
  	Currency:          "EUR",
  	MerchantCode:      merchantCode,
  })

  // Collect customer's card data

  result, err := client.Checkouts.Process(ctx, *checkout.Id, sumup.ProcessCheckoutBody{
  	Card: &sumup.Card{
  		Cvv:         "123",
  		ExpiryMonth: "12",
  		ExpiryYear:  "2023",
  		Name:        "Boaty McBoatface",
  		Number:      "4200000000000042",
  	},
  	PaymentType: sumup.ProcessCheckoutBodyPaymentTypeCard,
  })
}`;

const example2 = `func main() {
  client := sumup.NewClient().WithAuth(os.Getenv("SUMUP_API_KEY"))
  ctx := context.Background()
  merchantCode := "MERCHANT_CODE"

  readers, _ := client.Readers.List(ctx, merchantCode)

  reader := readers.Items[0]
  resp, err := client.Readers.CreateCheckout(
  	ctx,
  	merchantCode,
  	string(reader.Id),
  	sumup.CreateReaderCheckoutBody{
  		TotalAmount: sumup.CreateReaderCheckoutAmount{
  			Currency:  "EUR",
  			MinorUnit: 100,
  			Value:     500,
  		},
  	},
  )
}`;
---

<Headline as="h2" className="header">Try it out</Headline>

<div class="container">
  <input type="radio" id="section1" name="sections" checked />
  <input type="radio" id="section2" name="sections" />
  <input type="radio" id="section3" name="sections" />
  <input type="radio" id="section4" name="sections" />
  <input type="radio" id="section5" name="sections" />

  <div class="tryit-sidebar">
    <label for="section1">Checkout</label>
    <label for="section2">Card reader payment</label>
    <label for="section3">Fetch HTML</label>
    <label for="section4">Redirect</label>
    <label for="section5">Respond with another site</label>
  </div>

  <div class="tryit-code">
    <div class="code-content" id="section1Content">
      <CreateCheckout />
    </div>
    <div class="code-content" id="section2Content">
      <CardReaderPayment />
    </div>
    <div class="code-content" id="section3Content">
      <Codeblock
        language="go"
        code={example1}
        meta={`"SUMUP_API_KEY" title="main.go"`}
        withCopyButton
      />
    </div>
    <div class="code-content" id="section4Content">
      <Codeblock
        language="go"
        code={example2}
        meta={`"SUMUP_API_KEY" title="main.go"`}
        withCopyButton
      />
    </div>
    <div class="code-content" id="section5Content">
      <Codeblock
        language="go"
        code={example1}
        meta={`"SUMUP_API_KEY" title="main.go"`}
        withCopyButton
      />
    </div>
  </div>
</div>

<style>
  .header {
    margin-bottom: var(--cui-spacings-giga);
  }

  .container {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--cui-spacings-giga);
  }

  @media screen and (max-width: 1200px) {
    .container {
      height: auto;
      grid-template-columns: 1fr;
    }
  }

  .tryit-sidebar {
    display: flex;
    flex-direction: column;
    border-radius: var(--cui-border-radius-byte);
    background-color: var(--cui-bg-subtle);
    padding: var(--cui-spacings-byte);
    gap: var(--cui-spacings-byte);
  }

  @media screen and (max-width: 1200px) {
    .tryit-sidebar {
      flex-direction: row;
      box-sizing: border-box;
      overflow-x: auto;
    }
  }

  input {
    display: none;
  }

  .tryit-sidebar label {
    cursor: pointer;
    padding: var(--cui-spacings-byte);
    border-radius: var(--cui-border-radius-byte);
    font-weight: var(--cui-font-weight-semibold);
    word-break: keep-all;
    white-space: nowrap;
    transition:
      background 0.3s,
      color 0.3s;
  }

  .tryit-sidebar label:hover {
    background: var(--cui-bg-normal-hover);
    color: var(--cui-fg-normal-hovered);
  }

  #section1:checked ~ .tryit-sidebar label[for="section1"],
  #section2:checked ~ .tryit-sidebar label[for="section2"],
  #section3:checked ~ .tryit-sidebar label[for="section3"],
  #section4:checked ~ .tryit-sidebar label[for="section4"],
  #section5:checked ~ .tryit-sidebar label[for="section6"] {
    background: var(--cui-bg-strong);
    color: var(--cui-fg-on-strong);
  }

  .tryit-code :global(.expressive-code pre) {
    max-height: 480px !important;
    scrollbar-width: thin !important;
  }

  .tryit-code :global(.codeblock) {
    width: 100%;
  }

  .code-content {
    display: none;
  }

  #section1:checked ~ .tryit-code #section1Content,
  #section2:checked ~ .tryit-code #section2Content,
  #section3:checked ~ .tryit-code #section3Content,
  #section4:checked ~ .tryit-code #section4Content,
  #section5:checked ~ .tryit-code #section5Content {
    display: flex;
  }
</style>
