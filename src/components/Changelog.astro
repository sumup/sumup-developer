---
import Button from "@components/Button";
import RssIcon from "@components/RssIcon";
import { getCollection, render } from "astro:content";
import slugify from "@sindresorhus/slugify";
import { Status, Body, Anchor, Headline } from "@sumup-oss/circuit-ui";
import StandaloneLayout from "../layouts/StandaloneLayout.astro";

interface Props {
  tag?: string;
}
const { tag: currentTag } = Astro.props;
const changelogDocs = await getCollection("_changelog");

const allTags = [
  ...new Set(changelogDocs.flatMap(({ data: { tags } }) => tags)),
];

const getEntryHref = (slug: string) => `/changelog/${slug}/`;
const getTagHref = (tag: string) => `/changelog/tags/${slugify(tag)}/`;

const tagName = allTags.find((tag) => slugify(tag) === currentTag);
const collectionDocs = changelogDocs
  .filter(
    ({ data }) =>
      currentTag === undefined ||
      data.tags.some((tag) => slugify(tag) === currentTag),
  )
  .sort(
    (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
  );

const posts = await Promise.all(
  collectionDocs.map(async (entry) => {
    const { Content } = await render(entry);
    return { Content, ...entry };
  }),
);
---

<StandaloneLayout
  title={tagName ? `${tagName} Changelog` : "Changelog"}
  socialImage="/og/changelog.png"
  description={
    currentTag === undefined
      ? "Product and API updates across the SumUp developer platform."
      : undefined
  }
  noindex={currentTag !== undefined}
  searchable={false}
>
  <div>
    <ul class="tags">
      <li>
        <a href="/changelog">
          <Status as="span">All</Status>
        </a>
      </li>
      {allTags.map((tag) => (
        <li>
          <a
            href={getTagHref(tag)}
            aria-current={
              currentTag === undefined ? undefined : slugify(tag) === currentTag
            }
          >
            <Status as="span">{tag}</Status>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="rssSubscribe">
    <Button
      size="s"
      href="/changelog/rss.xml"
      icon={RssIcon}
      label="Subscribe to RSS"
    />
  </div>
  <div class="content">
    {posts.map(({ Content, id, data: { title, tags, publishedDate } }) => (
      <div class="post" id={`entry-${id}`}>
        <Headline as="h2" size="s" className="title">
          <a class="titleLink" href={getEntryHref(id)}>
            {title}
          </a>
        </Headline>
        <Body size="s" color="subtle" className="meta">
          <span class="metaItem">
            <time
              data-pagefind-meta="datetime"
              datetime={publishedDate.toISOString()}
            >
              {publishedDate.toISOString().split("T")[0]}
            </time>
          </span>
          {tags &&
            tags.map((tag) => (
              <span class="metaItem">
                <Anchor size="s" href={getTagHref(tag)}>
                  {tag}
                </Anchor>
              </span>
            ))}
          <span class="metaItem">
            <Anchor size="s" href={getEntryHref(id)}>
              Permalink
            </Anchor>
          </span>
        </Body>
        <article class="docs-content">
          <Content />
        </article>
      </div>
    ))}
  </div>
</StandaloneLayout>

<style>
  .content {
    margin-top: var(--cui-spacings-giga);
    display: flex;
    flex-direction: column;
    gap: var(--cui-spacings-giga);
  }

  :global(.docs-content pre) {
    overflow: auto;
    scrollbar-width: thin;
  }

  .meta {
    margin-bottom: var(--cui-spacings-kilo);
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }

  .metaItem {
    display: inline-flex;
    align-items: center;
  }

  .metaItem:not(:last-child)::after {
    content: "·";
    margin: 0 var(--cui-spacings-byte);
  }

  .title {
    margin-bottom: var(--cui-spacings-bit);
  }

  .titleLink {
    color: inherit;
    text-decoration: none;
  }

  .titleLink:hover,
  .titleLink:focus-visible {
    text-decoration: underline;
  }

  .post {
    padding-bottom: var(--cui-spacings-tera);
    border-bottom: 1px solid var(--cui-border-divider);
  }
  .post :global(article > *:last-child) {
    margin-bottom: 0;
  }
  .post:last-of-type {
    border-bottom: none;
  }

  .tags {
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    list-style: none;
    justify-content: center;
    gap: var(--cui-spacings-byte);
  }

  .rssSubscribe {
    margin-top: var(--cui-spacings-giga);
    display: flex;
    justify-content: center;
  }

  .tags a[aria-current="true"] > :global(span) {
    background-color: var(--cui-bg-highlight-hovered);
  }
</style>
