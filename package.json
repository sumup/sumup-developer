{
  "name": "docs",
  "description": "Source code of the SumUp Developer portal",
  "keywords": [
    "sumup",
    "documentation",
    "developer portal"
  ],
  "homepage": "https://developer.sumup.com",
  "bugs": {
    "url": "https://github.com/sumup/sumup-developer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumup/sumup-developer.git"
  },
  "license": "Apache-2.0",
  "author": "SumUp <support@sumup.com> (https://sumup.com/)",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "info": "astro info",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "precheck": "astro sync",
    "check": "astro check",
    "prelint": "astro sync",
    "lint": "npx eslint",
    "format": "npm run format:src && npm run format:content",
    "format:content": "prettier --write \"**/*.{md,mdx,astro}\"",
    "format:src": "npx prettier --write \"**/*.{js,jsx,ts,tsx,mjs,css,json}\"",
    "linkcheck": "CHECK_LINKS=true astro build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/language-server": "^2.16.3",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/starlight": "^0.37.6",
    "@astrojs/starlight-docsearch": "^0.6.1",
    "@astrojs/ts-plugin": "^1.10.6",
    "@expressive-code/plugin-collapsible-sections": "^0.41.5",
    "@expressive-code/plugin-line-numbers": "0.41.3",
    "@sindresorhus/slugify": "^3.0.0",
    "@sumup-oss/circuit-ui": "^10.14.5",
    "@sumup-oss/design-tokens": "^9.0.0",
    "@sumup-oss/icons": "^5.22.0",
    "@types/node": "^25.2.0",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "@typescript-eslint/parser": "^8.54.0",
    "astro": "^5.17.1",
    "astro-mermaid": "1.2.0",
    "change-case-all": "^2.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "expressive-code": "^0.41.5",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "marked": "^17.0.1",
    "openapi-types": "^12.1.3",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "react": "^18.2.0",
    "react-content-loader": "^7.1.1",
    "react-dom": "^18.2.0",
    "react-final-form": "^7.0.0",
    "sass": "^1.97.3",
