{
  "name": "docs",
  "description": "Source code of the SumUp Developer portal",
  "keywords": [
    "sumup",
    "documentation",
    "developer portal"
  ],
  "homepage": "https://developer.sumup.com",
  "bugs": {
    "url": "https://github.com/sumup/sumup-developer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumup/sumup-developer.git"
  },
  "license": "Apache-2.0",
  "author": "SumUp <support@sumup.com> (https://sumup.com/)",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x",
    "npm": "12.x"
  },
  "packageManager": "npm@12.2.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "info": "astro info",
    "dev": "astro dev",
    "preview": "astro preview",
    "build": "astro build",
    "check": "astro check",
    "check:nimbus": "nimbus-docs check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:nimbus": "nimbus-docs lint",
    "lint:nimbus:fix": "nimbus-docs lint --fix",
    "linkcheck": "npm run build && npm run lint:nimbus",
    "check:redirects": "node scripts/check-redirects.mjs",
    "linkcheck:rendered": "node scripts/check-rendered-links.mjs",
    "test": "vitest run",
    "validate": "npm run format:check && npm run check:nimbus && npm run check && npm run lint && npm run test && npm run linkcheck && npm run test:worker",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "sync:agent-skills": "node scripts/sync-agent-skills.mjs",
    "postbuild": "node scripts/publish-agent-discovery.mjs && npm run check:site",
    "check:og-images": "node scripts/check-og-images.mjs",
    "check:site": "node scripts/check-site.mjs",
    "test:worker": "node --test tests/worker.test.mjs",
    "lint:spelling": "typos src/content --config _typos.toml"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/react": "7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/ts-plugin": "1.10.12",
    "@cloudflare/nimbus-docs": "0.19.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@readme/httpsnippet": "11.4.1",
    "@scalar/openapi-parser": "0.29.16",
    "@sindresorhus/slugify": "^3.0.1",
    "@sumup-oss/circuit-ui": "12.4.0",
    "@sumup-oss/design-tokens": "11.1.0",
    "@sumup-oss/icons": "7.3.0",
    "@sumup-oss/illustrations": "1.1.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "7.4.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-x": "5.28.8",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "openapi-sampler": "1.7.9",
    "pagefind": "1.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-final-form": "^7.0.1",
    "satori": "0.26.0",
    "satteri": "0.10.5",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wrangler": "4.152.0",
    "yaml": "2.9.1"
  }
}
