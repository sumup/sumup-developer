{
  "name": "docs",
  "description": "Source code of the SumUp Developer portal",
  "keywords": [
    "sumup",
    "documentation",
    "developer portal"
  ],
  "homepage": "https://developer.sumup.com",
  "bugs": {
    "url": "https://github.com/sumup/sumup-developer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumup/sumup-developer.git"
  },
  "license": "Apache-2.0",
  "author": "SumUp <support@sumup.com> (https://sumup.com/)",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x",
    "npm": "12.x"
  },
  "packageManager": "npm@12.1.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "info": "astro info",
    "dev": "astro dev",
    "preview": "astro preview",
    "build": "astro build",
    "check": "astro check",
    "lint": "eslint . && rumdl check .",
    "lint:fix": "eslint . --fix && rumdl fmt .",
    "format": "prettier --write \"**/*.{astro,cjs,css,js,jsx,json,jsonc,mjs,ts,tsx,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{astro,cjs,css,js,jsx,json,jsonc,mjs,ts,tsx,yaml,yml}\"",
    "lint:markdown": "rumdl check .",
    "lint:markdown:fix": "rumdl fmt .",
    "lint:nimbus": "nimbus-docs lint",
    "lint:nimbus:fix": "nimbus-docs lint --fix",
    "linkcheck": "npm run build && npm run lint:nimbus && npm run linkcheck:rendered && npm run check:agent-docs",
    "linkcheck:rendered": "node scripts/check-rendered-links.mjs",
    "test": "vitest run",
    "validate": "npm run format:check && npm run check && npm run lint && npm run test && npm run linkcheck",
    "check:agent-docs": "node scripts/check-agent-docs.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/language-server": "2.17.1",
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/react": "7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/ts-plugin": "1.10.12",
    "@cloudflare/nimbus-docs": "0.15.0",
    "@eslint/js": "9.39.5",
    "@sindresorhus/slugify": "^3.0.1",
    "@sumup-oss/circuit-ui": "12.2.0",
    "@sumup-oss/design-tokens": "11.0.0",
    "@sumup-oss/icons": "7.2.0",
    "@sumup-oss/illustrations": "1.1.0",
    "@treelight/bash": "0.6.0",
    "@treelight/c": "0.6.0",
    "@treelight/c-sharp": "0.6.0",
    "@treelight/core": "0.6.0",
    "@treelight/css": "0.6.0",
    "@treelight/go": "0.6.0",
    "@treelight/graphql": "0.6.0",
    "@treelight/hast": "0.6.0",
    "@treelight/html": "0.6.0",
    "@treelight/java": "0.6.0",
    "@treelight/javascript": "0.6.0",
    "@treelight/json": "0.6.0",
    "@treelight/kotlin": "0.6.0",
    "@treelight/php": "0.6.0",
    "@treelight/plugin-astro": "0.6.0",
    "@treelight/plugin-rehype": "0.6.0",
    "@treelight/python": "0.6.0",
    "@treelight/ruby": "0.6.0",
    "@treelight/rust": "0.6.0",
    "@treelight/swift": "0.6.0",
    "@treelight/theme-github-dark": "0.6.0",
    "@treelight/theme-github-light": "0.6.0",
    "@treelight/typescript": "0.6.0",
    "@treelight/xml": "0.6.0",
    "@treelight/yaml": "0.6.0",
    "@types/node": "26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "7.3.5",
    "astro-mermaid": "2.1.0",
    "change-case-all": "^2.1.0",
    "clsx": "2.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "17.12.0",
    "jsdom": "^30.1.1",
    "mdast-util-to-hast": "13.2.1",
    "openapi-types": "^12.1.3",
    "pagefind": "1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-final-form": "^7.0.1",
    "rumdl": "0.2.77",
    "sass": "^1.105.0",
    "satori": "0.33.5",
    "satteri": "0.10.5",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "unified": "11.0.5",
    "vitest": "5.0.2",
    "wrangler": "4.143.0"
  },
  "overrides": {
    "satori": {
      "fflate": "0.8.3"
    }
  }
}
