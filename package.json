{
  "name": "docs",
  "description": "Source code of the SumUp Developer portal",
  "keywords": [
    "sumup",
    "documentation",
    "developer portal"
  ],
  "homepage": "https://developer.sumup.com",
  "bugs": {
    "url": "https://github.com/sumup/sumup-developer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumup/sumup-developer.git"
  },
  "license": "Apache-2.0",
  "author": "SumUp <support@sumup.com> (https://sumup.com/)",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "info": "astro info",
    "dev": "astro dev",
    "start": "astro preview",
    "prebuild": "astro sync --force",
    "build": "astro build",
    "precheck": "astro sync",
    "check": "astro check",
    "prelint": "astro sync",
    "lint": "npm run lint:src && npm run lint:markdown",
    "lint:fix": "npm run lint:src:fix && npm run lint:markdown:fix",
    "lint:src": "npx eslint",
    "lint:src:fix": "npx prettier --write \"**/*.{astro,js,jsx,ts,tsx,mjs,css,json}\"",
    "lint:markdown": "rumdl check .",
    "lint:markdown:fix": "rumdl fmt .",
    "linkcheck": "CHECK_LINKS=true astro build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/cloudflare": "^13.6.1",
    "@astrojs/language-server": "^2.16.10",
    "@astrojs/react": "^5.0.7",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.39.3",
    "@astrojs/starlight-docsearch": "^0.7.0",
    "@astrojs/ts-plugin": "^1.10.9",
    "@expressive-code/plugin-collapsible-sections": "^0.43.1",
    "@expressive-code/plugin-line-numbers": "0.43.1",
    "@sindresorhus/slugify": "^3.0.0",
    "@sumup-oss/circuit-ui": "^11.8.0",
    "@sumup-oss/design-tokens": "^10.0.3",
    "@sumup-oss/icons": "^6.10.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.61.0",
    "astro": "^6.4.8",
    "astro-mermaid": "2.0.2",
    "change-case-all": "^2.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "expressive-code": "^0.43.1",
    "jsdom": "^29.1.1",
    "marked": "^18.0.5",
    "openapi-types": "^12.1.3",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "react": "^19.2.7",
    "react-content-loader": "^7.1.2",
    "react-dom": "^19.2.7",
    "react-final-form": "^7.0.1",
    "rumdl": "^0.2.9",
    "sass": "^1.101.0",
    "starlight-image-zoom": "^0.14.2",
    "starlight-links-validator": "^0.24.0",
    "starlight-llms-txt": "0.10.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "4.1.9",
    "workers-og": "0.0.27",
    "wrangler": "4.98.0"
  }
}
