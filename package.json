{
  "name": "docs",
  "description": "Source code of the SumUp Developer portal",
  "keywords": [
    "sumup",
    "documentation",
    "developer portal"
  ],
  "homepage": "https://developer.sumup.com",
  "bugs": {
    "url": "https://github.com/sumup/sumup-developer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumup/sumup-developer.git"
  },
  "license": "Apache-2.0",
  "author": "SumUp <support@sumup.com> (https://sumup.com/)",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x",
    "npm": "12.x"
  },
  "packageManager": "npm@12.1.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "info": "astro info",
    "dev": "astro dev",
    "preview": "astro preview",
    "build": "astro build",
    "check": "astro check",
    "lint": "eslint . && rumdl check .",
    "lint:fix": "eslint . --fix && rumdl fmt .",
    "format": "prettier --write \"**/*.{astro,cjs,css,js,jsx,json,jsonc,mjs,ts,tsx,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{astro,cjs,css,js,jsx,json,jsonc,mjs,ts,tsx,yaml,yml}\"",
    "lint:markdown": "rumdl check .",
    "lint:markdown:fix": "rumdl fmt .",
    "lint:nimbus": "nimbus-docs lint",
    "lint:nimbus:fix": "nimbus-docs lint --fix",
    "linkcheck": "npm run build && npm run lint:nimbus && npm run check:redirects && npm run linkcheck:rendered && npm run check:agent-docs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "linkcheck:rendered": "node scripts/check-rendered-links.mjs",
    "test": "vitest run",
    "validate": "npm run format:check && npm run check && npm run lint && npm run test && npm run linkcheck",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "sync:agent-skills": "node scripts/sync-agent-skills.mjs",
    "postbuild": "node scripts/publish-agent-discovery.mjs && npm run check:og-images",
    "check:og-images": "node scripts/check-og-images.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/language-server": "2.17.1",
    "@astrojs/react": "7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/ts-plugin": "1.10.12",
    "@cloudflare/nimbus-docs": "0.18.0",
    "@eslint/js": "10.0.1",
    "@sindresorhus/slugify": "^3.0.1",
    "@sumup-oss/circuit-ui": "12.4.0",
    "@sumup-oss/design-tokens": "11.1.0",
    "@sumup-oss/icons": "7.3.0",
    "@sumup-oss/illustrations": "1.1.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "7.3.5",
    "astro-mermaid": "2.1.0",
    "change-case-all": "^2.1.0",
    "clsx": "2.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-x": "5.26.5",
    "globals": "17.12.0",
    "jsdom": "^30.1.2",
    "mdast-util-to-hast": "13.2.1",
    "openapi-types": "^12.1.3",
    "pagefind": "1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-final-form": "^7.0.1",
    "rumdl": "0.2.79",
    "sass": "^1.105.0",
    "satori": "0.33.5",
    "satteri": "0.10.5",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.2",
    "wrangler": "4.150.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "mermaid": {
      "katex": "0.18.2"
    },
    "satori": {
      "fflate": "0.8.3"
    }
  }
}
